---
import type { Base } from "../types";

export interface AccordionProps extends Base {}

const { class: className, ...rest } = Astro.props as AccordionProps;
---

<div
  class:list={[
    "naut-accordion",
    className
  ]}
  {...rest}
>
  <slot />
</div>

<style>
  .naut-accordion {
    display: flex;
    flex-direction: column;
  }
</style>
