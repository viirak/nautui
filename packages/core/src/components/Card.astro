---
import type { Base, Radius, Spacing } from "../types";

export interface CardProps extends Base {
  bordered?: boolean;
  p?: Extract<Spacing, "sm" | "md" | "lg">;
  radius?: Radius | "none";
  shadow?: "sm" | "md" | "lg" | "xl";
}

const {
  class: className,
  bordered,
  shadow,
  radius,
  p = "md",
} = Astro.props as CardProps;
---

<div
  class:list={[
    "naut-card",
    bordered && "bordered",
    radius && `radius-${radius}`,
    shadow && `shadow-${shadow}`,
    className
  ]}
>
  <div class="naut-card--header"><slot name="header" /></div>
  <div class:list={["naut-card--body", `p-${p}`]}><slot /></div>
  <div class="naut-card--footer"><slot name="footer" /></div>
</div>

<style>
  .naut-card {
    --radius-scale: 1.575;

    display: flex;
    flex-direction: column;
    overflow: hidden;

    .naut-card--body {
      &.p-sm {
        padding: var(--naut-spacing-sm);
      }
      &.p-md {
        padding: var(--naut-spacing-md);
      }
      &.p-lg {
        padding: var(--naut-spacing-lg);
      }
    }

    .naut-card--header:empty {
      display: none;
    }

    .naut-card--footer:empty {
      display: none;
    }

    &.bordered {
      border: 1px solid var(--naut-color-border);
    }

    &.radius-none {
      border-radius: 0;
    }

    &.radius-sm {
      border-radius: calc(var(--naut-border-radius-sm) * var(--radius-scale));
    }

    &.radius-md {
      border-radius: calc(var(--naut-border-radius-md) * var(--radius-scale));
    }

    &.radius-lg {
      border-radius: calc(var(--naut-border-radius-lg) * var(--radius-scale));
    }

    &.shadow-sm {
      box-shadow: var(--naut-shadow-sm);
    }

    &.shadow-md {
      box-shadow: var(--naut-shadow-md);
    }

    &.shadow-lg {
      box-shadow: var(--naut-shadow-lg);
    }

    &.shadow-xl {
      box-shadow: var(--naut-shadow-xl);
    }
  }
</style>
