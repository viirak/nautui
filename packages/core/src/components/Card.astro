---
import { resolveMargin, resolvePadding, spacingToStyle } from "../lib/spacing";
import type { Base, Radius, SpacingProps } from "../types";

export interface CardProps extends Base, SpacingProps {
  bordered?: boolean;
  radius?: Radius | "none";
  shadow?: "sm" | "md" | "lg" | "xl";
}

const {
  class: className,
  bordered,
  shadow,
  radius = "none",
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
} = Astro.props as CardProps;

const spacingStyle = [
  spacingToStyle(resolvePadding({ p, px, py, pt, pr, pb, pl })),
  spacingToStyle(resolveMargin({ m, mx, my, mt, mr, mb, ml })),
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={["naut-card", bordered && "bordered", radius && `radius-${radius}`, shadow && `shadow-${shadow}`, className]}
  style={spacingStyle || undefined}
>
  <div class="naut-card--header"><slot name="header" /></div>
  <div class="naut-card--body"><slot /></div>
  <div class="naut-card--footer"><slot name="footer" /></div>
</div>

<style>
  .naut-card {
    --radius-scale: 1.575;

    display: flex;
    flex-direction: column;
    overflow: hidden;

    .naut-card--body {
      padding: var(--naut-spacing-md);
    }

    .naut-card--header:empty {
      display: none;
    }

    .naut-card--footer:empty {
      display: none;
    }

    &.bordered {
      border: 1px solid var(--naut-color-border);
    }

    &.radius-none {
      border-radius: 0;
    }

    &.radius-sm {
      border-radius: calc(var(--naut-border-radius-sm) * var(--radius-scale));
    }

    &.radius-md {
      border-radius: calc(var(--naut-border-radius-md) * var(--radius-scale));
    }

    &.radius-lg {
      border-radius: calc(var(--naut-border-radius-lg) * var(--radius-scale));
    }

    &.shadow-sm {
      box-shadow: var(--naut-shadow-sm);
    }

    &.shadow-md {
      box-shadow: var(--naut-shadow-md);
    }

    &.shadow-lg {
      box-shadow: var(--naut-shadow-lg);
    }

    &.shadow-xl {
      box-shadow: var(--naut-shadow-xl);
    }
  }
</style>
