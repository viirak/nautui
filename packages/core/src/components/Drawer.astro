---
import { uid } from "../lib/uid";
import type { Base } from "../types";
import type { ButtonProps } from "./Button.astro";
import Button from "./Button.astro";

type ToggleButtonProps = Omit<ButtonProps, "onclick">;

type DrawerPosition = "center" | "top" | "right" | "bottom" | "left";

export interface DrawerProps extends Base {
  button?: ToggleButtonProps;
  position?: DrawerPosition;
  size?: string;
  zi?: number;
}

const {
  position = "center",
  size = "350px",
  zi = 999,
  button,
} = Astro.props as DrawerProps;

const drawerId = uid("naut-drawer");
---

<Button
  variant="ghost"
  data-drawer-trigger={drawerId}
  aria-expanded="false"
  aria-controls={drawerId}
  square
  {...button}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-menu-icon lucide-menu"
  >
    <title>Menu</title>
    <g class="menu-icon">
      <path d="M4 5h16" />
      <path d="M4 12h16" />
      <path d="M4 19h16" />
    </g>
  </svg>
</Button>
<div id={drawerId} class="naut-drawer" data-state="closed" aria-hidden="true">
  <div class="naut-drawer-backdrop" data-drawer-close></div>
  <Button
    variant="ghost"
    class:list={["naut-drawer-close", position === "center" && "panel-centered"]}
    data-drawer-close
    square
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-x"
    >
      <title>Close</title>
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </Button>
  <div
    class:list={["naut-drawer-panel", `position--${position}`]}
    role="dialog"
    aria-modal="true"
    aria-label="Dialog"
    tabindex="-1"
  >
    <div class="naut-drawer-content"><slot /></div>
  </div>
</div>

<script is:inline>
  let _nautDrawerOpenCount = 0;
  let _nautOriginalOverflow = "";

  function closeDrawer(drawer) {
    drawer.dataset.state = "closed";
    drawer.setAttribute("aria-hidden", "true");
    const btn = document.querySelector(`[data-drawer-trigger="${drawer.id}"]`);
    if (btn) {
      btn.setAttribute("aria-expanded", "false");
      btn.focus();
    }
    _nautDrawerOpenCount--;
    if (_nautDrawerOpenCount === 0) {
      document.body.style.overflow = _nautOriginalOverflow;
      _nautOriginalOverflow = "";
    }
  }

  function openDrawer(drawer) {
    if (_nautDrawerOpenCount === 0) {
      _nautOriginalOverflow = document.body.style.overflow;
    }
    _nautDrawerOpenCount++;
    drawer.dataset.state = "open";
    drawer.setAttribute("aria-hidden", "false");
    const btn = document.querySelector(`[data-drawer-trigger="${drawer.id}"]`);
    if (btn) btn.setAttribute("aria-expanded", "true");
    const closeBtn = drawer.querySelector("[data-drawer-close]");
    if (closeBtn) closeBtn.focus();
    if (_nautDrawerOpenCount === 1) {
      document.body.style.overflow = "hidden";
    }
  }

  document.addEventListener("click", (e) => {
    const trigger = e.target.closest("[data-drawer-trigger]");
    if (trigger) {
      const id = trigger.dataset.drawerTrigger;
      const drawer = document.getElementById(id);
      if (drawer) {
        if (drawer.dataset.state === "open") {
          closeDrawer(drawer);
        } else {
          openDrawer(drawer);
        }
      }
    }
    const closeBtn = e.target.closest("[data-drawer-close]");
    if (closeBtn) {
      const drawer = closeBtn.closest(".naut-drawer");
      if (drawer) closeDrawer(drawer);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const openDrawerEl = document.querySelector(
        '.naut-drawer[data-state="open"]'
      );
      if (openDrawerEl) closeDrawer(openDrawerEl);
    }
    if (e.key === "Tab") {
      const openDrawerEl = document.querySelector(
        '.naut-drawer[data-state="open"]'
      );
      if (!openDrawerEl) return;
      const panel = openDrawerEl.querySelector(".naut-drawer-panel");
      if (!panel) return;
      const focusable = panel.querySelectorAll(
        'a[href], button, textarea, input, select, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!(first && last)) return;
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>

<style define:vars={{ nautDrawerZIndex: zi, nautDrawerSize: size }}>
  .naut-drawer-toggle {
    display: inline-block;
  }

  .naut-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--nautDrawerZIndex);
    visibility: hidden;
    color: var(--naut-color-content);

    .naut-drawer-close {
      position: absolute;
      top: var(--naut-spacing-sm);
      right: var(--naut-spacing-sm);
      z-index: 12;

      &.panel-centered {
        top: var(--naut-spacing-lg);
        right: var(--naut-spacing-lg);
      }
    }

    .naut-drawer-backdrop {
      position: absolute;
      inset: 0;
      background: rgb(from var(--naut-color-base-200) r g b / 0.7);
      opacity: 0;
      -webkit-backdrop-filter: blur(5px);
      backdrop-filter: blur(5px);
      transition: opacity 0.3s ease;
    }

    .naut-drawer-panel {
      position: absolute;
      overflow-y: auto;
      background: var(--naut-color-base);

      .naut-drawer-content {
        padding: var(--naut-spacing-md);
      }

      &.position--center {
        inset: 0;
        margin: var(--naut-spacing-md);
        border-radius: var(--naut-border-radius-lg);
      }

      &.position--left,
      &.position--right {
        top: 0;
        bottom: 0;
        width: var(--nautDrawerSize);
        transition: transform 0.3s ease;
      }

      &.position--left {
        left: 0;
        transform: translateX(-100%);
      }

      &.position--right {
        right: 0;
        transform: translateX(100%);
      }

      &.position--top,
      &.position--bottom {
        right: 0;
        left: 0;
        height: var(--nautDrawerSize);
        transition: transform 0.3s ease;
      }

      &.position--top {
        top: 0;
        transform: translateY(-100%);
      }

      &.position--bottom {
        bottom: 0;
        transform: translateY(100%);
      }
    }

    &[data-state="open"] {
      visibility: visible;
      .naut-drawer-backdrop {
        opacity: 1;
      }

      .naut-drawer-panel {
        transform: translate(0, 0);
      }
    }
  }
</style>
