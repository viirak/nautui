---
import type { Base } from "../types";
import type { ButtonProps } from "./Button.astro";
import Button from "./Button.astro";
import "../styles/hidden.css";

type ToggleButtonProps = Omit<ButtonProps, "onclick">;

type DrawerPosition = "center" | "top" | "right" | "bottom" | "left";

export interface DrawerProps extends Base {
  button?: ToggleButtonProps;
  hidden?: "sm" | "md" | "lg" | "xl";
  position?: DrawerPosition;
  size?: string;
  zi?: number;
}

const {
  hidden,
  position = "center",
  size = "350px",
  zi = 999,
  button,
} = Astro.props as DrawerProps;

const drawerId = `naut-drawer-${Math.random().toString(36).slice(2, 9)}`;
---

<Button
  variant="ghost"
  onclick={`toggleMenu('${drawerId}')`}
  class:list={[hidden && `hidden-${hidden}`]}
  {...button}
  square
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-menu-icon lucide-menu"
  >
    <title>Menu</title>
    <g class="menu-icon">
      <path d="M4 5h16" />
      <path d="M4 12h16" />
      <path d="M4 19h16" />
    </g>
  </svg>
</Button>
<div id={drawerId} class="naut-drawer">
  <div class="naut-drawer-backdrop"></div>
  <Button
    variant="ghost"
    class:list={["naut-drawer-close", position === "center" && "panel-centered"]}
    onclick={`toggleMenu('${drawerId}')`}
    square
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-x"
    >
      <title>Close</title>
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </Button>
  <div class:list={["naut-drawer-panel", `position--${position}`]}>
    <div class="naut-drawer-content"><slot /></div>
  </div>
</div>

<script is:inline>
  const toggleMenu = (id) => {
    const drawer = document.getElementById(id);
    if (drawer) {
      drawer.classList.toggle("active");
      document.body.appendChild(drawer);
      // disable scroll
      document.body.style.overflow =
        document.body.style.overflow === "hidden" ? "auto" : "hidden";
    }
  };
</script>

<style define:vars={{ nautDrawerZIndex: zi, nautDrawerSize: size }}>
  .naut-drawer-toggle {
    display: inline-block;
  }

  .naut-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--nautDrawerZIndex);
    visibility: hidden;
    color: var(--naut-color-content);

    .naut-drawer-close {
      position: absolute;
      top: var(--naut-spacing-sm);
      right: var(--naut-spacing-sm);
      z-index: 12;

      &.panel-centered {
        top: var(--naut-spacing-lg);
        right: var(--naut-spacing-lg);
      }
    }

    .naut-drawer-backdrop {
      position: absolute;
      inset: 0;
      background: rgb(from var(--naut-color-base-200) r g b / 0.7);
      opacity: 0;
      -webkit-backdrop-filter: blur(5px);
      backdrop-filter: blur(5px);
      transition: opacity 0.3s ease;
    }

    .naut-drawer-panel {
      position: absolute;
      overflow-y: auto;
      background: var(--naut-color-base);

      .naut-drawer-content {
        padding: var(--naut-spacing-md);
      }

      &.position--center {
        inset: 0;
        margin: var(--naut-spacing-md);
        border-radius: var(--naut-border-radius-lg);
      }

      &.position--left,
      &.position--right {
        top: 0;
        bottom: 0;
        width: var(--nautDrawerSize);
        transition: transform 0.3s ease;
      }

      &.position--left {
        left: 0;
        transform: translateX(-100%);
      }

      &.position--right {
        right: 0;
        transform: translateX(100%);
      }

      &.position--top,
      &.position--bottom {
        right: 0;
        left: 0;
        height: var(--nautDrawerSize);
        transition: transform 0.3s ease;
      }

      &.position--top {
        top: 0;
        transform: translateY(-100%);
      }

      &.position--bottom {
        bottom: 0;
        transform: translateY(100%);
      }
    }

    &.active {
      visibility: visible;
      .naut-drawer-backdrop {
        opacity: 1;
      }

      .naut-drawer-panel {
        transform: translate(0, 0);
      }
    }
  }
</style>
