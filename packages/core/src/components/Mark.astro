---
import type { Base } from "../types";

export interface MarkProps extends Base {
  ff?: string; // font family
  gradient?: { colors: string[]; deg?: number };
  rotate?: "sm" | "md" | "lg";
  variant?:
    | "default"
    | "primary"
    | "secondary"
    | "destructive"
    | "underline"
    | "halflight"
    | "parallelogram"
    | "sketch-circle";
}

const {
  class: className,
  variant,
  rotate,
  gradient,
  ff,
  ...rest
} = Astro.props as MarkProps;
const gradientBg = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : undefined;
const nautMarkFontFamily = ff;
---

<mark
  class:list={[
    "naut-mark",
    variant && `variant--${variant}`,
    rotate && `rotate--${rotate}`,
    gradient && "gradient",
    className]}
  {...rest}
>
  <slot />
</mark>

<style define:vars={{ gradientBg, nautMarkFontFamily }}>
  .naut-mark {
    display: inline-block;
    padding-right: 1rem;
    padding-left: 1rem;
    font-family: var(--nautMarkFontFamily);
    color: var(--naut-color-content);
    background-color: var(--naut-color-highlight);

    &::selection {
      color: var(--naut-color-content);
    }

    &.rotate--sm {
      transform: rotate(-1.25deg);
    }

    &.rotate--md {
      transform: rotate(-1.5deg);
    }

    &.rotate--lg {
      transform: rotate(-1.95deg);
    }

    &.variant--primary {
      color: var(--naut-color-primary);
      background: none;
    }

    &.variant--secondary {
      color: var(--naut-color-secondary);
      background: none;
    }

    &.variant--destructive {
      color: var(--naut-color-destructive);
      background: none;
    }

    &.variant--underline {
      color: inherit;
      background:
        linear-gradient(120deg, var(--naut-color-highlight) 0 100%) no-repeat
        18px calc(100% + 4px) / calc(100% - 32px) 0.2em transparent;
    }

    &.variant--halflight {
      padding: 0 0.3rem;
      color: inherit;
      background:
        linear-gradient(120deg, var(--naut-color-highlight) 0% 100%) no-repeat 0
        88% / 100% 0.4em transparent;
    }

    &.variant--parallelogram {
      padding-inline: 1.4rem;
      margin-inline: calc(1.4rem * -1);
      background-color: transparent;
      background-image:
        linear-gradient(
          to bottom right,
          transparent 50%,
          var(--naut-color-highlight) 50%
        ),
        linear-gradient(
          var(--naut-color-highlight),
          var(--naut-color-highlight)
        ),
        linear-gradient(
          to top left,
          transparent 50%,
          var(--naut-color-highlight) 50%
        );
      background-repeat: no-repeat;
      background-position:
        left center,
        center,
        right center;
      background-size:
        0.25em 1.5em,
        calc(100% - 0.25em * 2 + 1.5px) 1.5em,
        0.25em 1.5em;
    }

    &.variant--sketch-circle {
      position: relative;
      color: inherit;
      background-color: transparent;

      &::before {
        position: absolute;
        top: -0.1em;
        left: -0.5em;
        z-index: -1;
        width: 100%;
        height: 1em;
        padding: 0.1em 0.25em;
        content: "";
        border: 6px solid var(--naut-color-highlight);
        border-right-color: transparent;
        border-radius: 50%;
        transform: rotate(2deg);
      }

      &::after {
        position: absolute;
        top: 0.1em;
        left: -0.5em;
        z-index: -1;
        width: 100%;
        height: 1em;
        padding: 0.1em 0.25em;
        content: "";
        border: 6px solid var(--naut-color-highlight);
        border-top-color: transparent;
        border-left-color: transparent;
        border-radius: 50%;
        transform: rotate(-2deg);
      }
    }

    &.gradient {
      color: transparent;
      background-color: transparent;
      background-image: var(--gradientBg);
      -webkit-background-clip: text;
      background-clip: text;

      &::selection {
        color: var(--naut-color-content);
        background-color: var(--naut-color-selection);
        background-image: none;
      }
    }
  }
</style>
