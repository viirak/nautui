---
import { getGradientPattern, type PatternProps } from "../lib/pattern";

interface GradientProps {
  colors: string[];
  deg?: number;
  type: "linear" | "radial";
}

interface MaskProps {
  position?: "top" | "bottom" | "center" | "left" | "right";
  shape: "radial";
  visibility?: number;
}

export interface BackgroundProps {
  color?: string;
  gradient?: GradientProps;
  image?: string;
  mask?: MaskProps;
  opacity?: number;
  pattern?: PatternProps;
}

const { color, image, mask, pattern, gradient, opacity } =
  Astro.props as BackgroundProps;
const backgroundColor = color || "transparent";
const backgroundImage = image ? `url("${image}")` : undefined;
const backgroundSize = image ? "cover" : undefined;
const backgroundPosition = image ? "center" : undefined;
const backgroundRepeat = image ? "no-repeat" : undefined;
const backgroundOpacity = opacity || 1;
const backgroundPattern = getGradientPattern(pattern);
const backgroundGradient = (() => {
  if (!gradient) return;
  return gradient.type === "radial"
    ? `radial-gradient(circle, ${gradient.colors.join(", ")})`
    : `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`;
})();
const maskPosition = {
  top: "50% 0%",
  bottom: "50% 100%",
  center: "50% 50%",
  left: "0% 50%",
  right: "100% 50%",
}[mask?.position ?? "top"];
const backgroundMask = mask
  ? `radial-gradient(70% 60% at ${maskPosition}, rgb(0 0 0 / ${mask.visibility ?? 1}) 30%, transparent 75%)`
  : undefined;
---

<div class:list={["naut-background", mask && "mask"]}>
  {gradient && <div class:list={["naut-background-gradient", gradient.type]}></div>}
  {pattern && <div class:list={["naut-background-pattern", pattern.type]}></div>}
  <slot />
</div>

<style
  define:vars={{
    backgroundColor,
    backgroundImage,
    backgroundSize,
    backgroundPosition,
    backgroundRepeat,
    backgroundOpacity,
    backgroundPattern,
    backgroundGradient,
    backgroundMask
  }}
>
  .naut-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--backgroundColor);
    background-image: var(--backgroundImage);
    background-repeat: var(--backgroundRepeat);
    background-position: var(--backgroundPosition);
    background-size: var(--backgroundSize);
    opacity: var(--backgroundOpacity);
  }

  &.mask {
    -webkit-mask-image: var(--backgroundMask);
    mask-image: var(--backgroundMask);
  }

  .naut-background-pattern {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--backgroundPattern);
  }

  .naut-background-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--backgroundGradient);
  }
</style>
