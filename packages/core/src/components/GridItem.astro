---
import { createMargin, createPadding } from "../lib/spacing";
import type { Base, SpacingProps } from "../types";

export interface GridItemProps extends Base, SpacingProps {
  span?: number;
}

const {
  class: className,
  span,
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as GridItemProps;

const gridColumn = span ? `span ${span}` : "auto";
const padding = createPadding("gridItem", { p, px, py, pt, pr, pb, pl });
const margin = createMargin("gridItem", { m, mx, my, mt, mr, mb, ml });
---

<div class:list={["naut-grid-item", className]} {...rest}><slot /></div>

<style define:vars={{ gridColumn, ...padding, ...margin }}>
  .naut-grid-item {
    grid-column: 1 / -1; /* Stacked on mobile */

    padding-top: var(--gridItemPaddingTop);
    padding-right: var(--gridItemPaddingRight);
    padding-bottom: var(--gridItemPaddingBottom);
    padding-left: var(--gridItemPaddingLeft);

    margin-top: var(--gridItemMarginTop);
    margin-right: var(--gridItemMarginRight);
    margin-bottom: var(--gridItemMarginBottom);
    margin-left: var(--gridItemMarginLeft);

    @media only screen and (min-width: 576px) {
      grid-column: auto; /* Fallback to Grid's 2-column template */
    }

    @media only screen and (min-width: 1042px) {
      grid-column: var(--gridColumn); /* Use specified span on desktop */
    }
  }
</style>
