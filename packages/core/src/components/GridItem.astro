---
import { resolveMargin, resolvePadding, spacingToStyle } from "../lib/spacing";
import type { Base, SpacingProps } from "../types";

export interface GridItemProps extends Base, SpacingProps {
  span?: number;
}

const {
  class: className,
  span,
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as GridItemProps;

const gridColumn = span ? `span ${span}` : "auto";
const spacingStyle = [
  spacingToStyle(resolvePadding({ p, px, py, pt, pr, pb, pl })),
  spacingToStyle(resolveMargin({ m, mx, my, mt, mr, mb, ml })),
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={["naut-grid-item", className]}
  style={spacingStyle || undefined}
  {...rest}
>
  <slot />
</div>

<style define:vars={{ gridColumn }}>
  .naut-grid-item {
    grid-column: 1 / -1; /* Stacked on mobile */

    @media only screen and (min-width: 576px) {
      grid-column: auto; /* Fallback to Grid's 2-column template */
    }

    @media only screen and (min-width: 1042px) {
      grid-column: var(--gridColumn); /* Use specified span on desktop */
    }
  }
</style>
