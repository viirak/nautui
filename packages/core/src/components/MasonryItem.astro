---
import "../styles/spacing/spacing.css";
import {
  extractSpacingProps,
  getSpacingClasses,
  SpacingProps,
} from "../lib/spacing";
import type { Base } from "../types";

export interface MasonryItemProps extends Base, SpacingProps {}

const { spacing, nonSpacing } = extractSpacingProps(
  Astro.props as MasonryItemProps
);
const spacingClasses = getSpacingClasses(spacing);

const { class: className, ...rest } = nonSpacing;
---

<div class:list={["naut-masonry-item", ...spacingClasses, className]} {...rest}>
  <slot />
</div>

<style>
  .naut-masonry-item {
    width: 100%;
    padding-top: var(--masonryItemPaddingTop);
    padding-right: var(--masonryItemPaddingRight);
    padding-bottom: var(--masonryItemPaddingBottom);
    padding-left: var(--masonryItemPaddingLeft);
    margin-top: var(--masonryItemMarginTop);
    margin-right: var(--masonryItemMarginRight);
    margin-bottom: var(--masonryItemMarginBottom);
    margin-left: var(--masonryItemMarginLeft);
    break-inside: avoid;
  }
</style>
