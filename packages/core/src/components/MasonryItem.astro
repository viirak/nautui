---
import "../styles/spacing/spacing.css";
import type { SpacingProps } from "../lib/spacing";
import { getMarginClassList, getPaddingClassList } from "../lib/spacing";
import type { Base } from "../types";

export interface MasonryItemProps extends Base, SpacingProps {}

const { padding, margin, ...nonSpacing } = Astro.props as MasonryItemProps;
const spacingClasses = [
  ...getPaddingClassList(padding),
  ...getMarginClassList(margin),
].join(" ");

const { class: className, ...rest } = nonSpacing;
---

<div class:list={["naut-masonry-item", ...spacingClasses, className]} {...rest}>
  <slot />
</div>

<style>
  .naut-masonry-item {
    break-inside: avoid;
  }
</style>
