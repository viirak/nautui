---
import { createMargin, createPadding } from "../lib/spacing";
import type { Base, SpacingProps } from "../types";

export interface MasonryItemProps extends Base, SpacingProps {}

const {
  class: className,
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as MasonryItemProps;

const padding = createPadding("masonryItem", { p, px, py, pt, pr, pb, pl });
const margin = createMargin("masonryItem", { m, mx, my, mt, mr, mb, ml });
---

<div class:list={["naut-masonry-item", className]} {...rest}><slot /></div>

<style>
  .naut-masonry-item {
    width: 100%;
    padding: var(--masonryItemPaddingTop) var(--masonryItemPaddingRight)
      var(--masonryItemPaddingBottom) var(--masonryItemPaddingLeft);
    margin: var(--masonryItemMarginTop) var(--masonryItemMarginRight)
      var(--masonryItemMarginBottom) var(--masonryItemMarginLeft);
    break-inside: avoid;
  }
</style>
