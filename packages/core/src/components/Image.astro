---
import type { Base, Radius } from "../types";

export interface ImageProps extends Base {
  alt: string;
  cover?: boolean;
  fluid?: boolean;
  maxHeight?: string;
  maxWidth?: string;
  radius?: Radius;
  ratio?: "1:1" | "16:9" | "4:3" | "3:2" | "2:1" | "9:16 | 3:4" | "2:3" | "1:2";
  responsive?: boolean;
  shadow?: "sm" | "md" | "lg" | "xl";
  src: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  class: className,
  ratio,
  radius,
  shadow,
  cover = false,
  fluid = false,
  responsive = false,
  maxWidth,
  maxHeight,
  ...rest
} = Astro.props as ImageProps;
const ratioName = ratio ? ratio.replace(":", "x") : undefined;
const maxWidthVar = maxWidth && !cover ? maxWidth : "none";
const maxHeightVar = maxHeight && !cover ? maxHeight : "none";
const heightVar = maxHeight && !cover ? maxHeight : "auto";
---

<div
  class:list={[
    "naut-image",
    ratioName && `ratio ratio-${ratioName}`,
    radius && `radius-${radius}`,
    shadow && `shadow-${shadow}`,
    cover && "fit-cover",
    maxHeight && !cover && "fit-height",
    fluid && "fluid",
    responsive && "responsive",
    className
  ]}
>
  <img src={src} alt={alt} {...rest}>
</div>
<style define:vars={{ maxWidthVar, maxHeightVar, heightVar }}>
  .naut-image {
    --radius-scale: 1.575;
    position: relative;
    display: inline-block;
    max-width: var(--maxWidthVar);
    height: var(--heightVar);
    max-height: var(--maxHeightVar);
    overflow: hidden;
    background-color: var(--naut-color-surface);

    img {
      display: block;
      width: auto;
      height: auto;
    }

    &.fit-cover {
      width: 100%;
      height: 100%;
      object-fit: cover;
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &.fluid:not(.fit-cover) {
      width: 100%;
      img {
        width: 100%;
      }
    }

    &.responsive:not(.fluid) {
      @media only screen and (max-width: 1041px) {
        width: 100%;
        max-width: 100%;
        height: auto;
        img {
          width: 100%;
          height: auto;
        }
      }
    }

    &.fit-height:not(.ratio):not(.fit-cover):not(.fluid) {
      width: fit-content;
      max-width: 100%;
      img {
        display: block;
        width: auto;
        max-width: none;
        height: 100%;
      }
    }

    &.ratio {
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &.ratio-1x1 {
      aspect-ratio: 1 / 1;
    }

    &.ratio-16x9 {
      aspect-ratio: 16 / 9;
    }

    &.ratio-4x3 {
      aspect-ratio: 4 / 3;
    }

    &.ratio-3x2 {
      aspect-ratio: 3 / 2;
    }

    &.ratio-2x1 {
      aspect-ratio: 2 / 1;
    }

    &.ratio-9x16 {
      aspect-ratio: 9 / 16;
    }

    &.ratio-3x4 {
      aspect-ratio: 3 / 4;
    }

    &.ratio-2x3 {
      aspect-ratio: 2 / 3;
    }

    &.ratio-1x2 {
      aspect-ratio: 1 / 2;
    }

    &.radius-none {
      border-radius: 0;
    }

    &.radius-sm {
      border-radius: calc(var(--naut-border-radius-sm) * var(--radius-scale));
    }

    &.radius-md {
      border-radius: calc(var(--naut-border-radius-md) * var(--radius-scale));
    }

    &.radius-lg {
      border-radius: calc(var(--naut-border-radius-lg) * var(--radius-scale));
    }

    &.radius-full {
      border-radius: 9999px;
    }

    &.shadow-sm:not(.cover) {
      box-shadow: var(--naut-shadow-sm);
    }

    &.shadow-md:not(.cover) {
      box-shadow: var(--naut-shadow-md);
    }

    &.shadow-lg:not(.cover) {
      box-shadow: var(--naut-shadow-lg);
    }

    &.shadow-xl:not(.cover) {
      box-shadow: var(--naut-shadow-xl);
    }
  }
</style>
