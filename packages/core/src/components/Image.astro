---
import type { Base, Radius } from "../types";

export interface ImageProps extends Base {
  alt: string;
  cover?: boolean;
  radius?: Radius;
  ratio?: "1:1" | "16:9" | "4:3" | "3:2" | "2:1";
  shadow?: "sm" | "md" | "lg" | "xl";
  src: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  class: className,
  ratio,
  radius,
  shadow,
  cover,
  ...rest
} = Astro.props as ImageProps;
const ratioName = ratio ? ratio.replace(":", "x") : undefined;
---

<div
  class:list={[
    "naut-image",
    ratioName && `ratio-${ratioName}`,
    radius && `radius-${radius}`,
    shadow && `shadow-${shadow}`,
    cover && "fit-cover",
    className
  ]}
>
  <img src={src} alt={alt} {...rest}>
</div>
<style>
  .naut-image {
    --radius-scale: 1.575;

    width: 100%;
    overflow: hidden;
    background-color: var(--naut-color-surface);

    img {
      width: 100%;
      height: auto;
      object-fit: cover;
    }

    &.fit-cover {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &.ratio-1x1 {
      aspect-ratio: 1 / 1;
    }

    &.ratio-16x9 {
      aspect-ratio: 16 / 9;
    }

    &.ratio-4x3 {
      aspect-ratio: 4 / 3;
    }

    &.ratio-3x2 {
      aspect-ratio: 3 / 2;
    }

    &.ratio-2x1 {
      aspect-ratio: 2 / 1;
    }

    &.radius-none {
      border-radius: 0;
    }

    &.radius-sm {
      border-radius: calc(var(--naut-border-radius-sm) * var(--radius-scale));
    }

    &.radius-md {
      border-radius: calc(var(--naut-border-radius-md) * var(--radius-scale));
    }

    &.radius-lg {
      border-radius: calc(var(--naut-border-radius-lg) * var(--radius-scale));
    }

    &.radius-full {
      border-radius: 9999px;
    }

    &.shadow-sm {
      box-shadow: var(--naut-shadow-sm);
    }

    &.shadow-md {
      box-shadow: var(--naut-shadow-md);
    }

    &.shadow-lg {
      box-shadow: var(--naut-shadow-lg);
    }

    &.shadow-xl {
      box-shadow: var(--naut-shadow-xl);
    }
  }
</style>
