---
import type { Base, Radius } from "../types";

export interface ImageProps extends Base {
  alt: string;
  cover?: boolean;
  fluid?: boolean;
  hover?: "zoom" | "zoom-out" | "brighten" | "grayscale" | "fade";
  maxHeight?: string;
  maxWidth?: string;
  radius?: Radius;
  ratio?:
    | "1:1"
    | "16:9"
    | "4:3"
    | "3:2"
    | "2:1"
    | "9:16"
    | "3:4"
    | "2:3"
    | "1:2";
  responsive?: boolean;
  shadow?: "sm" | "md" | "lg" | "xl";
  src: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  class: className,
  ratio,
  radius,
  shadow,
  cover = false,
  fluid = false,
  hover,
  responsive = false,
  maxWidth,
  maxHeight,
  ...rest
} = Astro.props as ImageProps;
const ratioName = ratio ? ratio.replace(":", "x") : undefined;
const imageMaxWidth = maxWidth && !cover ? maxWidth : undefined;
const imageMaxHeight = maxHeight && !cover ? maxHeight : undefined;
const imageHeight = maxHeight && !cover ? maxHeight : undefined;
---

<div
  class:list={[
    "naut-image",
    ratioName && `ratio ratio-${ratioName}`,
    radius && `radius-${radius}`,
    shadow && `shadow-${shadow}`,
    hover && `hover-${hover}`,
    cover && "fit-cover",
    maxHeight && !cover && "fit-height",
    fluid && "fluid",
    responsive && "responsive",
    className
  ]}
>
  <img src={src} alt={alt} {...rest}>
</div>
<style define:vars={{ imageHeight, imageMaxHeight, imageMaxWidth }}>
  .naut-image {
    --radius-scale: 1.575;
    position: relative;
    display: inline-block;
    max-width: var(--imageMaxWidth);
    height: var(--imageHeight);
    max-height: var(--imageMaxHeight);
    overflow: hidden;
    background-color: var(--naut-color-base-100);

    img {
      display: block;
      width: auto;
      height: auto;
    }

    &.hover-zoom img,
    &.hover-zoom-out img,
    &.hover-brighten img,
    &.hover-grayscale img,
    &.hover-fade img {
      transition:
        transform 0.35s ease,
        filter 0.35s ease,
        opacity 0.35s ease;
    }

    &.hover-zoom:hover img {
      transform: scale(1.08);
    }

    &.hover-zoom-out img {
      transform: scale(1.08);
    }
    &.hover-zoom-out:hover img {
      transform: scale(1);
    }

    &.hover-brighten:hover img {
      filter: brightness(1.1);
    }

    &.hover-grayscale img {
      filter: grayscale(1);
    }
    &.hover-grayscale:hover img {
      filter: grayscale(0);
    }

    &.hover-fade img {
      opacity: 0.85;
    }
    &.hover-fade:hover img {
      opacity: 1;
    }

    &.fit-cover {
      width: 100%;
      height: 100%;
      object-fit: cover;
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &.fluid:not(.fit-cover) {
      width: 100%;
      img {
        width: 100%;
      }
    }

    &.responsive:not(.fluid) {
      @media only screen and (max-width: 1041px) {
        width: 100%;
        max-width: 100%;
        height: auto;
        img {
          width: 100%;
          height: auto;
        }
      }
    }

    &.fit-height:not(.ratio):not(.fit-cover):not(.fluid) {
      width: fit-content;
      max-width: 100%;
      img {
        display: block;
        width: auto;
        max-width: none;
        height: 100%;
      }
    }

    &.ratio {
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &.ratio-1x1 {
      aspect-ratio: 1 / 1;
    }

    &.ratio-16x9 {
      aspect-ratio: 16 / 9;
    }

    &.ratio-4x3 {
      aspect-ratio: 4 / 3;
    }

    &.ratio-3x2 {
      aspect-ratio: 3 / 2;
    }

    &.ratio-2x1 {
      aspect-ratio: 2 / 1;
    }

    &.ratio-9x16 {
      aspect-ratio: 9 / 16;
    }

    &.ratio-3x4 {
      aspect-ratio: 3 / 4;
    }

    &.ratio-2x3 {
      aspect-ratio: 2 / 3;
    }

    &.ratio-1x2 {
      aspect-ratio: 1 / 2;
    }

    &.radius-none {
      border-radius: 0;
    }

    &.radius-sm {
      border-radius: calc(var(--naut-border-radius-sm) * var(--radius-scale));
    }

    &.radius-md {
      border-radius: calc(var(--naut-border-radius-md) * var(--radius-scale));
    }

    &.radius-lg {
      border-radius: calc(var(--naut-border-radius-lg) * var(--radius-scale));
    }

    &.radius-full {
      border-radius: 9999px;
    }

    &.shadow-sm:not(.cover) {
      box-shadow: var(--naut-shadow-sm);
    }

    &.shadow-md:not(.cover) {
      box-shadow: var(--naut-shadow-md);
    }

    &.shadow-lg:not(.cover) {
      box-shadow: var(--naut-shadow-lg);
    }

    &.shadow-xl:not(.cover) {
      box-shadow: var(--naut-shadow-xl);
    }
  }
</style>
