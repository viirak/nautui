---
import type { Base, Radius } from "../types";

export interface ImageProps extends Base {
  alt: string;
  cover?: boolean;
  fluid?: boolean;
  maxWidth?: string;
  radius?: Radius;
  ratio?: "1:1" | "16:9" | "4:3" | "3:2" | "2:1" | "9:16 | 3:4" | "2:3" | "1:2";
  shadow?: "sm" | "md" | "lg" | "xl";
  src: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  class: className,
  ratio,
  radius,
  shadow,
  cover = false,
  fluid = false,
  maxWidth,
  ...rest
} = Astro.props as ImageProps;
const ratioName = ratio ? ratio.replace(":", "x") : undefined;
const maxWidthVar = maxWidth ? maxWidth : "none";
---

<div
  class:list={[
    "naut-image",
    ratioName && `ratio ratio-${ratioName}`,
    radius && `radius-${radius}`,
    shadow && `shadow-${shadow}`,
    cover && "fit-cover",
    fluid && "fluid",
    className
  ]}
>
  <img src={src} alt={alt} {...rest}>
</div>
<style define:vars={{ maxWidthVar }}>
  .naut-image {
    --radius-scale: 1.575;
    position: relative;
    display: inline-block;
    max-width: var(--maxWidthVar);
    overflow: hidden;
    background-color: var(--naut-color-surface);

    img {
      display: block;
    }

    &.fit-cover {
      width: 100%;
      height: 100%;
      object-fit: cover;
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &.fluid {
      width: 100%;
      img {
        width: 100%;
      }
    }

    &.ratio {
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &.ratio-1x1 {
      aspect-ratio: 1 / 1;
    }

    &.ratio-16x9 {
      aspect-ratio: 16 / 9;
    }

    &.ratio-4x3 {
      aspect-ratio: 4 / 3;
    }

    &.ratio-3x2 {
      aspect-ratio: 3 / 2;
    }

    &.ratio-2x1 {
      aspect-ratio: 2 / 1;
    }

    &.ratio-9x16 {
      aspect-ratio: 9 / 16;
    }

    &.ratio-3x4 {
      aspect-ratio: 3 / 4;
    }

    &.ratio-2x3 {
      aspect-ratio: 2 / 3;
    }

    &.ratio-1x2 {
      aspect-ratio: 1 / 2;
    }

    &.radius-none {
      border-radius: 0;
    }

    &.radius-sm {
      border-radius: calc(var(--naut-border-radius-sm) * var(--radius-scale));
    }

    &.radius-md {
      border-radius: calc(var(--naut-border-radius-md) * var(--radius-scale));
    }

    &.radius-lg {
      border-radius: calc(var(--naut-border-radius-lg) * var(--radius-scale));
    }

    &.radius-full {
      border-radius: 9999px;
    }

    &.shadow-sm {
      box-shadow: var(--naut-shadow-sm);
    }

    &.shadow-md {
      box-shadow: var(--naut-shadow-md);
    }

    &.shadow-lg {
      box-shadow: var(--naut-shadow-lg);
    }

    &.shadow-xl {
      box-shadow: var(--naut-shadow-xl);
    }
  }
</style>
