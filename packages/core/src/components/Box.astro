---
import { getBorderStyles } from "../lib/border";
import { resolveMargin, resolvePadding, spacingToStyle } from "../lib/spacing";
import type { Base, Border, Radius, SpacingProps } from "../types";

export interface BoxProps extends Base, SpacingProps {
  border?: Border;
  bordered?: boolean;
  display?: "block" | "flex" | "grid";
  radius?: Radius;
}

const {
  bordered = false,
  border,
  radius,
  display = "block",
  class: className,
  p = "md",
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as BoxProps;

const borderStyles = border ? getBorderStyles(border) : undefined;
const paddingStyles = resolvePadding({ p, px, py, pt, pr, pb, pl });
const marginStyles = resolveMargin({ m, mx, my, mt, mr, mb, ml });
---

<div class:list={["naut-box", bordered && "bordered", className]} {...rest}>
  <slot name="before" />
  <div class:list={["naut-box--wrapper", display]}><slot /></div>
  <slot name="after" />
</div>

<style
  define:vars={{ display, ...borderStyles, ...paddingStyles, ...marginStyles }}
>
  .naut-box {
    position: relative;
    display: flow-root; /* Prevents margin collapsing */

    margin-top: var(--marginTop);
    margin-right: var(--marginRight);
    margin-bottom: var(--marginBottom);
    margin-left: var(--marginLeft);
    border-top: var(--borderTop);
    border-right: var(--borderRight);
    border-bottom: var(--borderBottom);
    border-left: var(--borderLeft);
    border-radius: var(--borderRadius);

    &.bordered {
      border: 1px solid var(--naut-color-border);
    }

    .naut-box--wrapper {
      position: relative;
      padding-top: var(--paddingTop);
      padding-right: var(--paddingRight);
      padding-bottom: var(--paddingBottom);
      padding-left: var(--paddingLeft);

      &.flex {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
      }
    }
  }
</style>
