---
import { resolveMargin, resolvePadding, spacingToStyle } from "../lib/spacing";
import type { Base, Radius, SpacingProps } from "../types";

export interface BoxProps extends Base, SpacingProps {
  bordered?: boolean;
  display?: "block" | "flex" | "grid";
  radius?: Radius;
}

const {
  bordered = false,
  radius,
  display = "block",
  class: className,
  p = "md",
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as BoxProps;

const borderStyle = bordered ? "1px solid var(--naut-color-border)" : "none";
const borderRadius = radius ? `var(--naut-border-radius-${radius})` : "none";
const paddingStyle = spacingToStyle(
  resolvePadding({ p, px, py, pt, pr, pb, pl })
);
const marginStyle = spacingToStyle(
  resolveMargin({ m, mx, my, mt, mr, mb, ml })
);
---

<div
  class:list={["naut-box", className]}
  style={`${paddingStyle}; ${marginStyle}`}
  {...rest}
>
  <slot name="before" />
  <div class:list={["naut-box--wrapper", display]}><slot /></div>
  <slot name="after" />
</div>

<style define:vars={{ display, borderStyle, borderRadius }}>
  .naut-box {
    position: relative;
    display: flow-root; /* Prevents margin collapsing */
    background: var(--backgroundPattern);
    border: var(--borderStyle);
    border-radius: var(--borderRadius);

    .naut-box--wrapper {
      position: relative;

      &.flex {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
      }
    }
  }
</style>
