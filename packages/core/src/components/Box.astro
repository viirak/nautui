---
import "../styles/spacing/padding.css";
import "../styles/spacing/margin.css";
import "../styles/border.css";
import "../styles/radius.css";
import { type Border, createBorder } from "../lib/border";
import {
  extractSpacingProps,
  getSpacingClasses,
  SpacingProps,
} from "../lib/spacing";
import type { Base, Radius, Responsive, Size } from "../types";

type CornerStyle = "diamond" | "square" | "circle" | "plus" | "x";
type TaDirection = "left" | "center" | "right";
type TaValue = TaDirection | { [key in Responsive]?: TaDirection };

export interface Corner {
  bottomLeft?: CornerStyle;
  bottomRight?: CornerStyle;
  topLeft?: CornerStyle;
  topRight?: CornerStyle;
}

export interface BoxProps extends Base, SpacingProps {
  border?: Border;
  centered?: boolean;
  corner?: Corner;
  maxWidth?: "xs" | Size;
  radius?: Radius;
  ta?: TaValue;
}

const { padding, margin, nonSpacing } = extractSpacingProps(
  Astro.props as BoxProps
);

const {
  border,
  radius,
  corner,
  centered = false,
  maxWidth,
  ta,
  class: className,
  ...rest
} = nonSpacing;

const borderConfig =
  typeof border === "string" ? { width: border } : border || {};
const { borderClasses, borderColors } = createBorder(borderConfig);

const p = Object.keys(padding).length === 0 ? "md" : padding.p;
const marginClasses = getSpacingClasses({ ...margin });
const paddingClasses = getSpacingClasses({ ...padding, p });
const taValue = typeof ta === "string" ? { base: ta } : ta;
const classlist = [
  "naut-box",
  radius && `radius-${radius}`,
  centered && "centered",
  maxWidth && `max-w-${maxWidth}`,
  taValue?.base && `ta-${taValue.base}`,
  taValue?.sm && `sm-ta-${taValue.sm}`,
  taValue?.md && `md-ta-${taValue.md}`,
  taValue?.lg && `lg-ta-${taValue.lg}`,
  taValue?.xl && `xl-ta-${taValue.xl}`,
  className,
  ...borderClasses,
  ...marginClasses,
];
---

<div class:list={classlist} {...rest}>
  {corner?.topLeft && <span class:list={["corner", "top-left", corner.topLeft]} />}
  {corner?.topRight && <span class:list={["corner", "top-right", corner.topRight]} />}
  {corner?.bottomRight && <span class:list={["corner", "bottom-right", corner.bottomRight]} />}
  {corner?.bottomLeft && <span class:list={["corner", "bottom-left", corner.bottomLeft]} />}
  <slot name="background" />
  <slot name="before" />
  <div class:list={["naut-box__wrapper", ...paddingClasses]}><slot /></div>
  <slot name="after" />
</div>

<style define:vars={{ ...borderColors }}>
  .naut-box {
    position: relative;
    display: flow-root; /* Prevents margin collapsing */

    &.centered {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
    }

    /* text-align */
    &.ta-left {
      text-align: left;
    }
    &.ta-center {
      text-align: center;
    }
    &.ta-right {
      text-align: right;
    }

    @media (max-width: 817px) {
      &.sm-ta-left {
        text-align: left;
      }
      &.sm-ta-center {
        text-align: center;
      }
      &.sm-ta-right {
        text-align: right;
      }
    }

    @media (min-width: 818px) and (max-width: 1041px) {
      &.md-ta-left {
        text-align: left;
      }
      &.md-ta-center {
        text-align: center;
      }
      &.md-ta-right {
        text-align: right;
      }
    }

    @media (min-width: 1042px) and (max-width: 1249px) {
      &.lg-ta-left {
        text-align: left;
      }
      &.lg-ta-center {
        text-align: center;
      }
      &.lg-ta-right {
        text-align: right;
      }
    }

    @media (min-width: 1250px) {
      &.xl-ta-left {
        text-align: left;
      }
      &.xl-ta-center {
        text-align: center;
      }
      &.xl-ta-right {
        text-align: right;
      }
    }

    /* max-width */
    &.max-w-xs {
      max-width: 480px;
      margin-inline: auto;
    }
    &.max-w-sm {
      max-width: 640px;
      margin-inline: auto;
    }
    &.max-w-md {
      max-width: 768px;
      margin-inline: auto;
    }
    &.max-w-lg {
      max-width: 1024px;
      margin-inline: auto;
    }
    &.max-w-xl {
      max-width: 1280px;
      margin-inline: auto;
    }

    .naut-box__wrapper {
      position: relative;
      overflow: hidden;
    }

    .corner {
      position: absolute;
      z-index: 1;
      width: 9px;
      height: 9px;

      &.square,
      &.circle,
      &.diamond {
        background-color: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);

        &.top-left {
          top: -0.38rem;
          left: -0.35rem;
        }

        &.top-right {
          top: -0.38rem;
          right: -0.4rem;
        }

        &.bottom-left {
          bottom: -0.35rem;
          left: -0.36rem;
        }

        &.bottom-right {
          right: -0.4rem;
          bottom: -0.35rem;
        }
      }

      &.circle {
        border-radius: 50%;
      }

      &.diamond {
        transform: rotate(45deg);
      }

      &.plus,
      &.x {
        &.top-left {
          top: -0.33rem;
          left: -0.31rem;
        }

        &.top-right {
          top: -0.33rem;
          right: -0.32rem;
        }

        &.bottom-left {
          bottom: -0.32rem;
          left: -0.31rem;
        }

        &.bottom-right {
          right: -0.32rem;
          bottom: -0.32rem;
        }

        &::before,
        &::after {
          position: absolute;
          top: 50%;
          left: 50%;
          content: "";
          background-color: var(--naut-color-border-strong);
        }
      }

      &.plus {
        &::before {
          width: 1px;
          height: 100%;
          transform: translate(-50%, -50%);
        }

        &::after {
          width: 100%;
          height: 1px;
          transform: translate(-50%, -50%);
        }
      }

      &.x {
        &::before,
        &::after {
          width: 100%;
          height: 1px;
          transform: translate(-50%, -50%) rotate(45deg);
        }

        &::after {
          transform: translate(-50%, -50%) rotate(-45deg);
        }
      }
    }
  }
</style>
