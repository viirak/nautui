---
import "../styles/spacing/padding.css";
import "../styles/spacing/margin.css";
import "../styles/border.css";
import { type Border, createBorder } from "../lib/border";
import {
  createSpacingClasses,
  extractSpacingProps,
  SpacingProps,
} from "../lib/spacing";
import type { Base, Radius } from "../types";

export interface BoxProps extends Base, SpacingProps {
  border?: Border;
  radius?: Radius;
}

const { padding, spacing, nonSpacing } = extractSpacingProps(
  Astro.props as BoxProps
);

const { border, radius, class: className, ...rest } = nonSpacing;

const borderConfig =
  typeof border === "string" ? { width: border } : border || {};
const { borderClasses, borderColors } = createBorder(borderConfig);

const noPadding = Object.values(padding).every((v) => v === undefined);
const p = noPadding ? "md" : undefined;
const spacingClasses = createSpacingClasses({ ...spacing, p });
const classlist = [
  "naut-box",
  radius && `radius-${radius}`,
  className,
  ...borderClasses,
  ...spacingClasses,
];
---

<div class:list={classlist} {...rest}>
  <slot name="background" />
  <slot name="before" />
  <div class:list={["naut-box--wrapper"]}><slot /></div>
  <slot name="after" />
</div>

<style define:vars={{ ...borderColors }}>
  .naut-box {
    position: relative;
    display: flow-root; /* Prevents margin collapsing */
    overflow: hidden; /* Clip background to borders */

    &.radius-sm {
      border-radius: var(--naut-border-radius-sm);
    }
    &.radius-md {
      border-radius: var(--naut-border-radius-md);
    }
    &.radius-lg {
      border-radius: var(--naut-border-radius-lg);
    }
    &.radius-xl {
      border-radius: var(--naut-border-radius-xl);
    }

    .naut-box--wrapper {
      position: relative;
    }
  }
</style>
