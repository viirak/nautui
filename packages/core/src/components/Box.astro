---
import { type Border, getBorderStyles } from "../lib/border";
import { createMargin, createPadding } from "../lib/spacing";
import type { Base, Radius, SpacingProps } from "../types";

export interface BoxProps extends Base, SpacingProps {
  border?: Border;
  bordered?: boolean;
  display?: "block" | "flex" | "grid";
  radius?: Radius;
}

const {
  bordered = false,
  border,
  radius,
  display = "block",
  class: className,
  p = "md",
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as BoxProps;

const borderStyles = border ? getBorderStyles(border) : undefined;
const padding = createPadding("box", { p, px, py, pt, pr, pb, pl });
const margin = createMargin("box", { m, mx, my, mt, mr, mb, ml });
---

<div class:list={["naut-box", bordered && "bordered", className]} {...rest}>
  <slot name="before" />
  <div class:list={["naut-box--wrapper", display]}><slot /></div>
  <slot name="after" />
</div>

<style define:vars={{ display, ...borderStyles, ...padding, ...margin }}>
  .naut-box {
    position: relative;
    display: flow-root; /* Prevents margin collapsing */

    margin: var(--boxMarginTop) var(--boxMarginRight) var(--boxMarginBottom)
      var(--boxMarginLeft);
    border-top: var(--borderTop);
    border-right: var(--borderRight);
    border-bottom: var(--borderBottom);
    border-left: var(--borderLeft);
    border-radius: var(--borderRadius);

    &.bordered {
      border: 1px solid var(--naut-color-border);
    }

    .naut-box--wrapper {
      position: relative;
      display: var(--display);
      padding: var(--boxPaddingTop) var(--boxPaddingRight)
        var(--boxPaddingBottom) var(--boxPaddingLeft);

      &.flex {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
      }
    }
  }
</style>
