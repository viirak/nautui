---
import { type Border, createBorder } from "../lib/border";
import { createSpacingClasses, extractSpacingProps } from "../lib/spacing";
import type { Base, Radius, SpacingProps } from "../types";
import "../styles/spacing.css";

export interface BoxProps extends Base, SpacingProps {
  border?: Border;
  bordered?: boolean;
  radius?: Radius;
}

const { spacing, nonSpacing } = extractSpacingProps(Astro.props as BoxProps);

const {
  bordered = false,
  border,
  radius,
  class: className,
  ...rest
} = nonSpacing;

const boxBorder = createBorder("box", border);
const spacingClasses = createSpacingClasses({ ...spacing, p: "md" });
const classlist = [
  "naut-box",
  bordered && "bordered",
  className,
  ...spacingClasses,
];
---

<div class:list={classlist} {...rest}>
  <slot name="background" />
  <slot name="before" />
  <div class:list={["naut-box--wrapper"]}><slot /></div>
  <slot name="after" />
</div>

<style define:vars={{ ...boxBorder }}>
  .naut-box {
    position: relative;
    display: flow-root; /* Prevents margin collapsing */
    overflow: hidden; /* Clip background to borders */

    border-top: var(--boxBorderTop);
    border-right: var(--boxBorderRight);
    border-bottom: var(--boxBorderBottom);
    border-left: var(--boxBorderLeft);
    border-radius: var(--boxBorderRadius);

    &.bordered {
      border: 1px solid var(--naut-color-border);
    }

    .naut-box--wrapper {
      position: relative;
    }
  }
</style>
