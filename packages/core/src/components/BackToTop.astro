---
import type { Base } from "../types";

export interface BackToTopProps extends Base {
  label?: string;
  offset?: string;
  position?: "bottom-right" | "bottom-left";
  showLabel?: boolean;
  threshold?: number;
}

const {
  class: className,
  label = "Back to top",
  offset = "1.5rem",
  position = "bottom-right",
  showLabel = false,
  threshold = 400,
  ...rest
} = Astro.props as BackToTopProps;
---

<button
  type="button"
  class:list={[
    "naut-back-to-top",
    `position--${position}`,
    showLabel && "with-label",
    className,
  ]}
  aria-label={label}
  title={label}
  data-naut-threshold={threshold}
  {...rest}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m5 12 7-7 7 7" />
    <path d="M12 19V5" />
  </svg>
  {showLabel && <span class="naut-back-to-top__label">{label}</span>}
</button>

<style
  define:vars={{
    offset,
  }}
>
  .naut-back-to-top {
    position: fixed;
    right: var(--offset);
    bottom: var(--offset);
    z-index: 40;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.625rem;
    color: var(--naut-color-content);
    pointer-events: none;
    cursor: pointer;
    background-color: var(--naut-color-base-0);
    border: 1px solid var(--naut-color-border);
    border-radius: 9999px;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;

    &.active {
      pointer-events: auto;
      opacity: 1;
      transform: translateY(0);
    }

    &.position--bottom-left {
      right: auto;
      left: var(--offset);
    }

    &.with-label {
      padding-inline: 0.75rem;
    }

    &:hover {
      color: var(--naut-color-primary);
      border-color: var(--naut-color-primary);
    }

    &:focus-visible {
      outline: 2px solid var(--naut-color-primary);
      outline-offset: 2px;
    }

    svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  .naut-back-to-top__label {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-naut-threshold]"
  );

  if (buttons.length) {
    const onScroll = () => {
      const y = window.scrollY;
      for (const btn of Array.from(buttons)) {
        const threshold = Number(btn.dataset.nautThreshold ?? 400);
        btn.classList.toggle("active", y > threshold);
      }
    };

    const onClick = () => {
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    };

    for (const btn of Array.from(buttons)) {
      btn.addEventListener("click", onClick);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
