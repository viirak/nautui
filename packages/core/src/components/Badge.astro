---
import { getColorValue } from "../lib/color";
import { getPillPadding, type SpacingStep } from "../lib/spacing";
import type { Base, Color, Radius } from "../types";

export interface BadgeProps extends Base {
  color?: Color;
  dark?: boolean;
  dotted?: boolean;
  gradient?: { colors: string[]; textColor: string; deg?: number };
  iconOnly?: boolean;
  letterSpacing?: "sm" | "md" | "lg";
  /** Not supported — wrap in a `Box`. */
  margin?: never;
  outlineColor?: string;
  /**
   * One spacing step, not an axis object: a badge's silhouette depends on
   * inline padding exceeding block padding, so the component derives both axes
   * itself (see `getPillPadding`). Ignored for `variant="text"`.
   */
  padding?: SpacingStep;
  radius?: Radius | "full";
  size?: "sm" | "md" | "lg";
  uppercase?: boolean;
  variant?:
    | "text"
    | "border"
    | "surface"
    | "outline"
    | "primary"
    | "secondary"
    | "destructive";
}

const {
  size = "md",
  variant = "text",
  gradient,
  radius = "sm",
  letterSpacing = "md",
  outlineColor,
  dotted = false,
  uppercase = false,
  color,
  dark = false,
  iconOnly = false,
  padding: paddingProp,
  margin,
  ...rest
} = Astro.props as BadgeProps;

if (margin !== undefined) {
  throw new TypeError(
    "Badge: `margin` is not supported. Wrap the badge in a `Box`, or pass a spacing utility class."
  );
}

const gradientBg = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : "none";
const colorValue = getColorValue(color);

const sizePadding: Record<NonNullable<BadgeProps["size"]>, SpacingStep> = {
  sm: "xs",
  md: "sm",
  lg: "md",
};
const paddingStep: SpacingStep = paddingProp ?? sizePadding[size];
// Badge always keeps the pill ratio — it has no square/circle toggle, so
// nothing opts out. (`iconOnly` is a visual variant with its own padding rule.)
const pillPadding = getPillPadding(paddingStep);
const padX = variant === "text" ? "0px" : pillPadding.x;
const padY = variant === "text" ? "0px" : pillPadding.y;
---

<div
  class:list={[
    "naut-badge",
    `variant--${variant}`,
    `radius--${radius}`,
    `size--${size}`,
    (["primary", "secondary", "destructive"].includes(variant) || gradient) && "filled",
    colorValue && !gradient && "color--custom",
    dark && "dark",
    dotted && "dotted",
    uppercase && "uppercase",
    gradient && "color--gradient",
    letterSpacing && `ls--${letterSpacing}`,
    iconOnly && "icon-only"
  ]}
  {...rest}
>
  <slot />
</div>
<style
  define:vars={{
  gradientBg,
  gradientColor: gradient?.textColor,
  outlineColor,
  colorValue: colorValue ?? "",
  padX,
  padY
}}
>
  .naut-badge {
    --outline-color: var(--outlineColor);
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    padding-block: var(--padY);
    padding-inline: var(--padX);
    color: var(--naut-color-content);
    text-wrap: nowrap;

    &.uppercase {
      text-transform: uppercase;
    }

    &.ls--sm {
      letter-spacing: 0.05rem;
    }

    &.ls--md {
      letter-spacing: 0.1rem;
    }

    &.ls--lg {
      letter-spacing: 0.185rem;
    }

    &.color--gradient {
      color: var(--gradientColor);
      background: var(--gradientBg);
    }

    &.variant--border {
      border: 1px solid var(--naut-color-border);
    }

    &.variant--text {
      border: none;
    }

    &.variant--surface {
      background-color: var(--naut-color-base-200);
      border: none;
    }

    &.variant--outline {
      color: var(--outline-color);
      border: 1px solid var(--naut-color-border-strong);
    }

    &.variant--primary {
      color: var(--naut-color-primary-content);
      background-color: var(--naut-color-primary);
      border: none;
    }

    &.variant--secondary {
      color: var(--naut-color-secondary-content);
      background-color: var(--naut-color-secondary);
      border: none;
    }

    &.variant--destructive {
      color: var(--naut-color-destructive-content);
      background-color: var(--naut-color-destructive);
      border: none;
    }

    &.dotted {
      &::before {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        content: "";
        background-color: var(--naut-color-content);
        border-radius: 50%;
      }
    }

    &.color--custom {
      color: var(--colorValue);

      &.dotted::before {
        background-color: currentColor;
      }
    }

    &.radius--sm {
      border-radius: var(--naut-border-radius-sm);
    }

    &.radius--md {
      border-radius: var(--naut-border-radius-md);
    }

    &.radius--lg {
      border-radius: var(--naut-border-radius-lg);
    }

    &.radius--full {
      border-radius: 50rem;
    }

    &.icon-only {
      aspect-ratio: 1 / 1;
      padding: 0.85rem;
    }

    &.size--sm {
      font-size: 0.75rem;
    }

    &.size--md {
      font-size: 0.875rem;
    }
  }
</style>
