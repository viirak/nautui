---
import { getColorValue } from "../lib/color";
import { getPillPadding, type SpacingStep } from "../lib/spacing";
import type { Base, Color, Radius } from "../types";

export type BadgeOutlineColor = "soft" | "normal" | "strong";

const outlineColors: readonly BadgeOutlineColor[] = [
  "soft",
  "normal",
  "strong",
];

export interface BadgeProps extends Base {
  color?: Color;
  dark?: boolean;
  dotted?: boolean;
  gradient?: { colors: string[]; textColor: string; deg?: number };
  iconOnly?: boolean;
  letterSpacing?: "sm" | "md" | "lg";
  /** Not supported — wrap in a `Box`. */
  margin?: never;
  /** Adds a border, independently of the fill `variant`. */
  outline?: boolean;
  /** Border weight for `outline`. Hue comes from `color`. */
  outlineColor?: BadgeOutlineColor;
  /**
   * One spacing step, not an axis object: a badge's silhouette depends on
   * inline padding exceeding block padding, so the component derives both axes
   * itself (see `getPillPadding`). Ignored for `variant="text"`.
   */
  padding?: SpacingStep;
  radius?: Radius | "full";
  size?: "sm" | "md" | "lg";
  uppercase?: boolean;
  variant?:
    | "text"
    | "surface"
    | "primary"
    | "secondary"
    | "destructive"
    /** @deprecated Use `outline` (with `outlineColor` for the weight). */
    | "border"
    /** @deprecated Use `outline outlineColor="strong"`. */
    | "outline";
}

const {
  size = "md",
  variant = "text",
  gradient,
  radius = "sm",
  letterSpacing = "md",
  outline = false,
  outlineColor,
  dotted = false,
  uppercase = false,
  color,
  dark = false,
  iconOnly = false,
  padding: paddingProp,
  margin,
  ...rest
} = Astro.props as BadgeProps;

if (margin !== undefined) {
  throw new TypeError(
    "Badge: `margin` is not supported. Wrap the badge in a `Box`, or pass a spacing utility class."
  );
}

const gradientBg = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : "none";
const colorValue = getColorValue(color);

// `border`/`outline` are legacy spellings of the `outline` flag: `outline`
// used the strong border, `border` the normal one.
const isLegacyOutline = variant === "border" || variant === "outline";
const resolvedVariant = isLegacyOutline ? "text" : variant;
const hasOutline = outline || isLegacyOutline;
// A weight outside the union would emit `outline--<value>`, matching no rule,
// so the border would silently vanish. Catch it instead.
if (outlineColor !== undefined && !outlineColors.includes(outlineColor)) {
  throw new TypeError(
    `Badge: unknown outlineColor ${JSON.stringify(outlineColor)}. Expected one of ${outlineColors.join(" | ")}.`
  );
}
const outlineWeight: BadgeOutlineColor =
  outlineColor ?? (variant === "outline" ? "strong" : "normal");

// Fixed rem rather than --naut-spacing-*: the spacing tokens grow ~2.4x faster
// than a type scale, which made `lg` climb 54px -> 64px across the viewport.
// Each pair keeps inline > block so the pill ratio still reads.
const sizePadding: Record<
  NonNullable<BadgeProps["size"]>,
  { x: string; y: string }
> = {
  sm: { x: "0.5rem", y: "0.25rem" },
  md: { x: "0.625rem", y: "0.375rem" },
  lg: { x: "0.75rem", y: "0.4375rem" },
};
// `iconOnly` is square, so it wants symmetric padding taken from the size's
// inline value. It overrides both the size default and an explicit `padding`,
// and is exempt from `isBare` below — a bare icon-only badge still needs room
// around its glyph. An explicit `padding` otherwise resolves against the
// fluid spacing tokens.
let pillPadding = sizePadding[size];
if (iconOnly) {
  pillPadding = { x: sizePadding[size].x, y: sizePadding[size].x };
} else if (paddingProp) {
  pillPadding = getPillPadding(paddingProp);
}
// Bare text carries no padding; an outlined badge is still a badge, so the
// border axis counts as ink even when the fill is `text`.
const isBare = resolvedVariant === "text" && !hasOutline && !iconOnly;
const padX = isBare ? "0px" : pillPadding.x;
const padY = isBare ? "0px" : pillPadding.y;
---

<div
  class:list={[
    "naut-badge",
    `variant--${resolvedVariant}`,
    `radius--${radius}`,
    `size--${size}`,
    colorValue && !gradient && "color--custom",
    dark && "dark",
    dotted && "dotted",
    uppercase && "uppercase",
    gradient && "color--gradient",
    letterSpacing && `ls--${letterSpacing}`,
    hasOutline && `outline--${outlineWeight}`,
    iconOnly && "icon-only"
  ]}
  {...rest}
>
  <slot />
</div>
<style
  define:vars={{
  gradientBg,
  gradientColor: gradient?.textColor,
  colorValue: colorValue ?? "",
  padX,
  padY
}}
>
  .naut-badge {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    padding-block: var(--padY);
    padding-inline: var(--padX);
    line-height: var(--naut-line-height-ratio);
    color: var(--naut-color-content);
    text-wrap: nowrap;

    &.uppercase {
      text-transform: uppercase;
    }

    &.ls--sm {
      letter-spacing: 0.05rem;
    }

    &.ls--md {
      letter-spacing: 0.1rem;
    }

    &.ls--lg {
      letter-spacing: 0.185rem;
    }

    &.color--gradient {
      color: var(--gradientColor);
      background: var(--gradientBg);
    }

    &.variant--text {
      border: none;
    }

    &.variant--surface {
      background-color: var(--naut-color-base-200);
      border: none;
    }

    &.variant--primary {
      color: var(--naut-color-primary-content);
      background-color: var(--naut-color-primary-fill);
      border: none;
    }

    &.variant--secondary {
      color: var(--naut-color-secondary-content);
      background-color: var(--naut-color-secondary-fill);
      border: none;
    }

    &.variant--destructive {
      color: var(--naut-color-destructive-content);
      background-color: var(--naut-color-destructive);
      border: none;
    }

    &.outline--soft {
      border: 1px solid var(--naut-color-border-soft);
    }

    &.outline--normal {
      border: 1px solid var(--naut-color-border);
    }

    &.outline--strong {
      border: 1px solid var(--naut-color-border-strong);
    }

    &.color--custom.outline--soft,
    &.color--custom.outline--normal,
    &.color--custom.outline--strong {
      border-color: var(--colorValue);
    }

    &.dotted {
      &::before {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        content: "";
        background-color: var(--naut-color-content);
        border-radius: 50%;
      }
    }

    &.color--custom {
      color: var(--colorValue);

      &.dotted::before {
        background-color: currentColor;
      }
    }

    &.radius--sm {
      border-radius: var(--naut-border-radius-sm);
    }

    &.radius--md {
      border-radius: var(--naut-border-radius-md);
    }

    &.radius--lg {
      border-radius: var(--naut-border-radius-lg);
    }

    &.radius--full {
      border-radius: 50rem;
    }

    &.icon-only {
      aspect-ratio: 1 / 1;
    }

    &.size--sm {
      font-size: 0.6875rem;
    }

    &.size--md {
      font-size: 0.75rem;
    }

    &.size--lg {
      font-size: 0.875rem;
    }
  }
</style>
