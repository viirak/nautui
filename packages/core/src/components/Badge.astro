---
import {
  getPaddingClassList,
  type Padding,
  type Spacing,
} from "../lib/spacing";
import type { Base, Radius } from "../types";
import "../styles/spacing/padding.css";

export interface BadgeProps extends Base {
  color?: "primary" | "secondary" | "destructive";
  dotted?: boolean;
  gradient?: { colors: string[]; textColor: string; deg?: number };
  iconOnly?: boolean;
  letterSpacing?: "sm" | "md" | "lg";
  outlineColor?: string;
  padding?: Spacing | Padding;
  radius?: Radius | "full";
  size?: "sm" | "md" | "lg";
  variant?:
    | "text"
    | "border"
    | "surface"
    | "outline"
    | "primary"
    | "secondary"
    | "destructive";
}

const {
  size = "md",
  gradient,
  radius = "sm",
  letterSpacing = "md",
  outlineColor,
  variant = "text",
  iconOnly = false,
  dotted = false,
  color,
  padding: paddingProp,
  ...rest
} = Astro.props as BadgeProps;

const gradientBg = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : "none";
let paddingClasses: string[] = [];
if (paddingProp) {
  paddingClasses = getPaddingClassList(paddingProp);
} else if (variant !== "text") {
  if (size === "sm") paddingClasses = ["px-xs", "py-xs"];
  else if (size === "md") paddingClasses = ["px-sm", "py-sm"];
  else paddingClasses = ["px-md", "py-md"];
}
---

<div
  class:list={[
    "naut-badge",
    `variant--${variant}`,
    `radius--${radius}`,
    `size--${size}`,
    (["primary", "secondary", "destructive"].includes(variant) || gradient) && "filled",
    color && `color--${color}`,
    dotted && "dotted",
    gradient && "color--gradient",
    letterSpacing && `ls--${letterSpacing}`,
    ...paddingClasses,
    iconOnly && "icon-only"
  ]}
  {...rest}
>
  <slot />
</div>
<style
  define:vars={{
  gradientBg,
  gradientColor: gradient?.textColor,
  outlineColor
}}
>
  .naut-badge {
    --outline-color: var(--outlineColor);
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    color: var(--naut-color-content);
    text-transform: uppercase;
    text-wrap: nowrap;

    &.ls--sm {
      letter-spacing: 0.05rem;
    }

    &.ls--md {
      letter-spacing: 0.1rem;
    }

    &.ls--lg {
      letter-spacing: 0.185rem;
    }

    &.color--gradient {
      color: var(--gradientColor);
      background: var(--gradientBg);
    }

    &.variant--border {
      border: 1px solid var(--naut-color-border);
    }

    &.variant--text {
      border: none;
    }

    &.variant--surface {
      background-color: var(--naut-color-base-200);
      border: none;
    }

    &.variant--outline {
      color: var(--outline-color);
      border: 1px solid var(--naut-color-border-strong);
    }

    &.variant--primary {
      color: var(--naut-color-primary-content);
      background-color: var(--naut-color-primary);
      border: none;
    }

    &.variant--secondary {
      color: var(--naut-color-secondary-content);
      background-color: var(--naut-color-secondary);
      border: none;
    }

    &.variant--destructive {
      color: var(--naut-color-destructive-content);
      background-color: var(--naut-color-destructive);
      border: none;
    }

    &.dotted {
      &::before {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        content: "";
        background-color: var(--naut-color-content);
        border-radius: 50%;
      }
    }

    &.color--primary:not(.filled) {
      color: var(--naut-color-primary);
      &.dotted {
        &::before {
          background-color: var(--naut-color-primary);
        }
      }
    }

    &.color--secondary:not(.filled) {
      color: var(--naut-color-secondary);
      &.dotted {
        &::before {
          background-color: var(--naut-color-secondary);
        }
      }
    }

    &.color--destructive:not(.filled) {
      color: var(--naut-color-destructive);
      &.dotted {
        &::before {
          background-color: var(--naut-color-destructive);
        }
      }
    }

    &.radius--sm {
      border-radius: var(--naut-border-radius-sm);
    }

    &.radius--md {
      border-radius: var(--naut-border-radius-md);
    }

    &.radius--lg {
      border-radius: var(--naut-border-radius-lg);
    }

    &.radius--full {
      border-radius: 50rem;
    }

    &.icon-only {
      aspect-ratio: 1 / 1;
      padding: 0.85rem;
    }

    &.size--sm {
      font-size: 0.75rem;
    }

    &.size--md {
      font-size: 0.875rem;
    }
  }
</style>
