---
import type { Base, Radius } from "../types";

export interface BadgeProps extends Base {
  gradient?: { colors: string[]; textColor: string; deg?: number };
  iconOnly?: boolean;
  radius?: Radius | "full";
  size?: "sm" | "md" | "lg";
  dotted?: boolean;
  variant?: "default" | "text" | "surface" | "outline" | "primary" | "secondary" | "destructive"
}

const {
  size = "md",
  solid = { background: "darkorchid", color: "white" },
  gradient,
  radius = "sm",
  variant = "default",
  iconOnly = false,
  dotted = false,
  ...rest
} = Astro.props as BadgeProps;

const gradientBg = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : "none";
---

<div
  class:list={[
    "naut-badge",
    `variant--${variant}`,
    `radius--${radius}`,
    `size--${size}`,
    dotted && "dotted",
    gradient && "color--gradient",
    iconOnly && "icon-only"]}
  {...rest}
>
  <slot />
</div>
<style
  define:vars={{
  gradientBg,
  gradientColor: gradient?.textColor
}}
>
  .naut-badge {
    --outline-color: var(--outlineColor);
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    text-wrap: nowrap;

    &.color--gradient {
      color: var(--gradientColor);
      background: var(--gradientBg);
    }

    &.variant--default {
      border: 1px solid var(--naut-color-border);
    }

    &.variant--text {
      color: var(--naut-color-content);
      border: none;
    }

    &.variant--surface {
      color: var(--naut-color-content);
      background-color: var(--naut-color-base-200);
      border: none;
    }

    &.variant--outline {
      color: var(--outline-color);
      border: 1px solid var(--naut-color-border-strong);
    }

    &.variant--primary {
      color: var(--naut-color-primary-content);
      background-color: var(--naut-color-primary);
      border: none;
    }

    &.variant--secondary {
      color: var(--naut-color-secondary-content);
      background-color: var(--naut-color-secondary);
      border: none;
    }

    &.variant--destructive {
      color: var(--naut-color-destructive-content);
      background-color: var(--naut-color-destructive);
      border: none;
    }

    &.dotted {
      &::before {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        content: "";
        background-color: var(--naut-color-content);
        border-radius: 50%;
      }
    }

    &.radius--sm {
      border-radius: var(--naut-border-radius-sm);
    }

    &.radius--md {
      border-radius: var(--naut-border-radius-md);
    }

    &.radius--lg {
      border-radius: var(--naut-border-radius-lg);
    }

    &.radius--full {
      padding: 0.25rem 0.95rem;
      border-radius: 50rem;
    }

    &.icon-only {
      aspect-ratio: 1 / 1;
    }

    &.size--sm {
      padding: 0.03rem 0.65rem;
      font-size: 0.75rem;
      &.icon-only {
        padding: 0.65rem;
      }
    }

    &.size--md {
      padding: 0.2rem 0.85rem;
      font-size: 0.875rem;
      &.icon-only {
        padding: 0.85rem;
      }
    }

    &.size--lg {
      padding: 0.35rem 1.15rem;
      font-size: 1.125rem;
      &.icon-only {
        padding: 1.15rem;
      }
    }
  }
</style>
