---
import type { Base, Gap } from "../types";
import "../styles/spacing/gap.css";

export interface MenuProps extends Base {
  divided?: boolean;
  gap?: Gap;
  horizontal?: boolean;
}

const {
  class: className,
  horizontal = false,
  divided = false,
  gap,
  ...rest
} = Astro.props as MenuProps;
---

<ul
  class:list={[
      "naut-menu naut-menu__list",
      horizontal && "horizontal",
      divided && "divided",
      className, gap && `gap-${gap}`
    ]}
  {...rest}
>
  <slot />
</ul>

<style>
  .naut-menu {
    &.naut-menu__list {
      display: flex;
      flex-direction: column;
      padding: 0;
      margin: 0;
      list-style: none;
    }

    &.horizontal {
      display: inline-flex;
      flex-direction: row;
    }
  }
</style>
