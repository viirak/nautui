---
import "../styles/spacing/padding.css";
import { Border, createBorder } from "../lib/border";
import {
  createSpacingClasses,
  extractSpacingProps,
  PaddingProps,
} from "../lib/spacing";
import type { Base } from "../types";

export interface SectionProps extends Base, PaddingProps {
  as?: "div" | "section" | "article" | "main" | "header" | "footer";
  border?: Border;
  dark?: boolean;
  decoration: "diamond" | "square" | "circle";
  mode?: "default" | "dimmed" | "highlighted" | "inverted";
}

const { padding, nonSpacing } = extractSpacingProps(
  Astro.props as SectionProps
);

const {
  class: className,
  mode,
  border,
  decoration,
  cross,
  dark = false,
  ...rest
} = nonSpacing;

const noPadding = Object.values(padding).every((v) => v === undefined);
const p = noPadding ? "md" : undefined;
const spacingClasses = createSpacingClasses({ ...padding, p });
const sectionBorder = createBorder("section", border);
---

<section
  class:list={[
    "naut-section",
    mode && `${mode}`,
    dark && "dark",
    decoration && `outline-decoration outline-decoration--${decoration}`,
    className,
  ]}
  {...rest}
>
  <slot name="background" />
  <slot name="before" />
  <div class="naut-section--wrapper">
    <div class="naut-section--left"><slot name="left" /></div>
    <div class="naut-section--center">
      <div class:list={["naut-section--content", ...spacingClasses]}>
        <slot />
      </div>
    </div>
    <div class="naut-section--right"><slot name="right" /></div>
  </div>
  <slot name="after" />
</section>

<style define:vars={{ ...sectionBorder }}>
  .naut-section {
    position: relative;
    border-top: var(--sectionBorderTop);
    border-bottom: var(--sectionBorderBottom);

    .naut-section--wrapper {
      position: relative;
      z-index: 1;
      display: flex;

      .naut-section--left,
      .naut-section--right {
        position: relative;
        @media only screen and (min-width: 576px) {
          flex-grow: 1;
        }
      }

      .naut-section--left {
        padding-right: var(--naut-spacing-md);
        border-right: var(--sectionBorderRight);
      }

      .naut-section--right {
        padding-left: var(--naut-spacing-md);
        border-left: var(--sectionBorderLeft);
      }

      .naut-section--center {
        flex: 1;
        overflow: hidden;

        /*Mobile*/
        @media only screen and (min-width: 576px) {
          flex: 1 1 100%;
          max-width: 576px;
          margin: 0 auto;
        }

        /* Tablet */
        @media only screen and (min-width: 818px) and (max-width: 1041px) {
          max-width: 768px;
        }

        /* Desktop */
        @media only screen and (min-width: 1042px) and (max-width: 1249px) {
          max-width: 992px;
        }

        /* Large Desktop */
        @media only screen and (min-width: 1250px) {
          max-width: 1200px;
        }
      }
    }

    &.outline-decoration {
      .naut-section--left::after,
      .naut-section--right::before {
        position: absolute;
        top: -5px;
        z-index: 1;
        width: 7px;
        height: 7px;
        content: "";
      }

      .naut-section--left::after {
        right: -5px;
      }

      .naut-section--right::before {
        left: -5px;
      }
    }

    &.outline-decoration--square {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
      }
    }

    &.outline-decoration--circle {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        border-radius: 50%;
      }
    }

    &.outline-decoration--diamond {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        transform: rotate(45deg);
      }
    }
  }
</style>
