---
import { getPatternStyle } from "../lib/pattern";
import { resolvePadding } from "../lib/spacing";
import type { Base, Pattern, Spacing } from "../types";

export interface SectionProps extends Base {
  as?: "div" | "section" | "article" | "main" | "header" | "footer";
  dark?: boolean;
  mode?: "default" | "dimmed" | "highlighted" | "inverted";
  outline?: {
    top: boolean;
    right: boolean;
    bottom: boolean;
    left: boolean;
    x?: boolean; // shorthand for left and right
    y?: boolean; // shorthand for top and bottom
    style: "solid" | "dashed" | "dotted";
    decoration: "diamond" | "square" | "circle";
  };
  p?: Spacing;
  pattern?: Pattern;
  pb?: Spacing;
  pl?: Spacing;
  pr?: Spacing;
  pt?: Spacing;
  px?: Spacing;
  py?: Spacing;
}

const {
  class: className,
  mode,
  pattern,
  border,
  outline,
  cross,
  dark = false,
  p = "md",
  pl,
  pr,
  px,
  pb,
  pt,
  py,
  ...rest
} = Astro.props as SectionProps;

const backgroundPattern = pattern ? getPatternStyle(pattern) : "transparent";

// outlines
const borderStyle = outline?.style || "solid";
const borderValue = `1px ${borderStyle} var(--naut-color-border)`;
const borderTop = outline?.top || outline?.y ? borderValue : undefined;
const borderRight = outline?.right || outline?.x ? borderValue : undefined;
const borderBottom = outline?.bottom || outline?.y ? borderValue : undefined;
const borderLeft = outline?.left || outline?.x ? borderValue : undefined;
const padding = resolvePadding({ p, pl, pr, px, py, pt, pb });
---

<section
  class:list={[
    "naut-section",
    mode && `${mode}`,
    dark && "dark",
    outline?.decoration && `outline-decoration outline-decoration--${outline.decoration}`,
    className,
  ]}
  {...rest}
>
  {pattern && <div class="naut-section--pattern"></div>}
  <slot name="section-before" />
  <div class="naut-section--wrapper">
    <div class="naut-section--left"></div>
    <div class="naut-section--center">
      <div class="naut-section--content"><slot /></div>
    </div>
    <div class="naut-section--right"></div>
  </div>
  <slot name="section-after" />
</section>

<style
  define:vars={{
    backgroundPattern,
    borderTop,
    borderRight,
    borderLeft,
    borderBottom,
    paddingTop: padding.paddingTop,
    paddingBottom: padding.paddingBottom,
    paddingLeft: padding.paddingLeft,
    paddingRight: padding.paddingRight,
  }}
>
  .naut-section {
    position: relative;
    border-top: var(--borderTop);
    border-bottom: var(--borderBottom);

    .naut-section--wrapper {
      position: relative;
      z-index: 1;
      display: flex;

      .naut-section--content {
        padding-top: var(--paddingTop);
        padding-right: var(--paddingRight);
        padding-bottom: var(--paddingBottom);
        padding-left: var(--paddingLeft);
      }

      .naut-section--left,
      .naut-section--right {
        position: relative;
        @media only screen and (min-width: 576px) {
          flex-grow: 1;
        }
      }

      .naut-section--left {
        padding-right: var(--paddingLeft);
        border-right: var(--borderRight);
      }

      .naut-section--right {
        padding-left: var(--paddingRight);
        border-left: var(--borderLeft);
      }

      .naut-section--center {
        flex: 1;

        /*Mobile*/
        @media only screen and (min-width: 576px) {
          flex: 1 1 100%;
          max-width: 576px;
          margin: 0 auto;
        }

        /* Tablet */
        @media only screen and (min-width: 818px) and (max-width: 1041px) {
          max-width: 768px;
        }

        /* Desktop */
        @media only screen and (min-width: 1042px) and (max-width: 1249px) {
          max-width: 992px;
        }

        /* Large Desktop */
        @media only screen and (min-width: 1250px) {
          max-width: 1200px;
        }
      }
    }

    &.outline-decoration {
      .naut-section--left::after,
      .naut-section--right::before {
        position: absolute;
        top: -5px;
        z-index: 1;
        width: 7px;
        height: 7px;
        content: "";
      }

      .naut-section--left::after {
        right: -5px;
      }

      .naut-section--right::before {
        left: -5px;
      }
    }

    &.outline-decoration--square {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
      }
    }

    &.outline-decoration--circle {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        border-radius: 50%;
      }
    }

    &.outline-decoration--diamond {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        transform: rotate(45deg);
      }
    }

    .naut-section--pattern {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: var(--backgroundPattern);
    }
  }
</style>
