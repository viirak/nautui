---
import { Border, createBorder } from "../lib/border";
import { createPadding } from "../lib/spacing";
import type { Base, SpacingProps } from "../types";

type SectionSpacing = Omit<
  SpacingProps,
  "m" | "mx" | "my" | "mt" | "mr" | "mb" | "ml"
>;

export interface SectionProps extends Base, SectionSpacing {
  as?: "div" | "section" | "article" | "main" | "header" | "footer";
  border?: Border;
  dark?: boolean;
  decoration: "diamond" | "square" | "circle";
  mode?: "default" | "dimmed" | "highlighted" | "inverted";
}

const {
  class: className,
  mode,
  border,
  decoration,
  cross,
  dark = false,
  p = "md",
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  ...rest
} = Astro.props as SectionProps;

const sectionBorder = createBorder("section", border);
const padding = createPadding("section", { p, pl, pr, px, py, pt, pb });
---

<section
  class:list={[
    "naut-section",
    mode && `${mode}`,
    dark && "dark",
    decoration && `outline-decoration outline-decoration--${decoration}`,
    className,
  ]}
  {...rest}
>
  <slot name="before" />
  <div class="naut-section--wrapper">
    <div class="naut-section--left"><slot name="left" /></div>
    <div class="naut-section--center">
      <div class="naut-section--content"><slot /></div>
    </div>
    <div class="naut-section--right"><slot name="right" /></div>
  </div>
  <slot name="after" />
</section>

<style
  define:vars={{
    ...sectionBorder,
    ...padding
  }}
>
  .naut-section {
    position: relative;
    border-top: var(--sectionBorderTop);
    border-bottom: var(--sectionBorderBottom);

    .naut-section--wrapper {
      position: relative;
      z-index: 1;
      display: flex;

      .naut-section--content {
        padding: var(--sectionPaddingTop) var(--sectionPaddingRight)
          var(--sectionPaddingBottom) var(--sectionPaddingLeft);
      }

      .naut-section--left,
      .naut-section--right {
        position: relative;
        @media only screen and (min-width: 576px) {
          flex-grow: 1;
        }
      }

      .naut-section--left {
        padding-right: var(--naut-spacing-md);
        border-right: var(--sectionBorderRight);
      }

      .naut-section--right {
        padding-left: var(--naut-spacing-md);
        border-left: var(--sectionBorderLeft);
      }

      .naut-section--center {
        flex: 1;

        /*Mobile*/
        @media only screen and (min-width: 576px) {
          flex: 1 1 100%;
          max-width: 576px;
          margin: 0 auto;
        }

        /* Tablet */
        @media only screen and (min-width: 818px) and (max-width: 1041px) {
          max-width: 768px;
        }

        /* Desktop */
        @media only screen and (min-width: 1042px) and (max-width: 1249px) {
          max-width: 992px;
        }

        /* Large Desktop */
        @media only screen and (min-width: 1250px) {
          max-width: 1200px;
        }
      }
    }

    &.outline-decoration {
      .naut-section--left::after,
      .naut-section--right::before {
        position: absolute;
        top: -5px;
        z-index: 1;
        width: 7px;
        height: 7px;
        content: "";
      }

      .naut-section--left::after {
        right: -5px;
      }

      .naut-section--right::before {
        left: -5px;
      }
    }

    &.outline-decoration--square {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
      }
    }

    &.outline-decoration--circle {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        border-radius: 50%;
      }
    }

    &.outline-decoration--diamond {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        transform: rotate(45deg);
      }
    }
  }
</style>
