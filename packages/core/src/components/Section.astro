---
import { getPatternStyle } from "../lib/pattern";
import type { Base, Pattern, Spacing } from "../types";
import Container from "./Container.astro";

export interface SectionProps extends Base {
  as?: "div" | "section" | "article" | "main" | "header" | "footer";
  mode?: "default" | "dimmed" | "highlighted" | "inverted";
  outline?: {
    top: boolean;
    right: boolean;
    bottom: boolean;
    left: boolean;
    x?: boolean; // shorthand for left and right
    y?: boolean; // shorthand for top and bottom
    style: "solid" | "dashed" | "dotted";
    decoration: "diamond" | "square" | "circle";
  };
  pattern?: Pattern;
  py?: Spacing;
}

const {
  class: className,
  mode,
  pattern,
  border,
  outline,
  cross,
  py = "md",
  ...rest
} = Astro.props as SectionProps;
const backgroundPattern = pattern ? getPatternStyle(pattern) : "transparent";
const mainPaddingY = `var(--naut-spacing-${py})`;
// outlines
const borderStyle = outline?.style || "solid";
const borderValue = `1px ${borderStyle} var(--naut-color-border)`;
const borderTop = outline?.top || outline?.y ? borderValue : "none";
const borderRight = outline?.right || outline?.x ? borderValue : "none";
const borderBottom = outline?.bottom || outline?.y ? borderValue : "none";
const borderLeft = outline?.left || outline?.x ? borderValue : "none";

const paddingLeft =
  outline?.left || outline?.x ? "var(--naut-spacing-md)" : "0";
const paddingRight =
  outline?.right || outline?.x ? "var(--naut-spacing-md)" : "0";
---

<section
  class:list={[
    "naut-section",
    mode && `${mode}`,
    outline?.decoration && `outline-decoration outline-decoration--${outline.decoration}`,
    className,
  ]}
  {...rest}
>
  {pattern && <div class="section--pattern"></div>}
  <div class="naut-section--wrapper">
    <div class="naut-section--left"></div>
    <Container>
      <div class:list={["naut-section--main", py && `py-${py}`]}><slot /></div>
    </Container>
    <div class="naut-section--right"></div>
  </div>
</section>

<style
  define:vars={{
    backgroundPattern,
    paddingLeft,
    paddingRight,
    borderTop,
    borderRight,
    borderLeft,
    borderBottom,
    mainPaddingY
  }}
>
  .naut-section {
    position: relative;
    border-top: var(--borderTop);
    border-bottom: var(--borderBottom);

    .naut-section--wrapper {
      position: relative;
      z-index: 1;
      display: flex;

      .naut-section--main {
        flex: 0 1 100%; /* respect max-width */
        padding: var(--mainPaddingY) 0;
      }

      .naut-section--left,
      .naut-section--right {
        position: relative;
        flex-grow: 1;
      }

      .naut-section--left {
        padding-right: var(--paddingLeft);
        border-right: var(--borderRight);
      }

      .naut-section--right {
        padding-left: var(--paddingRight);
        border-left: var(--borderLeft);
      }
    }

    &.outline-decoration {
      .naut-section--left::after,
      .naut-section--right::before {
        position: absolute;
        top: -5px;
        z-index: 1;
        width: 7px;
        height: 7px;
        content: "";
      }

      .naut-section--left::after {
        right: -5px;
      }

      .naut-section--right::before {
        left: -5px;
      }
    }

    &.outline-decoration--square {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
      }
    }

    &.outline-decoration--circle {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        border-radius: 50%;
      }
    }

    &.outline-decoration--diamond {
      .naut-section--left::after,
      .naut-section--right::before {
        background: var(--naut-color-base);
        border: 1px solid var(--naut-color-border);
        transform: rotate(45deg);
      }
    }

    .naut-section--pattern {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: var(--backgroundPattern);
    }
  }
</style>
