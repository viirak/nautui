---
import "../styles/spacing/padding.css";
import "../styles/border.css";
import { Border, createBorder } from "../lib/border";
import {
  createSpacingClasses,
  extractSpacingProps,
  PaddingProps,
} from "../lib/spacing";
import type { Base } from "../types";

export interface SectionProps extends Base, PaddingProps {
  as?: "div" | "section" | "article" | "main" | "header" | "footer";
  border?: Border;
  dark?: boolean;
}

const { padding, nonSpacing } = extractSpacingProps(
  Astro.props as SectionProps
);

const { class: className, border, cross, dark = false, ...rest } = nonSpacing;

const noPadding = Object.values(padding).every((v) => v === undefined);
const p = noPadding ? "md" : undefined;
const spacingClasses = createSpacingClasses({ ...padding, p });

const borderConfig =
  typeof border === "string" ? { width: border } : border || {};
const { borderClasses, borderColors } = createBorder(borderConfig);
---

<section
  class:list={[
    "naut-section",
    dark && "dark",
    ...borderClasses,
    className,
  ]}
  {...rest}
>
  <slot name="background" />
  <slot name="before" />
  <div class="naut-section--wrapper">
    <div class="naut-section--left"><slot name="left" /></div>
    <div class="naut-section--center">
      <div class:list={["naut-section--content", ...spacingClasses]}>
        <slot />
      </div>
    </div>
    <div class="naut-section--right"><slot name="right" /></div>
  </div>
  <slot name="after" />
</section>

<style define:vars={{ ...borderColors }}>
  .naut-section {
    position: relative;

    .naut-section--wrapper {
      position: relative;
      z-index: 1;
      display: flex;

      .naut-section--left,
      .naut-section--right {
        position: relative;
        display: flex;
        @media only screen and (min-width: 576px) {
          flex-grow: 1;
        }
      }

      .naut-section--left {
        justify-content: flex-end;
      }

      .naut-section--right {
        justify-content: flex-start;
      }

      .naut-section--center {
        flex: 1;
        overflow: hidden;

        /*Mobile*/
        @media only screen and (min-width: 576px) {
          flex: 1 1 100%;
          max-width: 576px;
          margin: 0 auto;
        }

        /* Tablet */
        @media only screen and (min-width: 818px) and (max-width: 1041px) {
          max-width: 768px;
        }

        /* Desktop */
        @media only screen and (min-width: 1042px) and (max-width: 1249px) {
          max-width: 992px;
        }

        /* Large Desktop */
        @media only screen and (min-width: 1250px) {
          max-width: 1200px;
        }
      }
    }
  }
</style>
