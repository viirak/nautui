---
import type { Base, Radius, Size } from "../types";
import Field from "./Field.astro";

export type TextFieldType =
  | "text"
  | "email"
  | "password"
  | "search"
  | "tel"
  | "url";

export interface TextFieldProps extends Base {
  "aria-describedby"?: string;
  "aria-invalid"?: boolean | "true" | "false" | "grammar" | "spelling";
  description?: string;
  error?: string;
  fullWidth?: boolean;
  id?: string;
  label?: string;
  name?: string;
  radius?: Radius | "none" | "full";
  required?: boolean;
  size?: Size;
  type?: TextFieldType;
}

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  class: className,
  description,
  error: errorMessage,
  fullWidth = false,
  id,
  label,
  radius = "md",
  required = false,
  size = "md",
  type = "text",
  ...rest
} = Astro.props as TextFieldProps;

const descriptionId = id && description ? `${id}-description` : undefined;
const errorId = id && errorMessage ? `${id}-error` : undefined;
const describedBy =
  [ariaDescribedBy, descriptionId, errorId].filter(Boolean).join(" ") ||
  undefined;
const rootClass = className
  ? `naut-text-field ${className}`
  : "naut-text-field";
---

<Field
  class={rootClass}
  description={description}
  error={errorMessage}
  fullWidth={fullWidth}
  id={id}
  label={label}
  radius={radius}
  required={required}
  size={size}
>
  <input
    aria-describedby={describedBy}
    aria-invalid={errorMessage ? "true" : ariaInvalid}
    class="naut-field__control"
    id={id}
    required={required}
    type={type}
    {...rest}
  >
</Field>
