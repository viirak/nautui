---
import {
  getResponsiveClasses,
  normalizeDirection,
  normalizeJustify,
  resolveResponsiveValue,
} from "../lib/layout";
import "../styles/spacing/gap.css";
import type {
  Align,
  Base,
  Direction,
  Gap,
  Justify,
  Responsive,
  ResponsiveProp,
  ResponsiveValue,
} from "../types";

type ScreenSize = Exclude<Responsive, "base">;

export interface GroupProps extends Base {
  align?: ResponsiveProp<Align>;
  direction?: ResponsiveProp<Direction>;
  gap?: Gap;
  grow?: boolean;
  justify?: ResponsiveProp<Justify>;
  not?: ScreenSize | ScreenSize[];
  wrap?: boolean;
}

const {
  class: className,
  align = "center",
  direction,
  justify = "start",
  gap,
  grow = false,
  wrap = false,
  not,
} = Astro.props as GroupProps;
const notScreens = typeof not === "string" ? [not] : not;
const notDirection: ResponsiveValue<Direction> | undefined = notScreens
  ? {}
  : undefined;
if (notDirection) {
  for (const screen of notScreens ?? []) {
    notDirection[screen] = "column";
  }
  if (notScreens?.includes("lg") && !notScreens.includes("xl")) {
    notDirection.xl = "row";
  }
}
const directionValue = resolveResponsiveValue(direction ?? notDirection, "row");
const alignValue = resolveResponsiveValue(align, "center");
const justifyValue = resolveResponsiveValue(justify, "start");
const directionClasses = getResponsiveClasses(
  directionValue,
  "dir",
  normalizeDirection
);
const alignClasses = getResponsiveClasses(alignValue, "align");
const justifyClasses = getResponsiveClasses(
  justifyValue,
  "justify",
  normalizeJustify
);
---

<div
  class:list={[
    "naut-group",
    ...directionClasses,
    ...alignClasses,
    ...justifyClasses,
    grow && "grow",
    wrap && "wrap",
    gap && `gap-${gap}`,
    className,
  ]}
>
  <slot />
</div>

