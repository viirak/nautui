---
import "../styles/spacing/gap.css";
import type { Base, Gap } from "../types";

type ScreenSize = "sm" | "md" | "lg" | "xl";

export interface GroupProps extends Base {
  gap?: Gap;
  grow?: boolean;
  justify?:
    | "start"
    | "center"
    | "end"
    | "space-between"
    | "space-around"
    | "space-evenly";
  not?: ScreenSize | ScreenSize[];
  wrap?: boolean;
}

const {
  class: className,
  justify = "start",
  gap = "md",
  grow = false,
  wrap = false,
  not,
} = Astro.props as GroupProps;
const notScreens = typeof not === "string" ? [not] : not;
---

<div
  class:list={[
  "naut-group",
  grow && "grow",
  wrap && "wrap",
  gap && `gap-${gap}`,
  justify && `justify-${justify}`,
  notScreens?.map((s) => `not-${s}`).join(" "),
  className]}
>
  <slot />
</div>

<style>
  .naut-group {
    display: inline-flex;
    align-items: center;

    &.not-sm {
      @media only screen and (max-width: 817px) {
        flex-direction: column;
      }
    }

    &.not-md {
      @media only screen and (min-width: 818px) and (min-width: 1041px) {
        flex-direction: column;
      }
    }

    &.not-lg {
      @media only screen and (min-width: 1042px) and (min-width: 1249px) {
        flex-direction: column;
      }
    }

    &.not-xl {
      @media only screen and (min-width: 1250px) {
        flex-direction: column;
      }
    }

    &.justify-start {
      justify-content: flex-start;
    }

    &.justify-center {
      justify-content: center;
    }

    &.justify-end {
      justify-content: flex-end;
    }

    &.justify-space-between {
      justify-content: space-between;
    }

    &.justify-space-around {
      justify-content: space-around;
    }

    &.justify-space-evenly {
      justify-content: space-evenly;
    }

    &.grow {
      flex-grow: 1;
    }

    &.wrap {
      flex-wrap: wrap;
    }
  }
</style>
