---
import type { Base, Spacing } from "../types";

type ScreenSize = "sm" | "md" | "lg" | "xl";

export interface GroupProps extends Base {
  gap?: Spacing;
  grow?: boolean;
  justify?:
    | "start"
    | "center"
    | "end"
    | "space-between"
    | "space-around"
    | "space-evenly";
  not?: ScreenSize | ScreenSize[];
  wrap?: boolean;
}

const {
  class: className,
  justify = "start",
  gap = "md",
  grow = false,
  wrap = false,
  not,
} = Astro.props as GroupProps;
const gapValue = `var(--naut-spacing-${gap})`;
const notScreens = typeof not === "string" ? [not] : not;
---

<div
  class:list={[
  "naut-group",
  grow && "grow",
  wrap && "wrap",
  notScreens?.map((s) => `not-${s}`).join(" "),
  className]}
>
  <slot />
</div>

<style define:vars={{ justify, gap: gapValue }}>
  .naut-group {
    display: inline-flex;
    gap: var(--gap);
    align-items: center;
    justify-content: var(--justify);

    &.not-sm {
      @media only screen and (max-width: 817px) {
        flex-direction: column;
      }
    }

    &.not-md {
      @media only screen and (min-width: 818px) and (min-width: 1041px) {
        flex-direction: column;
      }
    }

    &.not-lg {
      @media only screen and (min-width: 1042px) and (min-width: 1249px) {
        flex-direction: column;
      }
    }

    &.not-xl {
      @media only screen and (min-width: 1250px) {
        flex-direction: column;
      }
    }

    &.grow {
      flex-grow: 1;
    }

    &.wrap {
      flex-wrap: wrap;
    }
  }
</style>
