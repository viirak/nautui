---
import type { Base } from "../types";
import "../styles/radius.css";
import "../styles/shadow.css";
import type { ButtonProps } from "./Button.astro";
import Button from "./Button.astro";

type ToggleButtonProps = Omit<ButtonProps, "onclick">;
type DropdownAlign = "start" | "center" | "end";
type DropdownSide = "top" | "bottom" | "left" | "right";
type DropdownOffset = "xs" | "sm" | "md" | "lg";

export interface DropdownProps extends Base {
  align?: DropdownAlign;
  button?: ToggleButtonProps;
  hover?: boolean;
  offset?: DropdownOffset;
  side?: DropdownSide;
  zi?: number;
}

const {
  class: className,
  button,
  align = "start",
  side = "bottom",
  hover = false,
  offset,
  zi = 100,
  ...rest
} = Astro.props as DropdownProps;

const offsetValue = offset ? `var(--naut-spacing-${offset})` : "0px";
---

<details
  class:list={[
    "naut-dropdown",
    hover && "hoverable",
    className,
  ]}
  {...rest}
>
  <summary class="naut-dropdown__trigger">
    {button ? (
      <Button square variant="ghost" {...button} />
    ) : (
      <slot name="trigger" />
    )}
  </summary>
  <div
    class:list={["naut-dropdown__content", `side--${side}`, `align--${align}`]}
  >
    <slot />
  </div>
</details>
<script>
  // Close any open dropdown when clicking outside of it
  document.addEventListener("pointerdown", (event) => {
    const target = event.target as Node;
    for (const dropdown of Array.from(
      document.querySelectorAll<HTMLDetailsElement>(
        "details.naut-dropdown[open]"
      )
    )) {
      if (!dropdown.contains(target)) {
        dropdown.removeAttribute("open");
      }
    }
  });
</script>
<script>
  // Fade/scale driven entirely by WAAPI with fill:"forwards". The specified CSS
  // value is always opacity 0, so no engine quirk (Firefox skips rendering of
  // closed <details> children and repaints them unpredictably) can flash an
  // unanimated bright frame. Animations are scheduled via rAF so they exist
  // before the affected frame paints.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const KEYFRAME_IN = [
    { opacity: 0, scale: "0.96" },
    { opacity: 1, scale: "1" },
  ];
  const KEYFRAME_OUT = [
    { opacity: 1, scale: "1" },
    { opacity: 0, scale: "0.96" },
  ];

  function play(content: HTMLElement, keyframes: Keyframe[], duration: number) {
    // Cancel finished/stale animations FIRST (a completed fade-in holds
    // opacity:1 via fill:forwards forever; if Firefox repaints the subtree
    // before this rAF callback runs, that stale value is what flashes).
    // Cancel + create happen in the same tick, so nothing can leak through.
    for (const animation of content.getAnimations()) {
      animation.cancel();
    }
    content.animate(keyframes, {
      duration,
      easing: "ease",
      fill: "forwards",
    });
  }

  // Click mode: toggle via <summary>. Hover triggers are excluded — their
  // open state is managed by the pointerenter/pointerleave block below.
  for (const summary of Array.from(
    document.querySelectorAll<HTMLElement>(
      "details.naut-dropdown:not(.hoverable) > summary"
    )
  )) {
    const dropdown = summary.parentElement as HTMLDetailsElement;
    const content = dropdown.querySelector<HTMLElement>(
      ".naut-dropdown__content"
    );
    if (!content || reducedMotion.matches) continue;

    summary.addEventListener("click", () => {
      const opening = !dropdown.open;
      requestAnimationFrame(() => {
        play(
          content,
          opening ? KEYFRAME_IN : KEYFRAME_OUT,
          opening ? 200 : 150
        );
      });
    });
  }

  // Hover mode: engines like Firefox do not render children of a CLOSED
  // <details> at all, so :hover alone can never show anything there. Drive
  // the [open] attribute on enter/leave instead; the fade still attaches
  // pre-paint via rAF. Reduced motion keeps the attribute toggle (rendering
  // requirement) and only skips the animation.
  for (const dropdown of Array.from(
    document.querySelectorAll<HTMLDetailsElement>(
      "details.naut-dropdown.hoverable"
    )
  )) {
    const content = dropdown.querySelector<HTMLElement>(
      ".naut-dropdown__content"
    );
    if (!content) continue;

    // Hover-intent grace period: crossing the offset gap between trigger and
    // content briefly exits the <details> element. Delay the close and cancel
    // it if the pointer reaches the content (a DOM child, so :hover still
    // holds while over it).
    let closeTimer = 0;
    let closing = false;

    dropdown.addEventListener("pointerenter", () => {
      window.clearTimeout(closeTimer);
      // Already fully visible (re-entering across the offset gap while the
      // grace timer is pending)? Leave it alone — replaying the fade-in would
      // yank a visible dropdown back to opacity 0 and read as a blink.
      if (!closing && dropdown.open) return;
      closing = false;
      requestAnimationFrame(() => {
        if (!dropdown.open) {
          dropdown.setAttribute("open", "");
        }
        if (!reducedMotion.matches) {
          play(content, KEYFRAME_IN, 200);
        }
      });
    });

    dropdown.addEventListener("pointerleave", () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (dropdown.matches(":hover")) return;
        closing = true;
        requestAnimationFrame(() => {
          if (!reducedMotion.matches) {
            play(content, KEYFRAME_OUT, 150);
          }
          window.setTimeout(() => {
            if (!dropdown.matches(":hover") && dropdown.open) {
              dropdown.removeAttribute("open");
            }
          }, 160);
        });
      }, 150);
    });
  }
</script>

<style
  define:vars={{ nautDropdownZIndex: zi, nautDropdownOffset: offsetValue }}
>
  .naut-dropdown {
    position: relative;
    display: inline-block;

    .naut-dropdown__trigger {
      display: inline-flex;
      cursor: pointer;
      list-style: none;
    }

    .naut-dropdown__content {
      position: absolute;
      z-index: var(--nautDropdownZIndex);
      visibility: hidden;
      min-width: 15rem;
      padding: var(--naut-spacing-xs);
      /* Keep the content rendered while <details> is closed (overrides the UA's
                                           content-visibility: hidden) so transitions can animate on open/close */
      content-visibility: visible;
      background: var(--naut-color-base);
      border: 1px solid var(--naut-color-border);
      border-radius: var(--naut-border-radius-md);
      box-shadow: var(--naut-shadow-md);
      opacity: 0;
      scale: 0.96;
      transition:
        opacity 0.2s ease,
        scale 0.2s ease,
        visibility 0.2s;

      /* side: which direction the content opens */
      &.side--top {
        right: auto;
        bottom: calc(100% + var(--nautDropdownOffset));
        left: 0;
        transform-origin: bottom;
      }

      &.side--bottom {
        top: calc(100% + var(--nautDropdownOffset));
        right: auto;
        left: 0;
        transform-origin: top;
      }

      &.side--left {
        top: 0;
        right: calc(100% + var(--nautDropdownOffset));
        bottom: auto;
        left: auto;
        transform-origin: right;
      }

      &.side--right {
        top: 0;
        right: auto;
        bottom: auto;
        left: calc(100% + var(--nautDropdownOffset));
        transform-origin: left;
      }

      /* align: horizontal alignment (for top/bottom) */
      &.align--center {
        left: 50%;
        transform: translateX(-50%);
      }

      &.align--end {
        right: 0;
        left: auto;
      }
    }

    /* Click mode: held at 0; the script drives opacity/scale via WAAPI */
    &[open]:not(.hoverable) .naut-dropdown__content {
      visibility: visible;
      opacity: 0;
      scale: 0.96;
      transition: visibility 0.2s;
    }

    /* Hover mode: open == fully visible. JS manages [open] on enter/leave,
             so crossing the offset gap (where :hover drops) cannot dim the content:
             [open] alone keeps it opaque until the grace-period close runs. */
    &.hoverable[open] .naut-dropdown__content,
    &.hoverable:hover .naut-dropdown__content {
      visibility: visible;
      opacity: 1;
      scale: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      &[open] .naut-dropdown__content {
        opacity: 1;
        scale: 1;
      }
    }
  }
</style>
