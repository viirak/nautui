---
import { createMargin, createPadding } from "../lib/spacing";
import type { Base, Spacing, SpacingProps } from "../types";

export interface MarqueeProps extends Base, SpacingProps {
  duration?: number;
  fadeEdgeColor?: string;
  fadeEdgeSize?: string;
  fadeEdges?: boolean;
  gap?: Spacing | string;
  orientation?: "horizontal" | "vertical";
  pauseOnHover?: boolean;
  repeat?: number;
  reverse?: boolean;
}

const spacingValues = new Set(["0", "sm", "md", "lg", "xl", "xxl"]);

function resolveGap(gap: Spacing | string): string {
  if (spacingValues.has(gap)) {
    return gap === "0" ? "0" : `var(--naut-spacing-${gap})`;
  }
  return gap;
}

const {
  class: className,
  duration = 40_000,
  gap = "md",
  reverse = false,
  repeat = 4,
  pauseOnHover = false,
  orientation = "horizontal",
  fadeEdges = true,
  fadeEdgeColor = "var(--naut-color-base)",
  fadeEdgeSize = "5%",
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as MarqueeProps;

const safeDuration = Math.max(1, duration);
const safeRepeat = Math.max(2, Math.floor(repeat));
const marqueeGap = resolveGap(gap);
const padding = createPadding("marquee", { p, px, py, pt, pr, pb, pl });
const margin = createMargin("marquee", { m, mx, my, mt, mr, mb, ml });
---

<div
  class:list={[
    "naut-marquee",
    `orientation-${orientation}`,
    reverse && "reverse",
    pauseOnHover && "pause-on-hover",
    !fadeEdges && "no-fade",
    className,
  ]}
  {...rest}
>
  <div class="naut-marquee-track">
    {Array.from({ length: safeRepeat }).map(() => (
        <div class="naut-marquee-group"><slot /></div>
      ))}
  </div>
</div>

<style
  define:vars={{
    safeDuration,
    safeRepeat,
    marqueeGap,
    fadeEdgeColor,
    fadeEdgeSize,
    ...padding,
    ...margin,
  }}
>
  .naut-marquee {
    position: relative;
    display: block;
    padding-top: var(--marqueePaddingTop);
    padding-right: var(--marqueePaddingRight);
    padding-bottom: var(--marqueePaddingBottom);
    padding-left: var(--marqueePaddingLeft);
    margin-top: var(--marqueeMarginTop);
    margin-right: var(--marqueeMarginRight);
    margin-bottom: var(--marqueeMarginBottom);
    margin-left: var(--marqueeMarginLeft);
    overflow: hidden;
  }

  .naut-marquee-track {
    display: flex;
    width: max-content;
    animation: scroll-x calc(var(--safeDuration) * 1ms) linear infinite;
    will-change: transform;
  }

  .naut-marquee-group {
    display: flex;
    flex-shrink: 0;
    gap: var(--marqueeGap);
    align-items: center;
    min-width: max-content;
  }

  .naut-marquee.orientation-vertical .naut-marquee-track {
    flex-direction: column;
    height: max-content;
    animation-name: scroll-y;
  }

  .naut-marquee.orientation-vertical .naut-marquee-group {
    flex-direction: column;
    min-height: max-content;
  }

  .naut-marquee.reverse .naut-marquee-track {
    animation-direction: reverse;
  }

  .naut-marquee.pause-on-hover:hover .naut-marquee-track {
    animation-play-state: paused;
  }

  .naut-marquee:not(.no-fade)::before,
  .naut-marquee:not(.no-fade)::after {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    content: "";
  }

  .naut-marquee.orientation-horizontal:not(.no-fade)::before {
    top: 0;
    left: 0;
    width: var(--fadeEdgeSize);
    height: 100%;
    background: linear-gradient(to right, var(--fadeEdgeColor), transparent);
  }

  .naut-marquee.orientation-horizontal:not(.no-fade)::after {
    top: 0;
    right: 0;
    width: var(--fadeEdgeSize);
    height: 100%;
    background: linear-gradient(to left, var(--fadeEdgeColor), transparent);
  }

  .naut-marquee.orientation-vertical:not(.no-fade)::before {
    top: 0;
    left: 0;
    width: 100%;
    height: var(--fadeEdgeSize);
    background: linear-gradient(to bottom, var(--fadeEdgeColor), transparent);
  }

  .naut-marquee.orientation-vertical:not(.no-fade)::after {
    bottom: 0;
    left: 0;
    width: 100%;
    height: var(--fadeEdgeSize);
    background: linear-gradient(to top, var(--fadeEdgeColor), transparent);
  }

  @keyframes scroll-x {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-100% / var(--safeRepeat)), 0, 0);
    }
  }

  @keyframes scroll-y {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, calc(-100% / var(--safeRepeat)), 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .naut-marquee-track {
      animation-duration: 1ms;
      animation-iteration-count: 1;
    }
  }
</style>
