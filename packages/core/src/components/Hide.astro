---
export interface HideProps {
  class?: string;
  on?: "sm" | "md" | "lg" | "xl";
}

const { class: className, on, ...rest } = Astro.props as HideProps;
---

<div class:list={["naut-hide", on && `naut-hide--${on}`, className]} {...rest}>
  <slot />
</div>

<style>
  .naut-hide--sm {
    @media (max-width: 576px) {
      display: none !important;
    }
  }

  .naut-hide--md {
    @media (min-width: 818px) and (max-width: 1041px) {
      display: none !important;
    }
  }

  .naut-hide--lg {
    @media (min-width: 1042px) and (max-width: 1249px) {
      display: none !important;
    }
  }

  .naut-hide--xl {
    @media (min-width: 1250px) {
      display: none !important;
    }
  }
</style>
