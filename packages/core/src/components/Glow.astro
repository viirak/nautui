---
import type { Base } from "../types";

export interface GlowProps extends Base {
  blur?: string;
  color?: string;
  gradient?: { colors: string[]; deg?: number };
  height?: string;
  opacity?: number;
  position?: {
    bottom?: string;
    left?: string;
    right?: string;
    top?: string;
  };
  width?: string;
}

const {
  class: className,
  color,
  gradient,
  blur = "100px",
  opacity = 0.5,
  width = "400px",
  height = "400px",
  position = { top: "0", left: "0" },
  ...rest
} = Astro.props as GlowProps;

const background = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : color || "var(--naut-color-primary)";

const top = position.top ?? "auto";
const left = position.left ?? "auto";
const right = position.right ?? "auto";
const bottom = position.bottom ?? "auto";
---

<div class:list={["naut-glow", className]} aria-hidden="true" {...rest}></div>

<style
  define:vars={{ background, blur, opacity, width, height, top, left, right, bottom }}
>
  .naut-glow {
    position: absolute;
    top: var(--top);
    right: var(--right);
    bottom: var(--bottom);
    left: var(--left);
    z-index: 0;
    width: var(--width);
    height: var(--height);
    pointer-events: none;
    background: var(--background);
    border-radius: 50%;
    opacity: var(--opacity);
    filter: blur(var(--blur));
  }
</style>
