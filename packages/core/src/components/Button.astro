---
import {
  getPaddingClassList,
  type Padding,
  type Spacing,
} from "../lib/spacing";
import type { Base, Radius, Size } from "../types";
import "../styles/spacing/padding.css";

type ButtonVariant =
  | "default"
  | "primary"
  | "secondary"
  | "destructive"
  | "success"
  | "warning"
  | "info"
  | "outline"
  | "outline-primary"
  | "outline-secondary"
  | "flat"
  | "ghost"
  | "link"
  | "rainbow";
type ButtonRadius = Omit<Radius, "xl"> | "none" | "full";
type ButtonType = "button" | "submit" | "reset";

export interface ButtonProps extends Base {
  border?: Size | "none";
  color?: string;
  dark?: boolean;
  href?: string;
  padding?: Spacing | Padding;
  rounded?: ButtonRadius;
  size?: Size;
  square?: boolean;
  type?: ButtonType;
  variant?: ButtonVariant;
}

const {
  href,
  class: className,
  size = "md",
  type = "button",
  variant = "default",
  color: colorProp,
  rounded = "md",
  border = "md",
  dark = false,
  square = false,
  padding: paddingProp,
  ...rest
} = Astro.props as ButtonProps;

const shorthandColor: Record<string, string> = {
  primary: "primary",
  secondary: "secondary",
  destructive: "destructive",
  success: "success",
  warning: "warning",
  info: "info",
};
const resolvedColor = colorProp ?? shorthandColor[variant];
let resolvedVariant: string;
if (variant in shorthandColor) {
  resolvedVariant = "filled";
} else if (variant.startsWith("outline-")) {
  resolvedVariant = "outline";
} else {
  resolvedVariant = variant;
}

let paddingClasses: string[] = [];
if (paddingProp) {
  paddingClasses = getPaddingClassList(paddingProp);
} else if (!square) {
  if (size === "sm") paddingClasses = ["p-xs"];
  else if (size === "md") paddingClasses = ["p-sm"];
  else paddingClasses = ["p-md"];
}

const classlist = [
  "naut-button",
  `size-${size}`,
  `variant-${resolvedVariant}`,
  resolvedColor ? `color-${resolvedColor}` : "color-primary",
  `rounded-${rounded}`,
  `border-${border}`,
  dark && "dark",
  square && "square",
  ...paddingClasses,
  className,
];
---

{href && <a href={href} class:list={classlist} {...rest}><slot /></a>}
{!href && <button class:list={classlist} type={type} {...rest}><slot /></button>}

<style>
  .naut-button {
    position: relative;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;

    /* Size */
    height: 2.5rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5rem;

    /* Variant default */
    color: var(--naut-color-content);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    background: var(--naut-color-base-100);
    border-color: var(--naut-color-base-300);
    border-style: solid;
    border-width: 0.063rem;
    border-radius: 0.5rem;
    box-shadow: 1px 1px 2px 0.5px rgb(from #000 r g b / 0.1);
    transition-duration: 0.1s;
    transition-property:
      background-color, border-color, box-shadow, color, opacity, transform;

    &:hover:not(:disabled) {
      background: var(--naut-color-base-200);
    }

    &:active:not(:disabled) {
      transform: translateY(0.0625rem);
      transition-duration: 0;
    }

    &.variant-primary {
      color: var(--naut-color-primary-content);
      background: var(--naut-color-primary);
      border-color: var(--naut-color-primary);

      &:hover:not(:disabled) {
        background: color-mix(in oklch, var(--naut-color-primary), white 35%);
      }
    }

    &.variant-secondary {
      color: var(--naut-color-secondary-content);
      background: var(--naut-color-secondary);
      border-color: var(--naut-color-secondary);

      &:hover:not(:disabled) {
        background: color-mix(in oklch, var(--naut-color-secondary), white 35%);
      }
    }

    &.variant-destructive {
      color: var(--naut-color-destructive-content);
      background: var(--naut-color-destructive);
      border-color: var(--naut-color-destructive);

      &:hover:not(:disabled) {
        background: color-mix(
          in oklch,
          var(--naut-color-destructive),
          white 25%
        );
      }
    }

    &.variant-outline,
    &.variant-outline-primary,
    &.variant-outline-secondary {
      color: var(--naut-color-content);
      background: transparent;
      border-color: var(--naut-color-border-strong);
    }

    &.variant-outline:hover:not(:disabled) {
      background: var(--naut-color-base-200);
    }

    &.variant-outline-primary {
      border-color: var(--naut-color-primary);

      &:hover:not(:disabled) {
        background: rgb(from var(--naut-color-primary) r g b / 0.15);
      }
    }

    &.variant-outline-secondary {
      border-color: var(--naut-color-secondary);

      &:hover:not(:disabled) {
        background: rgb(from var(--naut-color-secondary) r g b / 0.15);
      }
    }

    /* Color overrides via color prop */
    &.color-primary {
      color: var(--naut-color-primary-content);
      background: var(--naut-color-primary);
      border-color: var(--naut-color-primary);
    }
    &.color-secondary {
      color: var(--naut-color-secondary-content);
      background: var(--naut-color-secondary);
      border-color: var(--naut-color-secondary);
    }
    &.color-destructive {
      color: var(--naut-color-destructive-content);
      background: var(--naut-color-destructive);
      border-color: var(--naut-color-destructive);
    }
    &.color-success {
      color: var(--naut-color-success-content);
      background: var(--naut-color-success);
      border-color: var(--naut-color-success);
    }
    &.color-warning {
      color: var(--naut-color-warning-content);
      background: var(--naut-color-warning);
      border-color: var(--naut-color-warning);
      &:hover:not(:disabled) {
        background: color-mix(in oklch, var(--naut-color-warning), white 35%);
      }
    }
    &.color-info {
      color: var(--naut-color-info-content);
      background: var(--naut-color-info);
      border-color: var(--naut-color-info);
    }

    &.variant-flat {
      background: var(--naut-color-base-100);
      border-color: transparent;
      box-shadow: none;
    }

    &.variant-ghost {
      background: transparent;
      border: none;
      box-shadow: none;
    }

    &.variant-link {
      color: var(--naut-color-primary);
      background: transparent;
      border-color: transparent;
      box-shadow: none;

      &:hover:not(:disabled) {
        text-decoration: underline;
        background: transparent;
      }
    }

    &.variant-rainbow {
      --naut-rainbow-conic-gradient: conic-gradient(
        from 0turn,
        hsl(110 90% 50%),
        hsl(210 90% 60%),
        hsl(220 70% 60%),
        hsl(30 70% 60%),
        hsl(100 90% 50%)
      );
      background:
        linear-gradient(var(--naut-color-base), var(--naut-color-base-100))
        padding-box,
        var(--naut-rainbow-conic-gradient) border-box;
      border-color: transparent;
      &:hover:not(:disabled) {
        background:
          linear-gradient(var(--naut-color-base), var(--naut-color-base-200))
          padding-box,
          var(--naut-rainbow-conic-gradient) border-box;
      }
    }

    &:disabled {
      color: rgb(from var(--naut-color-content-soft) r g b / 0.3);
      pointer-events: none;
      background: rgb(from var(--naut-color-base-100) r g b / 0.7);
      border-color: rgb(from var(--naut-color-border) r g b / 0.1);
      box-shadow: none;
    }

    /* Border thickness */

    &.border-none {
      border: none;
    }

    &.border-sm {
      border-width: var(--naut-border-width-sm);
    }

    &.border-md {
      border-width: var(--naut-border-width-md);
    }

    &.border-lg {
      border-width: var(--naut-border-width-lg);
    }

    &.border-xl {
      border-width: var(--naut-border-width-xl);
    }

    /* Border Radius */

    &.rounded-none {
      border-radius: 0;
    }

    &.rounded-sm {
      border-radius: var(--naut-border-radius-sm);
    }

    &.rounded-md {
      border-radius: var(--naut-border-radius-md);
    }

    &.rounded-lg {
      border-radius: var(--naut-border-radius-lg);
    }

    &.rounded-full {
      border-radius: 9999px;
    }

    /* SVG icons */
    :global(svg) {
      width: 1.2815rem;
      height: 1.2815rem;
    }

    /* Sizes */
    &.size-sm {
      height: 2rem;
      font-size: 0.8rem;

      :global(svg) {
        width: 1.125rem;
        height: 1.125rem;
      }
    }

    &.size-lg {
      height: 3rem;
      font-size: calc(var(--naut-font-size) * 1.125);

      :global(svg) {
        width: 1.75rem;
        height: 1.75rem;
      }
    }

    &.square {
      aspect-ratio: 1;
    }
  }
</style>
