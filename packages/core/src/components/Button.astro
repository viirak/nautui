---
import { getColorValue } from "../lib/color";
import { getPillPadding, type SpacingStep } from "../lib/spacing";
import type { Base, Color, Radius, Size } from "../types";

type ButtonVariant =
  | "default"
  | "primary"
  | "secondary"
  | "destructive"
  | "success"
  | "warning"
  | "info"
  | "outline"
  | "outline-primary"
  | "outline-secondary"
  | "flat"
  | "ghost"
  | "link"
  | "rainbow";
type ButtonRadius = Exclude<Radius, "xl"> | "none" | "full";
type ButtonType = "button" | "submit" | "reset";

export interface ButtonProps extends Base {
  border?: Size | "none";
  color?: Color;
  dark?: boolean;
  href?: string;
  /** Not supported — wrap in a `Box`. */
  margin?: never;
  /**
   * One spacing step, not an axis object: a button's silhouette depends on
   * inline padding exceeding block padding, so the component derives both axes
   * itself (see `getPillPadding`).
   */
  padding?: SpacingStep;
  radius?: ButtonRadius;
  rounded?: ButtonRadius;
  size?: Size;
  square?: boolean;
  type?: ButtonType;
  variant?: ButtonVariant;
}

const {
  href,
  class: className,
  size = "md",
  type = "button",
  variant = "default",
  color: colorProp,
  radius,
  rounded,
  border = "md",
  dark = false,
  square = false,
  padding: paddingProp,
  margin,
  ...rest
} = Astro.props as ButtonProps;

if (margin !== undefined) {
  throw new TypeError(
    "Button: `margin` is not supported. Wrap the button in a `Box`, or pass a spacing utility class."
  );
}

const colorValue = getColorValue(colorProp);
const resolvedVariant = variant;
const resolvedRadius = radius ?? rounded ?? "md";

// Fixed rem rather than --naut-spacing-*: a control's internal padding
// belongs to its silhouette and has to track the box, not the viewport.
// The spacing tokens grow ~2.4x faster than the height clamps, which
// pushed an `xl` button to 94px against a 56px target. Each pair keeps
// inline > block so the pill ratio still reads.
const sizePadding: Record<
  NonNullable<ButtonProps["size"]>,
  { x: string; y: string }
> = {
  lg: { x: "1rem", y: "0.625rem" },
  md: { x: "0.875rem", y: "0.5rem" },
  sm: { x: "0.75rem", y: "0.375rem" },
  xl: { x: "1.125rem", y: "0.75rem" },
};
// A 1:1 button carries no padding at all — the icon owns the box. This is the
// opt-out from the pill ratio, and it satisfies `y == x` trivially (0 == 0).
// An explicit `padding` still resolves against the fluid tokens.
let pad = sizePadding[size];
if (square) {
  pad = { x: "0px", y: "0px" };
} else if (paddingProp) {
  pad = getPillPadding(paddingProp);
}
const padX = pad.x;
const padY = pad.y;

const classlist = [
  "naut-button",
  `size-${size}`,
  `variant-${resolvedVariant}`,
  colorValue && "color--custom",
  `radius-${resolvedRadius}`,
  `border-${border}`,
  dark && "dark",
  square && "square",
  className,
];
---

{href && (
  <a class:list={classlist} href={href} {...rest}>
    <slot />
  </a>
)}
{!href && (
  <button class:list={classlist} type={type} {...rest}>
    <slot />
  </button>
)}

<style define:vars={{ colorValue: colorValue ?? "", padX, padY }}>
  .naut-button {
    position: relative;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;

    /* Size — fluid, because the padding below is fluid, since an explicit `padding` resolves
                              * against --naut-spacing-*, which is itself a clamp. min-height, not
                              * height: that padding scales independently of this box, so a hard
                              * height eventually has less room than its own line box and the label
                              * spills past the border. min-height lets the box grow instead of
                              * clipping. Each floor is the old fixed value, so nothing shifts on
                              * small screens and no target drops below the 24px WCAG 2.5.8 floor. */
    min-height: clamp(2.5rem, 2.35rem + 0.75vw, 2.75rem);
    padding-block: var(--padY);
    padding-inline: var(--padX);
    font-family: inherit;
    font-size: clamp(0.875rem, 0.85rem + 0.125vw, 0.9375rem);
    font-weight: 400;
    /* Unitless so it tracks the font-size above. A fixed rem here reads as
                                                     * 1.88 at `sm` and 1.2 at `xl` — four sizes, one declared value. */
    line-height: var(--naut-line-height-ratio);

    /* Variant default */
    color: var(--naut-color-content);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    background: var(--naut-color-base-100);
    border-color: var(--naut-color-base-300);
    border-style: solid;
    border-width: 0.063rem;
    border-radius: 0.5rem;
    box-shadow: 1px 1px 2px 0.5px rgb(from #000 r g b / 0.1);
    transition-duration: 0.1s;
    transition-property:
      background-color, border-color, box-shadow, color, opacity, transform;

    &:hover:not(:disabled) {
      background: var(--naut-color-base-200);
    }

    &:active:not(:disabled) {
      transform: translateY(0.0625rem);
      transition-duration: 0;
    }

    &.variant-primary {
      color: var(--naut-color-primary-content);
      background: var(--naut-color-primary-fill);
      border-color: var(--naut-color-primary-fill);

      &:hover:not(:disabled) {
        background: var(--naut-color-primary-hover);
      }
    }

    &.variant-secondary {
      color: var(--naut-color-secondary-content);
      background: var(--naut-color-secondary-fill);
      border-color: var(--naut-color-secondary-fill);

      &:hover:not(:disabled) {
        background: var(--naut-color-secondary-hover);
      }
    }

    &.variant-destructive {
      color: var(--naut-color-destructive-content);
      background: var(--naut-color-destructive);
      border-color: var(--naut-color-destructive);

      &:hover:not(:disabled) {
        background: color-mix(
          in oklch,
          var(--naut-color-destructive),
          white 25%
        );
      }
    }

    &.variant-success {
      color: var(--naut-color-success-content);
      background: var(--naut-color-success-fill);
      border-color: var(--naut-color-success-fill);

      &:hover:not(:disabled) {
        background: var(--naut-color-success-hover);
      }
    }

    &.variant-warning {
      color: var(--naut-color-warning-content);
      background: var(--naut-color-warning-fill);
      border-color: var(--naut-color-warning-fill);

      &:hover:not(:disabled) {
        background: var(--naut-color-warning-hover);
      }
    }

    &.variant-info {
      color: var(--naut-color-info-content);
      background: var(--naut-color-info-fill);
      border-color: var(--naut-color-info-fill);

      &:hover:not(:disabled) {
        background: var(--naut-color-info-hover);
      }
    }

    &.variant-outline,
    &.variant-outline-primary,
    &.variant-outline-secondary {
      color: var(--naut-color-content);
      background: transparent;
      border-color: var(--naut-color-border-strong);
    }

    &.variant-outline:hover:not(:disabled) {
      background: var(--naut-color-base-200);
    }

    &.variant-outline-primary {
      border-color: var(--naut-color-primary-fill);

      &:hover:not(:disabled) {
        background: rgb(from var(--naut-color-primary-fill) r g b / 0.15);
      }
    }

    &.variant-outline-secondary {
      border-color: var(--naut-color-secondary-fill);

      &:hover:not(:disabled) {
        background: rgb(from var(--naut-color-secondary-fill) r g b / 0.15);
      }
    }

    &.variant-flat {
      background: var(--naut-color-base-100);
      border-color: transparent;
      box-shadow: none;
    }

    &.variant-ghost {
      background: transparent;
      border: none;
      box-shadow: none;
    }

    &.variant-link {
      color: var(--naut-color-primary-text);
      background: transparent;
      border-color: transparent;
      box-shadow: none;

      &:hover:not(:disabled) {
        text-decoration: underline;
        background: transparent;
      }
    }

    &.variant-rainbow {
      --naut-rainbow-conic-gradient: conic-gradient(
        from 0turn,
        hsl(110 90% 50%),
        hsl(210 90% 60%),
        hsl(220 70% 60%),
        hsl(30 70% 60%),
        hsl(100 90% 50%)
      );
      background:
        linear-gradient(var(--naut-color-base), var(--naut-color-base-100))
        padding-box,
        var(--naut-rainbow-conic-gradient) border-box;
      border-color: transparent;
      &:hover:not(:disabled) {
        background:
          linear-gradient(var(--naut-color-base), var(--naut-color-base-200))
          padding-box,
          var(--naut-rainbow-conic-gradient) border-box;
      }
    }

    &.color--custom {
      color: var(--colorValue);
    }

    &:disabled {
      color: rgb(from var(--naut-color-content-soft) r g b / 0.3);
      pointer-events: none;
      background: rgb(from var(--naut-color-base-100) r g b / 0.7);
      border-color: rgb(from var(--naut-color-border) r g b / 0.1);
      box-shadow: none;
    }

    /* Border thickness */

    &.border-none {
      border: none;
    }

    &.border-sm {
      border-width: var(--naut-border-width-sm);
    }

    &.border-md {
      border-width: var(--naut-border-width-md);
    }

    &.border-lg {
      border-width: var(--naut-border-width-lg);
    }

    &.border-xl {
      border-width: var(--naut-border-width-xl);
    }

    /* Border Radius */

    &.radius-none {
      border-radius: 0;
    }

    &.radius-sm {
      border-radius: var(--naut-border-radius-sm);
    }

    &.radius-md {
      border-radius: var(--naut-border-radius-md);
    }

    &.radius-lg {
      border-radius: var(--naut-border-radius-lg);
    }

    &.radius-full {
      border-radius: 9999px;
    }

    /* SVG icons — fluid for the same reason as the box, so the icon keeps
                                 * its proportion to the button instead of shrinking inside it. */
    :global(svg) {
      width: clamp(1.2815rem, 1.23rem + 0.25vw, 1.375rem);
      height: clamp(1.2815rem, 1.23rem + 0.25vw, 1.375rem);
    }

    /* Sizes */
    &.size-sm {
      min-height: clamp(2rem, 1.9rem + 0.5vw, 2.25rem);
      font-size: clamp(0.8rem, 0.78rem + 0.1vw, 0.875rem);

      :global(svg) {
        width: clamp(1.125rem, 1.08rem + 0.2vw, 1.2rem);
        height: clamp(1.125rem, 1.08rem + 0.2vw, 1.2rem);
      }
    }

    &.size-lg {
      min-height: clamp(3rem, 2.8rem + 1vw, 3.25rem);
      font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);

      :global(svg) {
        width: clamp(1.75rem, 1.65rem + 0.5vw, 1.875rem);
        height: clamp(1.75rem, 1.65rem + 0.5vw, 1.875rem);
      }
    }

    &.size-xl {
      min-height: clamp(3.5rem, 3.2rem + 1.5vw, 3.875rem);
      font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.375rem);

      :global(svg) {
        width: clamp(2.125rem, 1.95rem + 0.875vw, 2.25rem);
        height: clamp(2.125rem, 1.95rem + 0.875vw, 2.25rem);
      }
    }

    &.square {
      aspect-ratio: 1;
    }
  }
</style>
