---
import "../styles/article.css";
import { uid } from "../lib/uid";
import type { Base } from "../types";

export interface ArticleProps extends Base {
  anchorLinks?: boolean;
}

const {
  class: className,
  anchorLinks = false,
  ...rest
} = Astro.props as ArticleProps;
const articleId = uid("naut-article");
---

<article
  id={anchorLinks ? articleId : undefined}
  class:list={["naut-article", anchorLinks && "anchor-links", className]}
  {...rest}
>
  <slot />
</article>

<script is:inline define:vars={{ articleId, anchorLinks }}>
  if (anchorLinks) {
    const article = document.getElementById(articleId);
    if (article) {
      for (const heading of article.querySelectorAll("h2, h3, h4, h5, h6")) {
        const id = heading.id;
        if (!id) continue;

        const link = document.createElement("a");
        link.className = "naut-heading-link";
        link.href = `#${id}`;
        link.setAttribute("aria-label", `Link to ${heading.textContent || ""}`);
        link.textContent = "#";
        heading.appendChild(link);

        link.addEventListener("click", (e) => {
          e.preventDefault();
          const url = `${window.location.origin}${window.location.pathname}#${id}`;
          navigator.clipboard.writeText(url).catch(() => {});
          history.pushState(null, "", `#${id}`);
          heading.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }
    }
  }
</script>
