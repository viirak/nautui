---
import type { Base } from "../types";

export interface MenuItemProps extends Base {
  active?: boolean;
  color?: "default" | "primary" | "destructive";
  href?: string;
  type?: "button" | "submit" | "reset";
}

const {
  class: className,
  active = false,
  href,
  type = "button",
  color = "default",
  ...rest
} = Astro.props as MenuItemProps;

const classList = [
  "naut-menu-item",
  active && "active",
  `color-${color}`,
  className,
];
---

<li>
  {href ? (
    <a href={href} class:list={classList} {...rest}>
      <span class="naut-menu-item--left"><slot name="leftSection" /></span>
      <span class="naut-menu-item--label"><slot /></span>
      <span class="naut-menu-item--right"><slot name="rightSection" /></span>
    </a>
  ) : (
    <button class:list={classList} type={type} {...rest}>
      <span class="naut-menu-item--left"><slot name="leftSection" /></span>
      <span class="naut-menu-item--label"><slot /></span>
      <span class="naut-menu-item--right"><slot name="rightSection" /></span>
    </button>
  )}
</li>

<style>
  li {
    width: 100%;
  }

  .naut-menu-item {
    display: flex;
    align-items: center;
    width: 100%;
    padding: var(--naut-spacing-xs) var(--naut-spacing-sm);
    font-family: inherit;
    font-size: var(--naut-font-size-sm);
    font-weight: 500;
    line-height: 1.5;
    color: var(--naut-color-text);
    text-decoration: none;
    cursor: pointer;
    background: transparent;
    border: none;
    border-radius: var(--naut-border-radius-sm);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;

    &:hover {
      background-color: color-mix(in oklch, var(--naut-color-surface), black 5%);
    }

    &.active {
      color: var(--naut-color-primary);
      background-color: rgb(from var(--naut-color-primary) r g b / 0.1);
    }

    &.color-destructive {
      color: var(--naut-color-destructive);
      &:hover {
        background-color: rgb(from var(--naut-color-destructive) r g b / 0.1);
      }
      &.active {
        background-color: rgb(from var(--naut-color-destructive) r g b / 0.15);
      }
    }

    &.color-primary {
      color: var(--naut-color-primary);
    }

    .naut-menu-item--label {
      flex: 1;
      text-align: left;
    }

    .naut-menu-item--left {
      display: flex;
      align-items: center;
      margin-right: var(--naut-spacing-sm);
    }

    .naut-menu-item--left:empty {
      display: none;
    }

    .naut-menu-item--right {
      display: flex;
      align-items: center;
      margin-left: var(--naut-spacing-sm);
    }

    .naut-menu-item--right:empty {
      display: none;
    }
  }

  /* Dark theme overrides */
  :global(
      [data-theme="dark"]
      .naut-menu-item:hover:not(.active):not(.color-destructive)
    ) {
    background-color: color-mix(in oklch, var(--naut-color-surface), white 10%);
  }
</style>
