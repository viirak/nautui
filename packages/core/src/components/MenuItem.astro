---
import type { Base } from "../types";

export interface MenuItemProps extends Base {
  active?: boolean;
  dimmed?: boolean;
  href: string;
}

const {
  class: className,
  active = false,
  dimmed = false,
  href,
  ...rest
} = Astro.props as MenuItemProps;

const classList = [
  "naut-menu-item",
  active && "active",
  dimmed && "dimmed",
  className,
];
---

<li class="naut-menu__list-item">
  <a href={href} class:list={classList} {...rest}>
    <span class="naut-menu-item--left"><slot name="before" /></span>
    <span class="naut-menu-item--main"><slot /></span>
    <span class="naut-menu-item--right"><slot name="after" /></span>
  </a>
</li>

<style>
  .naut-menu-item {
    display: flex;
    align-items: center;
    padding: 0.5rem;
    font-size: var(--naut-font-size-md);
    text-wrap: nowrap;
    text-decoration: none;
    cursor: pointer;

    &.dimmed {
      opacity: 0.5;
    }

    &:hover {
      background-color: rgb(from var(--naut-color-primary) r g b / 0.06);
      &.dimmed {
        opacity: 1;
      }
    }

    &.active {
      color: var(--naut-color-primary);
      background-color: rgb(from var(--naut-color-primary) r g b / 0.1);
    }

    .naut-menu-item--main {
      flex: 1;
      text-align: left;
    }

    .naut-menu-item--left {
      display: flex;
      align-items: center;
      margin-right: 0.4rem;
    }

    .naut-menu-item--left:empty {
      display: none;
    }

    .naut-menu-item--right {
      display: flex;
      align-items: center;
    }

    .naut-menu-item--right:empty {
      display: none;
    }
  }
</style>
