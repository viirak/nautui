---
import type { Base } from "../types";

export interface MenuItemProps extends Base {
  active?: boolean;
  color?: "text" | "link" | "dimmed";
  href: string;
}

const {
  class: className,
  active = false,
  color = "text",
  href,
  ...rest
} = Astro.props as MenuItemProps;

const classList = [
  "naut-menu-item",
  active && "active",
  color !== "text" && `color-${color}`,
  className,
];
---

<li class="naut-menu__list-item">
  <a href={href} class:list={classList} {...rest}>
    <span class="naut-menu-item--left"><slot name="before" /></span>
    <span class="naut-menu-item--main"><slot /></span>
    <span class="naut-menu-item--right"><slot name="after" /></span>
  </a>
</li>

<style>
  .naut-menu-item {
    display: flex;
    align-items: center;
    padding: 0.5rem;
    font-size: var(--naut-font-size-md);
    color: var(--naut-color-content);
    text-wrap: nowrap;
    text-decoration: none;
    cursor: pointer;

    &:hover {
      color: var(--naut-color-primary);
      background-color: rgb(from var(--naut-color-primary) r g b / 0.06);
      opacity: 1;
    }

    &.active {
      color: var(--naut-color-primary);
      background-color: rgb(from var(--naut-color-primary) r g b / 0.1);
    }

    &.color-dimmed {
      color: var(--naut-color-content-soft);
      opacity: 0.8;

      &:hover {
        color: var(--naut-color-content);
      }
    }

    &.color-link {
      color: var(--naut-color-link);
    }

    .naut-menu-item--main {
      flex: 1;
      text-align: left;
    }

    .naut-menu-item--left {
      display: flex;
      align-items: center;
      margin-right: 0.4rem;
    }

    .naut-menu-item--left:empty {
      display: none;
    }

    .naut-menu-item--right {
      display: flex;
      align-items: center;
    }

    .naut-menu-item--right:empty {
      display: none;
    }
  }
</style>
