---
import type { Base, Radius } from "../types";
import "../styles/radius.css";

export interface MenuItemProps extends Base {
  active?: boolean;
  activeVariant?: "link" | "primary" | "surface";
  dimmed?: boolean;
  href: string;
  radius?: Radius;
}

const {
  class: className,
  active = false,
  activeVariant,
  radius = "sm",
  dimmed = false,
  href,
  ...rest
} = Astro.props as MenuItemProps;

const classList = [
  "naut-menu-item",
  active && "active",
  activeVariant && `active-${activeVariant}`,
  dimmed && "dimmed",
  radius && `radius-${radius}`,
  className,
];
---

<li class="naut-menu__list-item">
  <a href={href} class:list={classList} {...rest}>
    <span class="naut-menu-item--left"><slot name="before" /></span>
    <span class="naut-menu-item--main"><slot /></span>
    <span class="naut-menu-item--right"><slot name="after" /></span>
  </a>
</li>

<style>
  .naut-menu-item {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.8rem;
    font-size: var(--naut-font-size-md);
    color: var(--naut-color-content);
    text-wrap: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease-in-out;

    &::before {
      position: absolute;
      top: 0.5rem;
      left: -8px;
      width: 2px;
      height: calc(100% - 1rem);
      pointer-events: none;
      content: "";
      background-color: transparent;
      border-radius: 0;
    }

    &:hover {
      background-color: var(--naut-color-base-200);
      &.active-link {
        color: var(--naut-color-link);
      }
    }

    &.active {
      &::before {
        background-color: transparent;
      }

      &.active-primary {
        color: var(--naut-color-primary-content);
        background-color: var(--naut-color-primary);
      }

      &.active-surface {
        background-color: var(--naut-color-base-200);
      }

      &.active-link {
        color: var(--naut-color-link);
        &::before {
          background-color: var(--naut-color-link);
        }
      }
    }

    &.dimmed {
      color: var(--naut-color-content-soft);
      &:hover:not(.active) {
        color: var(--naut-color-content);
      }
    }

    .naut-menu-item--main {
      flex: 1;
      text-align: left;
    }

    .naut-menu-item--left {
      display: flex;
      align-items: center;
      margin-right: 0.4rem;
    }

    .naut-menu-item--left:empty {
      display: none;
    }

    .naut-menu-item--right {
      display: flex;
      align-items: center;
    }

    .naut-menu-item--right:empty {
      display: none;
    }
  }
</style>
