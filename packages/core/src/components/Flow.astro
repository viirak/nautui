---
import { Base, Responsive, Size } from "../types";

/**
 * @deprecated Use `Box` instead with `ta` and `maxWidth` props.
 * `Flow` is kept for backwards compatibility but will be removed in v0.3.0.
 * Migration: `<Flow direction="center" maxWidth="sm">` → `<Box ta="center" maxWidth="sm">`
 */
console.warn(
  "[@nautui/core] Flow is deprecated. Use Box with `ta` and `maxWidth` props instead."
);

type Direction = "left" | "center" | "right";
type ResponsiveDirection = {
  [key in Responsive]?: Direction;
};

export interface FlowProps extends Base {
  direction?: Direction | ResponsiveDirection;
  maxWidth?: Size;
}

const {
  class: className,
  direction = "left",
  maxWidth,
  ...rest
} = Astro.props as FlowProps;
const dir = typeof direction === "string" ? { base: direction } : direction;
---

<div
  class:list={[
    "naut-flow",
    dir.base && `${dir.base}`,
    dir.sm && `sm-${dir.sm}`,
    dir.md && `md-${dir.md}`,
    dir.lg && `lg-${dir.lg}`,
    dir.xl && `xl-${dir.xl}`,
    maxWidth && `max-w max-w-${maxWidth}`,
    className
  ]}
  {...rest}
>
  <slot />
</div>
<style>
  .naut-flow {
    &.left {
      text-align: left;
    }
    &.center {
      text-align: center;
    }
    &.right {
      text-align: right;
    }

    &.max-w {
      margin-right: auto;
      margin-left: auto;
    }

    &.max-w-sm {
      max-width: 640px;
    }

    &.max-w-md {
      max-width: 768px;
    }

    &.max-w-lg {
      max-width: 1024px;
    }

    &.max-w-xl {
      max-width: 1280px;
    }

    @media only screen and (max-width: 817px) {
      &.sm-left {
        text-align: left;
      }
      &.sm-center {
        text-align: center;
      }
      &.sm-right {
        text-align: right;
      }
    }

    @media only screen and (min-width: 818px) and (max-width: 1041px) {
      &.md-left {
        text-align: left;
      }
      &.md-center {
        text-align: center;
      }
      &.md-right {
        text-align: right;
      }
    }

    @media only screen and (min-width: 1042px) {
      &.lg-left {
        text-align: left;
      }
      &.lg-center {
        text-align: center;
      }
      &.lg-right {
        text-align: right;
      }
    }

    @media only screen and (min-width: 1250px) {
      &.xl-left {
        text-align: left;
      }
      &.xl-center {
        text-align: center;
      }
      &.xl-right {
        text-align: right;
      }
    }
  }
</style>
