---
import type { Base, Spacing } from "../types";

export interface GridProps extends Base {
  bordered?: boolean;
  columns?: 1 | 2 | 3 | 4 | 5;
  gap?: Spacing;
}

const {
  class: className,
  columns = 3,
  gap = "md",
  bordered = false,
} = Astro.props as GridProps;
---

<div
  class:list={["naut-grid", `cols-${columns}`, `gap-${gap}`, bordered && "bordered", className]}
>
  <slot />
</div>

<style>
  .naut-grid {
    display: grid;
    grid-template-columns: 1fr;

    &.gap-none:not(.bordered) {
      gap: 0;
    }

    &.gap-sm:not(.bordered) {
      gap: var(--naut-spacing-sm);
    }

    &.gap-md:not(.bordered) {
      gap: var(--naut-spacing-md);
    }

    &.gap-lg:not(.bordered) {
      gap: var(--naut-spacing-lg);
    }

    &.gap-xl:not(.bordered) {
      gap: var(--naut-spacing-xl);
    }

    &.bordered {
      gap: 1px;
      background-color: var(--naut-color-border);
      border: 1px solid var(--naut-color-border);
    }

    @media (min-width: 640px) {
      &.cols-2 {
        grid-template-columns: repeat(2, 1fr);
      }

      &.cols-3 {
        grid-template-columns: repeat(3, 1fr);
      }

      &.cols-4 {
        grid-template-columns: repeat(3, 1fr);
      }

      &.cols-5 {
        grid-template-columns: repeat(3, 1fr);
      }

      &.cols-6 {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (min-width: 1024px) {
      &.cols-4 {
        grid-template-columns: repeat(4, 1fr);
      }

      &.cols-5 {
        grid-template-columns: repeat(5, 1fr);
      }

      &.cols-6 {
        grid-template-columns: repeat(6, 1fr);
      }
    }
  }

  :global(.naut-grid.bordered > div) {
    background-color: var(--naut-color-base);
  }
</style>
