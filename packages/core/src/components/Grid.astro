---
import { createMargin, createPadding } from "../lib/spacing";
import type { Base, Spacing, SpacingProps } from "../types";

export interface GridProps extends Base, SpacingProps {
  bordered?: boolean;
  columns?: number;
  gap?: Spacing;
}

const {
  class: className,
  columns = 12,
  gap = "md",
  bordered = false,
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
} = Astro.props as GridProps;

const padding = createPadding("grid", { p, px, py, pt, pr, pb, pl });
const margin = createMargin("grid", { m, mx, my, mt, mr, mb, ml });
---

<div
  class:list={[
    "naut-grid",
    `gap-${gap}`,
    bordered && "bordered",
    className
  ]}
>
  <slot />
</div>

<style define:vars={{ columns, ...padding, ...margin }}>
  .naut-grid {
    display: grid;
    grid-template-columns: 1fr; /* Stacked on mobile */
    padding-top: var(--gridPaddingTop);
    padding-right: var(--gridPaddingRight);
    padding-bottom: var(--gridPaddingBottom);
    padding-left: var(--gridPaddingLeft);
    margin-top: var(--gridMarginTop);
    margin-right: var(--gridMarginRight);
    margin-bottom: var(--gridMarginBottom);
    margin-left: var(--gridMarginLeft);

    @media only screen and (min-width: 576px) {
      grid-template-columns: repeat(2, 1fr); /* 2 columns on tablet */
    }

    @media only screen and (min-width: 1042px) {
      grid-template-columns: repeat(var(--columns), 1fr); /* Desktop columns */
    }

    &.gap-none:not(.bordered) {
      gap: 0;
    }

    &.gap-sm:not(.bordered) {
      gap: var(--naut-spacing-sm);
    }

    &.gap-md:not(.bordered) {
      gap: var(--naut-spacing-md);
    }

    &.gap-lg:not(.bordered) {
      gap: var(--naut-spacing-lg);
    }

    &.gap-xl:not(.bordered) {
      gap: var(--naut-spacing-xl);
    }

    &.bordered {
      gap: 1px;
      background-color: var(--naut-color-border);
      border: 1px solid var(--naut-color-border);
    }
  }

  :global(.naut-grid.bordered > .naut-grid-item) {
    background-color: var(--naut-color-base);
  }
</style>
