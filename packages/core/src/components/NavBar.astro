---
import type { Base, Shadow } from "../types";
import Container from "./Container.astro";

export interface NavBarProps extends Base {
  bordered?: boolean;
  glassy?: boolean;
  height: string;
  offset?: number; // offset for sticky navbar
  shadow?: Shadow;
  sticky?: boolean;
  variant?: "default" | "island";
  zi?: number; // z-index for sticky navbar
}

const {
  class: className,
  variant = "default",
  bordered = false,
  sticky = false,
  offset = 0,
  zi = 99,
  ...rest
} = Astro.props as NavBarProps;
const offsetValue = offset ? `${offset}px` : "0";
const isSticky = sticky;
---

<div class="naut-bar">
  <nav
    class:list={[
    "naut-navbar",
    `variant--${variant}`,
    isSticky && "sticky",
    bordered && "bordered",
    className
  ]}
    {...rest}
  >
    <Container>
      <div class="naut-navbar--content"><slot /></div>
    </Container>
  </nav>
</div>

<style define:vars={{ zi, offsetValue }}>
  .naut-navbar {
    --naut-navbar-height: 70px;
    display: flex;
    align-items: center;
    height: var(--naut-navbar-height);
    overflow: hidden;
    background-color: var(--naut-color-base);

      border-bottom: 1px solid var(--naut-color-border);
    }

    &.sticky {
      position: fixed;
      top: var(--offsetValue);
      z-index: var(--zi);
      width: 100%;
    }

    &.variant--island {
      margin: 0 var(--naut-spacing-md);

      &.sticky {
        left: 50%;
        width: calc(100% - 2 * var(--naut-spacing-md));
        margin: 0;
        transform: translateX(-50%);
      }

      &.bordered {
        border: 1px solid var(--naut-color-border);
      }

      /*Mobile*/
      @media only screen and (min-width: 576px) {
        max-width: calc(576px + 2 * var(--naut-spacing-md));
        margin: 0 auto;
      }

      /* Tablet */
      @media only screen and (min-width: 818px) and (max-width: 1041px) {
        max-width: calc(768px + 2 * var(--naut-spacing-md));
      }

      /* Desktop */
      @media only screen and (min-width: 1042px) and (max-width: 1249px) {
        max-width: calc(992px + 2 * var(--naut-spacing-md));
      }

      /* Large Desktop */
      @media only screen and (min-width: 1250px) {
        max-width: calc(1200px + 2 * var(--naut-spacing-md));
      }
    }

    .naut-navbar--content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: var(--naut-navbar-height);
    }
  }
</style>
