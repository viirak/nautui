---
import "../styles/spacing/margin.css";
import "../styles/spacing/letter.css";
import {
  extractSpacingProps,
  getSpacingClasses,
  MarginProps,
} from "../lib/spacing";
import type { Base, Size } from "../types";

type TextDecoration = "underline" | "strikethrough";
type TextTranform = "capitalize" | "uppercase" | "lowercase";

export interface TextProps extends Base, MarginProps {
  align?: "left" | "center" | "right" | "justify";
  color?: "soft" | "muted";
  decoration?: TextDecoration;
  dimmed?: boolean;
  inline?: boolean;
  italic?: boolean;
  ls?: Size; // letter spacing shorthand
  nowrap?: boolean;
  size?: Size;
  td?: TextDecoration; // text decoration shorthand
  transform?: TextTranform;
  tt?: TextTranform; // text transform shorthand
  variant?:
    | "primary"
    | "secondary"
    | "tertiary"
    | "destructive"
    | "link"
    | "highlight";
  weight?: "light" | "normal" | "medium" | "bold" | "semi-bold" | "extra-bold";
}

const { margin, nonSpacing } = extractSpacingProps(Astro.props as TextProps);

const {
  class: className,
  align,
  weight,
  transform,
  decoration,
  tt,
  td,
  variant,
  size,
  ls,
  color,
  italic = false,
  inline = false,
  dimmed = false,
  nowrap = false,
  ...rest
} = nonSpacing;

const marginClasses = getSpacingClasses(margin);
const textTransform = transform || tt;
const textDecoration = decoration || td;

const classList = [
  "text",
  italic && "italic",
  dimmed && "dimmed",
  color && `color-${color}`,
  nowrap && "nowrap",
  align && `align-${align}`,
  size && `size-${size}`,
  weight && `weight-${weight}`,
  textTransform && `tt-${textTransform}`,
  variant && `variant-${variant}`,
  textDecoration && `td-${textDecoration}`,
  ls && `ls-${ls}`,
  ...marginClasses,
  className,
];
---

{inline && <span class:list={classList} {...rest}><slot /></span>}
{!inline && <p class:list={classList} {...rest}><slot /></p>}

<style>
  .text {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;

    &::selection {
      color: var(--naut-color-content);
      -webkit-text-fill-color: var(--naut-color-content);
      background-color: var(--naut-color-selection);
    }

    &.inline {
      display: inline-block;
    }

    &.italic {
      font-style: italic;
    }

    &.nowrap {
      white-space: nowrap;
    }

    &.align-left {
      text-align: left;
    }

    &.align-center {
      text-align: center;
    }

    &.align-right {
      text-align: right;
    }

    &.align-justify {
      text-align: justify;
    }

    &.dimmed {
      color: var(--naut-color-content-soft);
    }

    &.color-soft {
      color: var(--naut-color-content-soft);
    }

    &.color-muted {
      color: var(--naut-color-content-soft);
      opacity: 0.65;
    }

    &.size-xs {
      font-size: var(--naut-font-size-xs);
      line-height: calc(
        var(--naut-font-size-xs) *
        var(--naut-line-height-ratio)
      );
    }

    &.size-sm {
      font-size: var(--naut-font-size-sm);
      line-height: calc(
        var(--naut-font-size-sm) *
        var(--naut-line-height-ratio)
      );
    }

    &.size-md {
      font-size: var(--naut-font-size-md);
      line-height: calc(
        var(--naut-font-size-md) *
        var(--naut-line-height-ratio)
      );
    }

    &.size-lg {
      font-size: clamp(1.15rem, 1.5vw + 1rem, var(--naut-font-size-lg));
      line-height: clamp(1.8rem, 2.5vw + 1rem, 2.05rem);
    }

    &.size-xl {
      font-size: clamp(1.3rem, 1.3vw + 1rem, var(--naut-font-size-xl));
      line-height: clamp(2rem, 2.5vw + 1rem, 2.34rem);
    }

    &.size-xxl {
      font-size: clamp(1.5rem, 1.5vw + 1rem, var(--naut-font-size-xxl));
      line-height: clamp(2.2rem, 2vw + 1rem, 3.25rem);
    }

    &.weight-light {
      font-weight: 300;
    }

    &.weight-medium {
      font-weight: 500;
    }

    &.weight-bold {
      font-weight: 700;
    }

    &.weight-semi-bold {
      font-weight: 600;
    }

    &.weight-extra-bold {
      font-weight: 800;
    }

    &.weight-normal {
      font-weight: 400;
    }

    &.tt-capitalize {
      text-transform: capitalize;
    }
    &.tt-uppercase {
      text-transform: uppercase;
    }
    &.tt-lowercase {
      text-transform: lowercase;
    }

    &.td-underline {
      text-decoration: underline;
    }
    &.td-strikethrough {
      text-decoration: line-through;
    }

    /* Variants */
    &.variant-primary {
      color: var(--naut-color-primary);
    }

    &.variant-secondary {
      color: var(--naut-color-secondary);
    }

    &.variant-destructive {
      color: var(--naut-color-destructive);
    }

    &.variant-link {
      color: var(--naut-color-link);
    }

    &.variant-highlight {
      color: var(--naut-color-content);
      background: var(--naut-color-highlight);
    }
  }

  p.text {
    &:first-child {
      margin-top: 0;
    }
    &:last-child {
      margin-bottom: 0;
    }
  }

  :global(p.text code) {
    padding: 3px 6px;
    background: var(--naut-color-base-200);
    border-radius: 3px;
  }

  span.text {
    display: inline-block;
  }
</style>
