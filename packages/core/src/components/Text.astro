---
import "../styles/spacing/margin.css";
import {
  extractSpacingProps,
  getSpacingClasses,
  MarginProps,
} from "../lib/spacing";
import type { Base, Size } from "../types";

export interface TextProps extends Base, MarginProps {
  align?: "left" | "center" | "right" | "justify";
  decoration?: "underline" | "strikethrough";
  dimmed?: boolean;
  inline?: boolean;
  italic?: boolean;
  maxWidth?: number | string;
  size?: Size;
  transform?: "capitalize" | "uppercase" | "lowercase";
  variant?:
    | "primary"
    | "secondary"
    | "tertiary"
    | "destructive"
    | "link"
    | "highlight";
  weight?: "light" | "normal" | "medium" | "bold" | "semi-bold" | "extra-bold";
}

const { margin, nonSpacing } = extractSpacingProps(Astro.props as TextProps);

const {
  class: className,
  weight,
  transform,
  decoration,
  size,
  italic = false,
  inline = false,
  dimmed = false,
  variant,
  align,
  ...rest
} = nonSpacing;

const marginClasses = getSpacingClasses(margin);

const classList = [
  "text",
  italic && "italic",
  dimmed && "dimmed",
  align && `align-${align}`,
  size && `size-${size}`,
  weight && `weight-${weight}`,
  transform && `transform-${transform}`,
  variant && `variant-${variant}`,
  decoration && `decoration-${decoration}`,
  ...marginClasses,
  className,
];
---

{inline && <span class:list={classList} {...rest}><slot /></span>}
{!inline && <p class:list={classList} {...rest}><slot /></p>}

<style>
  .text {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;

    &::selection {
      color: var(--naut-color-content);
      -webkit-text-fill-color: var(--naut-color-content);
      background-color: var(--naut-color-selection);
    }

    &.inline {
      display: inline-block;
    }

    &.italic {
      font-style: italic;
    }

    &.align-left {
      text-align: left;
    }

    &.align-center {
      text-align: center;
    }

    &.align-right {
      text-align: right;
    }

    &.align-justify {
      text-align: justify;
    }

    &.dimmed {
      color: var(--naut-color-content-soft);
    }

    &.size-xs {
      font-size: var(--naut-font-size-xs);
      line-height: calc(
        var(--naut-font-size-xs) *
        var(--naut-line-height-ratio)
      );
    }

    &.size-sm {
      font-size: var(--naut-font-size-sm);
      line-height: calc(
        var(--naut-font-size-sm) *
        var(--naut-line-height-ratio)
      );
    }

    &.size-md {
      font-size: var(--naut-font-size-md);
      line-height: calc(
        var(--naut-font-size-md) *
        var(--naut-line-height-ratio)
      );
    }

    &.size-lg {
      font-size: clamp(1.15rem, 1.5vw + 1rem, var(--naut-font-size-lg));
      line-height: clamp(1.8rem, 2.5vw + 1rem, 2.05rem);
    }

    &.size-xl {
      font-size: clamp(1.3rem, 1.3vw + 1rem, var(--naut-font-size-xl));
      line-height: clamp(2rem, 2.5vw + 1rem, 2.34rem);
    }

    &.size-xxl {
      font-size: clamp(1.5rem, 1.5vw + 1rem, var(--naut-font-size-xxl));
      line-height: clamp(2.2rem, 2vw + 1rem, 3.25rem);
    }

    &.weight-light {
      font-weight: 300;
    }

    &.weight-medium {
      font-weight: 500;
    }

    &.weight-bold {
      font-weight: 700;
    }

    &.weight-semi-bold {
      font-weight: 600;
    }

    &.weight-extra-bold {
      font-weight: 800;
    }

    &.transform-capitalize {
      text-transform: capitalize;
    }
    &.transform-uppercase {
      text-transform: uppercase;
    }
    &.transform-lowercase {
      text-transform: lowercase;
    }

    &.decoration-underline {
      text-decoration: underline;
    }
    &.decoration-strikethrough {
      text-decoration: line-through;
    }

    /* Variants */
    &.variant-primary {
      color: var(--naut-color-primary);
    }

    &.variant-secondary {
      color: var(--naut-color-secondary);
    }

    &.variant-destructive {
      color: var(--naut-color-destructive);
    }
  }

  p.text {
    &:first-child {
      margin-top: 0;
    }
    &:last-child {
      margin-bottom: 0;
    }
  }

  span.text {
    display: inline-block;
  }
</style>
