---
import { Base, Size } from "../types";

type SpaceSize = "auto" | Size | "display" | "display-lg" | "display-xl";

export interface SpaceProps extends Base {
  grow?: boolean;
  orientation?: "horizontal" | "vertical";
  /**
   * Every step is a fluid `clamp()`, so one value adapts across the whole
   * viewport range on its own — there is nothing for a per-breakpoint
   * override to add.
   */
  size?: SpaceSize;
}

const {
  class: className,
  orientation = "vertical",
  grow = false,
  size = "md",
} = Astro.props as SpaceProps;
const classlist = [
  "naut-space",
  orientation,
  size && `size-${size}`,
  grow && "grow",
  className,
];
---

<div class:list={classlist}><slot /></div>

<style>
  .naut-space {
    position: relative;
    box-sizing: border-box;

    &.grow {
      flex-grow: 1;
    }

    &:not(.horizontal) {
      &.size-auto {
        height: auto;
      }

      &.size-sm {
        height: var(--naut-spacing-sm);
      }

      &.size-md {
        height: var(--naut-spacing-md);
      }

      &.size-lg {
        height: var(--naut-spacing-lg);
      }

      &.size-xl {
        height: var(--naut-spacing-xl);
      }

      &.size-display {
        height: var(--naut-spacing-display);
      }

      &.size-display-lg {
        height: var(--naut-spacing-display-lg);
      }

      &.size-display-xl {
        height: var(--naut-spacing-display-xl);
      }
    }

    &.horizontal {
      display: inline-block;
      &.size-auto {
        width: auto;
      }

      &.size-sm {
        width: var(--naut-spacing-sm);
      }

      &.size-md {
        width: var(--naut-spacing-md);
      }

      &.size-lg {
        width: var(--naut-spacing-lg);
      }

      &.size-xl {
        width: var(--naut-spacing-xl);
      }

      &.size-display {
        width: var(--naut-spacing-display);
      }

      &.size-display-lg {
        width: var(--naut-spacing-display-lg);
      }

      &.size-display-xl {
        width: var(--naut-spacing-display-xl);
      }
    }
  }
</style>
