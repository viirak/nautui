---
import { resolveMargin, resolvePadding, spacingToStyle } from "../lib/spacing";
import type { Base, SpacingProps } from "../types";

export interface ContainerProps extends Base, SpacingProps {
  flex?: string | number; // allows custom flex values (e.g. "0 1 100%")
  fluid?: boolean; // if true, the container will take the full width of the viewport
  maxWidth?: number;
}

const {
  class: className,
  fluid = false,
  flex,
  maxWidth,
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as ContainerProps;

const isMax = maxWidth !== undefined;
const maxWidthVar = maxWidth ? maxWidth : "none";
const flexVar = flex ? flex : "none";
const spacingStyle = [
  spacingToStyle(resolvePadding({ p, px, py, pt, pr, pb, pl })),
  spacingToStyle(resolveMargin({ m, mx, my, mt, mr, mb, ml })),
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={[
    "naut-container",
    isMax && "max",
    fluid && "fluid",
    flex && "flex",
    className
  ]}
  style={spacingStyle || undefined}
  {...rest}
>
  <slot />
</div>

<style define:vars={{ maxWidthVar, flexVar }}>
  .naut-container {
    display: flow-root; /* Prevents margin collapsing */
    padding: 0 var(--naut-spacing-md);

    &.fluid {
      width: 100%;
    }

    &.flex {
      flex: var(--flexVar);
    }

    &:not(.fluid) {
      margin: 0 auto;
      /*Mobile*/
      @media only screen and (min-width: 576px) and (max-width: 817px) {
        max-width: 576px;
      }

      /* Tablet */
      @media only screen and (min-width: 818px) and (max-width: 1041px) {
        max-width: 768px;
      }

      /* Desktop */
      @media only screen and (min-width: 1042px) and (max-width: 1249px) {
        max-width: 992px;
      }

      /* Large Desktop */
      @media only screen and (min-width: 1250px) {
        max-width: 1200px;
      }
    }

    &.max {
      max-width: var(--maxWidthVar);
    }
  }
</style>
