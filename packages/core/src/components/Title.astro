---
import "../styles/spacing/margin.css";
import { getColorValue } from "../lib/color";
import type { SpacingProps } from "../lib/spacing";
import { getMarginClassList } from "../lib/spacing";
import type { Base, Color } from "../types";

export interface TitleProps extends Base, SpacingProps {
  align?: "left" | "center" | "right" | "justify";
  color?: Color;
  gradient?: { colors: string[]; deg?: number };
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?:
    | "default"
    | "display"
    | "display-sm"
    | "display-md"
    | "display-lg"
    | "display-xl"
    | "display-xxl"
    | "h1"
    | "h2"
    | "h3"
    | "h4"
    | "h5"
    | "h6";
}

const { margin, ...nonSpacing } = Astro.props as TitleProps;

const {
  level = 2,
  class: className,
  size = "default",
  color: colorProp,
  gradient,
  align,
  ...rest
} = nonSpacing;

const spacingClasses = getMarginClassList(margin);
const colorValue = getColorValue(colorProp);

/** `size="hN"` is an alias for the level scale, not a separate size. */
const sizeLevel = /^h([1-6])$/.exec(size ?? "")?.[1];

const classlist = [
  "naut-title",
  `l-${level}`,
  align && `align-${align}`,
  sizeLevel ? `l-${sizeLevel}` : size !== "default" && `size-${size}`,
  gradient && "color--gradient",
  ...spacingClasses,
  colorValue && "color--custom",
  className,
];

const gradientBg = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : undefined;
---

{level === 1 && <h1 class:list={classlist} {...rest}><slot /></h1>}
{level === 2 && <h2 class:list={classlist} {...rest}><slot /></h2>}
{level === 3 && <h3 class:list={classlist} {...rest}><slot /></h3>}
{level === 4 && <h4 class:list={classlist} {...rest}><slot /></h4>}
{level === 5 && <h5 class:list={classlist} {...rest}><slot /></h5>}
{level === 6 && <h6 class:list={classlist} {...rest}><slot /></h6>}

<style define:vars={{ gradientBg, titleColor: colorValue ?? "" }}>
  .naut-title {
    font-family: var(--naut-font-display);
    font-weight: bold;
    color: var(--naut-color-content);

    &.align-left {
      text-align: left;
    }

    &.color--custom {
      color: var(--titleColor);
    }

    &.align-center {
      text-align: center;
    }

    &.align-right {
      text-align: right;
    }

    &.align-justify {
      text-align: justify;
    }

    &.l-1 {
      font-size: clamp(2rem, 2.5vw + 1rem, 2.5rem);
      line-height: clamp(2.5rem, 3.5vw + 1rem, 3.1rem);
    }

    &.l-2 {
      font-size: clamp(1.4rem, 2vw + 1rem, 1.8rem);
      line-height: clamp(2.15rem, 2.25vw + 1rem, 2.25rem);
    }

    &.l-3 {
      font-size: clamp(1.2rem, 1.5vw + 1rem, 1.45rem);
      line-height: clamp(1.8rem, 1.75vw + 1rem, 1.8rem);
    }

    &.l-4 {
      font-size: clamp(1.1rem, 1.25vw + 1rem, 1.35rem);
      line-height: clamp(1.6rem, 1.5vw + 1rem, 1.6rem);
    }

    &.l-5 {
      font-size: clamp(1rem, 1vw + 1rem, 1.25rem);
      line-height: clamp(1.4rem, 1.25vw + 1rem, 1.4rem);
    }

    &.l-6 {
      font-size: clamp(1rem, 0.75vw + 1rem, 1.2rem);
      line-height: clamp(1.3rem, 1vw + 1rem, 1.3rem);
    }

    &.size-display-sm {
      font-size: clamp(2rem, 2.2vw + 1rem, 2.8rem);
      line-height: clamp(2.5rem, 3.2vw + 1rem, 3.5rem);
    }

    &.size-display-md {
      font-size: clamp(2.1rem, 2.4vw + 1rem, 3rem);
      line-height: clamp(2.6rem, 3.2vw + 1rem, 3.6rem);
    }

    &.size-display {
      font-size: clamp(2.2rem, 2.5vw + 1rem, 3.2rem);
      line-height: clamp(2.8rem, 3.2vw + 1rem, 3.95rem);
    }

    &.size-display-lg {
      font-size: clamp(2.8rem, 4vw + 1rem, 4.2rem);
      line-height: clamp(3rem, 4.5vw + 1rem, 4.5rem);
    }

    &.size-display-xl {
      font-size: clamp(3rem, 5vw + 1rem, 4.5rem);
      line-height: clamp(3.2rem, 5vw + 1rem, 5rem);
    }

    &.size-display-xxl {
      font-size: clamp(3.2rem, 6vw + 1rem, 5rem);
      line-height: clamp(3.5rem, 6vw + 1rem, 5.5rem);
    }

    /* Color */
    &.color--gradient {
      color: transparent;
      -webkit-text-fill-color: transparent;
      background-image: var(--gradientBg);
      -webkit-background-clip: text;
      &::selection {
        color: var(--naut-color-content);
        -webkit-text-fill-color: var(--naut-color-content);
        background-color: var(--naut-color-selection);
      }
    }
  }
</style>
