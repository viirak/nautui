---
import type { Base, MarginProps } from "../types";

export interface TitleProps extends Base, MarginProps {
  align?: "left" | "center" | "right" | "justify";
  gradient?: { colors: string[]; deg?: number };
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?: "default" | "display" | "display-lg" | "display-xl" | "display-xxl";
}

const {
  level = 2,
  class: className,
  size = "default",
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  gradient,
  align,
  ...rest
} = Astro.props as TitleProps;

// Resolve axis shorthands: specific > axis > all
const resolvedMt = mt ?? my ?? m;
const resolvedMb = mb ?? my ?? m;
const resolvedMl = ml ?? mx ?? m;
const resolvedMr = mr ?? mx ?? m;

const classlist = [
  "naut-title",
  `l-${level}`,
  align && `align-${align}`,
  size && `size-${size}`,
  resolvedMt && `mt-${resolvedMt}`,
  resolvedMb && `mb-${resolvedMb}`,
  resolvedMl && `ml-${resolvedMl}`,
  resolvedMr && `mr-${resolvedMr}`,
  gradient && "color--gradient",
  className,
];

const gradientBg = gradient
  ? `linear-gradient(${gradient.deg || 45}deg, ${gradient.colors.join(", ")})`
  : undefined;
---

{level === 1 && <h1 class:list={classlist} {...rest}><slot /></h1>}
{level === 2 && <h2 class:list={classlist} {...rest}><slot /></h2>}
{level === 3 && <h3 class:list={classlist} {...rest}><slot /></h3>}
{level === 4 && <h4 class:list={classlist} {...rest}><slot /></h4>}
{level === 5 && <h5 class:list={classlist} {...rest}><slot /></h5>}
{level === 6 && <h6 class:list={classlist} {...rest}><slot /></h6>}

<style define:vars={{ gradientBg }}>
  .naut-title {
    margin: 0 0 var(--naut-spacing-sm) 0;
    font-weight: bold;

    &.align-left {
      text-align: left;
    }

    &.align-center {
      text-align: center;
    }

    &.align-right {
      text-align: right;
    }

    &.align-justify {
      text-align: justify;
    }

    &.l-1 {
      font-size: 2.5rem;
      line-height: calc(2.05rem * var(--naut-line-height-ratio));
    }

    &.l-2 {
      font-size: 1.8rem;
      line-height: calc(1.45rem * var(--naut-line-height-ratio));
    }

    &.l-3 {
      font-size: 1.6rem;
      line-height: calc(1.3rem * var(--naut-line-height-ratio));
    }

    &.l-4 {
      font-size: 1.5rem;
      line-height: calc(1.25rem * var(--naut-line-height-ratio));
    }

    &.l-5 {
      font-size: 1.3rem;
      line-height: calc(1.085rem * var(--naut-line-height-ratio));
    }

    &.l-6 {
      font-size: 1.2rem;
      line-height: calc(1.025rem * var(--naut-line-height-ratio));
    }

    /* Margins */
    &.mt-0 {
      margin-top: 0;
    }
    &.mb-0 {
      margin-bottom: 0;
    }
    &.ml-0 {
      margin-left: 0;
    }
    &.mr-0 {
      margin-right: 0;
    }

    &.mt-xs {
      margin-top: var(--naut-spacing-xs);
    }
    &.mb-xs {
      margin-bottom: var(--naut-spacing-xs);
    }
    &.ml-xs {
      margin-left: var(--naut-spacing-xs);
    }
    &.mr-xs {
      margin-right: var(--naut-spacing-xs);
    }

    &.mt-sm {
      margin-top: var(--naut-spacing-sm);
    }
    &.mb-sm {
      margin-bottom: var(--naut-spacing-sm);
    }
    &.ml-sm {
      margin-left: var(--naut-spacing-sm);
    }
    &.mr-sm {
      margin-right: var(--naut-spacing-sm);
    }

    &.mt-md {
      margin-top: var(--naut-spacing-md);
    }
    &.mb-md {
      margin-bottom: var(--naut-spacing-md);
    }
    &.ml-md {
      margin-left: var(--naut-spacing-md);
    }
    &.mr-md {
      margin-right: var(--naut-spacing-md);
    }

    &.mt-lg {
      margin-top: var(--naut-spacing-lg);
    }
    &.mb-lg {
      margin-bottom: var(--naut-spacing-lg);
    }
    &.ml-lg {
      margin-left: var(--naut-spacing-lg);
    }
    &.mr-lg {
      margin-right: var(--naut-spacing-lg);
    }

    &.mt-xl {
      margin-top: var(--naut-spacing-xl);
    }
    &.mb-xl {
      margin-bottom: var(--naut-spacing-xl);
    }
    &.ml-xl {
      margin-left: var(--naut-spacing-xl);
    }
    &.mr-xl {
      margin-right: var(--naut-spacing-xl);
    }

    /* Size display: ;*/
    &.size-display {
      font-size: clamp(2.2rem, 2.5vw + 1rem, 3.2rem);
      line-height: clamp(2.8rem, 3.2vw + 1rem, 3.95rem);
    }

    &.size-display-lg {
      font-size: clamp(2.8rem, 4vw + 1rem, 4.2rem);
      line-height: clamp(3rem, 4.5vw + 1rem, 4.5rem);
    }

    &.size-display-xl {
      font-size: clamp(3rem, 5vw + 1rem, 4.5rem);
      line-height: clamp(3.2rem, 5vw + 1rem, 5rem);
    }

    &.size-display-xxl {
      font-size: clamp(3.2rem, 6vw + 1rem, 5rem);
      line-height: clamp(3.5rem, 6vw + 1rem, 5.5rem);
    }

    /* Color */
    &.color--gradient {
      color: transparent;
      -webkit-text-fill-color: transparent;
      background-image: var(--gradientBg);
      -webkit-background-clip: text;
      &::selection {
        color: var(--naut-color-text);
        -webkit-text-fill-color: var(--naut-color-text);
        background-color: var(--naut-color-selection);
      }
    }
  }
</style>
