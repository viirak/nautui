---
import { getColorValue } from "../lib/color";
import type { Base, Color } from "../types";

export type LinkVariant = "default" | "ghost";

const linkVariants: readonly LinkVariant[] = ["default", "ghost"];

export interface LinkProps extends Base {
  color?: Color;
  dimmed?: boolean;
  external?: boolean;
  hover?: "underline" | "dimmed" | "surface";
  to: string;
  underline?: boolean;
  variant?: LinkVariant;
  wrap?: boolean;
}

const {
  to,
  color,
  dimmed,
  class: className,
  hover = "underline",
  external = false,
  underline = false,
  variant = "default",
  wrap = false,
  size,
  ...rest
} = Astro.props as LinkProps;

/**
 * `Base`'s index signature means an unimplemented prop is not an
 * excess-property error — it would reach the DOM as an invalid attribute and
 * render as a no-op. Reject the two that are natural to guess instead.
 */
if (variant !== undefined && !linkVariants.includes(variant)) {
  throw new TypeError(
    `Link: \`variant\` must be one of ${linkVariants.join(" | ")}. Received ${JSON.stringify(variant)}.`
  );
}

if (size !== undefined) {
  throw new TypeError(
    'Link: `size` is not supported. A link inherits the size of its surrounding text. Use <Text inline size="lg"> around it, or a `class`.'
  );
}

const linkColor = getColorValue(color);
---

<a
  class:list={[
    "naut-link",
    `hover--${hover}`,
    wrap && "wrap",
    dimmed && "dimmed",
    external && "external",
    underline && "underline",
    variant !== "default" && `variant-${variant}`,
    linkColor && "color--custom",
    className
  ]}
  href={to}
  {...rest}
>
  <div class="naut-link__wrapper"><slot /></div>
  {external && (
    <svg
      class="lucide lucide-external-link-icon external-link-icon"
      fill="none"
      height="16"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="16"
      xmlns="http://www.w3.org/2000/svg"
    >
      <title>External Link</title>
      <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
  )}
</a>
<style define:vars={{ linkColor: linkColor ?? "" }}>
  .naut-link {
    display: inline-flex;
    flex-wrap: nowrap;
    gap: 0.4rem;
    align-items: center;
    padding: 0.2rem 0.4rem;
    color: var(--naut-color-link);
    text-decoration: none;

    .naut-link__wrapper {
      display: inline-flex;
      flex-wrap: nowrap;
      gap: 0.5rem;
      align-items: center;
      text-wrap: nowrap;
    }

    &.wrap {
      flex-wrap: wrap;

      .naut-link__wrapper {
        flex-wrap: wrap;
        text-wrap: wrap;
      }
    }

    &.underline {
      text-decoration: underline;
    }

    &.dimmed {
      opacity: 0.5;
    }

    &.external {
      gap: 0.3rem;

      .external-link-icon {
        opacity: 0.5;
      }
    }

    &.variant-ghost {
      color: var(--naut-color-content);
    }

    &.color--custom {
      color: var(--linkColor);
    }

    &:hover {
      &.dimmed {
        opacity: 1;
      }

      &.hover--underline {
        text-decoration: underline;
      }

      &.hover--dimmed {
        opacity: 0.5;
      }

      &.hover--surface {
        background-color: var(--naut-color-base-100);
      }
    }
  }
</style>
