---
import { uid } from "../lib/uid";
import type { Base } from "../types";
import Text from "./Text.astro";

export interface AccordionItemProps extends Base {
  icon?: "chevron" | "plus";
  size?: "md" | "lg" | "xl";
  title: string;
}

const {
  title,
  size = "md",
  icon = "plus",
  class: className,
  ...rest
} = Astro.props as AccordionItemProps;

const uniqueId = uid("naut-accordion");
const contentId = `${uniqueId}-content`;
---

<div
  class:list={[
    "naut-accordion-item",
    `size-${size}`,
    className
  ]}
  data-state="closed"
  {...rest}
>
  <button
    type="button"
    class="accordion-header"
    aria-expanded="false"
    aria-controls={contentId}
  >
    <Text inline size={size}>{title}</Text>
    <span class:list={["accordion-icon", icon]}></span>
  </button>
  <div id={contentId} class="accordion-content" aria-hidden="true">
    <div class="content-inner"><slot /></div>
  </div>
</div>

<style>
  .naut-accordion-item {
    display: block;

    &::after {
      display: block;
      margin: 0 var(--naut-spacing-sm);
      content: "";
      border-bottom: 1px solid var(--naut-color-border);
    }

    &:last-child::after {
      display: none;
    }

    .accordion-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--naut-spacing-sm);
      font: inherit;
      color: inherit;
      text-align: left;
      cursor: pointer;
      user-select: none;
      background-color: var(--accordion-item-bg);
      border: 0;

      &:focus-visible {
        outline: 2px solid var(--naut-color-primary);
        outline-offset: 2px;
      }

      .accordion-icon {
        position: relative;
        display: block;
        margin: 8px;
        opacity: 0.5;
        transition:
          transform 0.3s ease-in-out,
          opacity 0.3s ease-in-out;

        &.chevron {
          width: 8px;
          height: 8px;
          border-right: var(--naut-border-width-md) solid
            var(--naut-color-content);
          border-bottom: var(--naut-border-width-md) solid
            var(--naut-color-content);
          transform: rotate(45deg); /* Points down */
        }

        &.plus {
          width: 16px;
          height: 16px;

          /* Horizontal Base Line (-) */
          &::before {
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: var(--naut-border-width-md);
            content: "";
            background-color: var(--naut-color-content);
            transform: translateY(-50%);
            transition: transform 0.3s ease-in-out;
          }

          /* Vertical Crossing Line (|) */
          &::after {
            position: absolute;
            top: 0;
            left: 50%;
            width: var(--naut-border-width-md);
            height: 100%;
            content: "";
            background-color: var(--naut-color-content);
            transform: translateX(-50%);
            transition:
              transform 0.3s ease-in-out,
              opacity 0.3s ease-in-out;
          }
        }
      }
    }

    .accordion-content {
      max-height: 0;
      overflow: hidden;
      color: var(--naut-color-content);
      transition: max-height 0.3s ease-in-out;

      .content-inner {
        padding: var(--naut-spacing-sm);
        padding-top: 0;
      }
    }

    &[data-state="open"] {
      .accordion-icon.chevron {
        opacity: 1;
        transform: rotate(-135deg);
      }

      .accordion-icon.plus {
        opacity: 1;

        &::after {
          opacity: 0;
          transform: translateX(-50%) scaleY(0);
        }

        &::before {
          transform: translateY(-50%) rotate(180deg);
        }
      }

      .accordion-content {
        max-height: 2000px;
      }
    }
  }
</style>

<script>
  const headers = document.querySelectorAll(".accordion-header");

  for (const header of Array.from(headers)) {
    header.addEventListener("click", () => {
      const item = header.closest(".naut-accordion-item");
      const content = item?.querySelector(".accordion-content");
      if (!(item && content)) return;

      const isOpen = header.getAttribute("aria-expanded") === "true";
      const accordion = item.closest(".naut-accordion");

      if (!isOpen) {
        const siblings = accordion?.querySelectorAll(".accordion-header") ?? [];

        for (const sibling of Array.from(siblings)) {
          if (sibling === header) continue;

          const siblingItem = sibling.closest(".naut-accordion-item");
          const siblingContent =
            siblingItem?.querySelector(".accordion-content");
          sibling.setAttribute("aria-expanded", "false");
          siblingItem?.setAttribute("data-state", "closed");
          siblingContent?.setAttribute("aria-hidden", "true");
        }
      }

      header.setAttribute("aria-expanded", String(!isOpen));
      item.setAttribute("data-state", isOpen ? "closed" : "open");
      content.setAttribute("aria-hidden", String(isOpen));
    });
  }
</script>
