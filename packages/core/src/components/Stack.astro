---
import { resolveMargin, resolvePadding, spacingToStyle } from "../lib/spacing";
import type { Base, Spacing, SpacingProps } from "../types";

export interface StackProps extends Base, SpacingProps {
  align?: "start" | "center" | "end" | "stretch";
  gap?: Spacing;
  justify?:
    | "start"
    | "center"
    | "end"
    | "space-between"
    | "space-around"
    | "space-evenly";
}

const {
  class: className,
  align = "stretch",
  justify = "start",
  gap = "md",
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as StackProps;

const gapValue = `var(--naut-spacing-${gap})`;
const spacingStyle = [
  spacingToStyle(resolvePadding({ p, px, py, pt, pr, pb, pl })),
  spacingToStyle(resolveMargin({ m, mx, my, mt, mr, mb, ml })),
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={["naut-stack", className]}
  style={spacingStyle || undefined}
  {...rest}
>
  <slot />
</div>

<style define:vars={{ align, justify, gap: gapValue }}>
  .naut-stack {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    align-items: var(--align);
    justify-content: var(--justify);
  }
</style>
