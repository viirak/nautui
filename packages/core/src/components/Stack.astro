---
import { resolveMargin, resolvePadding, spacingToStyle } from "../lib/spacing";
import type { Base, Spacing, SpacingProps } from "../types";

export interface StackProps extends Base, SpacingProps {
  align?: "inherit" | "start" | "center" | "end" | "stretch";
  display: "flex" | "block";
  gap?: Spacing;
  justify?:
    | "start"
    | "center"
    | "end"
    | "space-between"
    | "space-around"
    | "space-evenly";
}

const {
  class: className,
  display = "flex",
  align = "inherit",
  justify = "start",
  gap = "md",
  p,
  px,
  py,
  pt,
  pr,
  pb,
  pl,
  m,
  mx,
  my,
  mt,
  mr,
  mb,
  ml,
  ...rest
} = Astro.props as StackProps;

const stackGap = `var(--naut-spacing-${gap})`;
const spacingStyle = [
  spacingToStyle(resolvePadding({ p, px, py, pt, pr, pb, pl })),
  spacingToStyle(resolveMargin({ m, mx, my, mt, mr, mb, ml })),
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={["naut-stack", className, display]}
  style={spacingStyle || undefined}
  {...rest}
>
  <slot />
</div>

<style define:vars={{ align, justify, stackGap }}>
  .naut-stack {
    &.flex {
      display: flex;
      flex-direction: column;
      gap: var(--stackGap);
      align-items: var(--align);
      justify-content: var(--justify);
    }

    &.block {
      display: flow-root;
      text-align: var(--align, inherit);
    }
  }

  :global(.naut-stack.block > *) {
    margin-bottom: var(--stackGap);
    &:last-child {
      margin-bottom: 0;
    }
  }
</style>
