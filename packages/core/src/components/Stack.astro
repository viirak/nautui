---
import {
  getResponsiveClasses,
  normalizeDirection,
  normalizeJustify,
  resolveResponsiveValue,
} from "../lib/layout";
import "../styles/spacing/gap.css";
import type {
  Align,
  Base,
  Direction,
  Gap,
  Justify,
  ResponsiveProp,
} from "../types";

export interface StackProps extends Base {
  align?: ResponsiveProp<Align>;
  direction?: ResponsiveProp<Direction>;
  gap?: Gap;
  justify?: ResponsiveProp<Justify>;
}

const {
  class: className,
  align,
  direction = "column",
  justify = "start",
  gap = "md",
  ...rest
} = Astro.props as StackProps;
const directionValue = resolveResponsiveValue(direction, "column");
const alignValue = resolveResponsiveValue(align, "stretch");
const justifyValue = resolveResponsiveValue(justify, "start");
const directionClasses = getResponsiveClasses(
  directionValue,
  "dir",
  normalizeDirection
);
const alignClasses = getResponsiveClasses(alignValue, "items");
const justifyClasses = getResponsiveClasses(
  justifyValue,
  "content",
  normalizeJustify
);
---

<div
  class:list={[
    "naut-stack",
    `gap-${gap}`,
    ...directionClasses,
    ...alignClasses,
    ...justifyClasses,
    className
  ]}
  {...rest}
>
  <slot />
</div>

<style>
