---
import {
  getResponsiveClasses,
  normalizeDirection,
  normalizeJustify,
  resolveResponsiveValue,
} from "../lib/layout";
import "../styles/spacing/gap.css";
import type {
  Align,
  Base,
  Direction,
  Gap,
  Justify,
  ResponsiveProp,
} from "../types";

export interface FlexProps extends Base {
  align?: ResponsiveProp<Align>;
  direction?: ResponsiveProp<Direction>;
  gap?: Gap;
  justify?: ResponsiveProp<Justify>;
  wrap?: "nowrap" | "wrap" | "wrap-reverse";
}

const {
  class: className,
  direction = "row",
  justify = "start",
  align = "start",
  wrap,
  gap,
} = Astro.props as FlexProps;

const directionValue = resolveResponsiveValue<Direction>(direction, "row");
const alignValue = resolveResponsiveValue<Align>(align, "start");
const justifyValue = resolveResponsiveValue<Justify>(justify, "start");
const directionClasses = getResponsiveClasses(
  directionValue,
  "dir",
  normalizeDirection
);
const alignClasses = getResponsiveClasses(alignValue, "align");
const justifyClasses = getResponsiveClasses(
  justifyValue,
  "justify",
  normalizeJustify
);
---

<div
  class:list={[
    "naut-flex",
    ...justifyClasses,
    ...alignClasses,
    ...directionClasses,
    gap && `gap-${gap}`,
    wrap && `wrap-${wrap}`,
    className,
  ]}
>
  <slot />
</div>

<style>
  .naut-flex {
    display: flex;

    &.dir-row {
      flex-direction: row;
    }

    &.dir-column {
      flex-direction: column;
    }

    @media only screen and (max-width: 817px) {
      &.sm-dir-row {
        flex-direction: row;
      }
      &.sm-dir-column {
        flex-direction: column;
      }
    }

    @media only screen and (min-width: 818px) and (max-width: 1041px) {
      &.md-dir-row {
        flex-direction: row;
      }
      &.md-dir-column {
        flex-direction: column;
      }
    }

    @media only screen and (min-width: 1042px) {
      &.lg-dir-row {
        flex-direction: row;
      }
      &.lg-dir-column {
        flex-direction: column;
      }
    }

    @media only screen and (min-width: 1250px) {
      &.xl-dir-row {
        flex-direction: row;
      }
      &.xl-dir-column {
        flex-direction: column;
      }
    }

    &.justify-start {
      justify-content: flex-start;
    }

    &.justify-center {
      justify-content: center;
    }

    &.justify-end {
      justify-content: flex-end;
    }

    &.justify-between {
      justify-content: space-between;
    }

    &.justify-around {
      justify-content: space-around;
    }

    &.justify-evenly {
      justify-content: space-evenly;
    }

    &.align-start {
      align-items: flex-start;
    }

    &.align-center {
      align-items: center;
    }

    &.align-end {
      align-items: flex-end;
    }

    &.align-baseline {
      align-items: baseline;
    }

    &.align-inherit {
      align-items: inherit;
    }

    &.align-stretch {
      align-items: stretch;
    }

    &.wrap-nowrap {
      flex-wrap: nowrap;
    }

    &.wrap-wrap {
      flex-wrap: wrap;
    }

    &.wrap-wrap-reverse {
      flex-wrap: wrap-reverse;
    }
  }
</style>
