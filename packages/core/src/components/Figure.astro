---
interface ImageProps {
  alt: string;
  src: string;
}

export interface FigureProps {
  caption: string;
  class?: string;
  images: ImageProps[];
  layout?: "grid" | "stack" | "masonry";
  mask?: "angle" | "circle" | "hexagon" | "square";
}

const {
  class: className,
  images,
  layout = "grid",
  mask,
} = Astro.props as FigureProps;
---

<div
  class:list={["naut-figure", className, `naut-figure--${layout}`, mask && `naut-figure--${mask}`]}
>
  {images.map((image) => (
    <div class:list={["naut-figure__image"]}>
      <img alt={image.alt} height="auto" src={image.src} width="auto" />
    </div>
  ))}
</div>

<style>
  .naut-figure {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    background-color: #f555ff;
  }
</style>
