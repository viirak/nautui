---
export interface BackgroundGradientProps {
  colors: string[];
  deg?: number;
}

const { colors, deg = 45 } = Astro.props as BackgroundGradientProps;
const gradientBg = `linear-gradient(${deg || 45}deg, ${colors.join(", ")})`;
---

<div class:list={["naut-section-background gradient"]}></div>

<style define:vars={{ gradientBg }}>
  .naut-section-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--gradientBg);
  }
</style>
