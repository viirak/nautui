---
import { Section } from "@nautui/core";

interface FigureProps {
  clip?: "slash" | "backslash";
  position?: "right" | "bottom";
}

export interface SectionHeroProps {
  dark?: boolean; // force dark mode
  figure?: boolean | FigureProps;
}

const { figure = false, dark = false } = Astro.props as SectionHeroProps;

const figureObj = figure && typeof figure !== "boolean";
const clip = figureObj ? figure.clip : undefined;
const position = figureObj && figure.position ? figure.position : "right";
const isFigureRight = position === "right";
const contentAlign = isFigureRight ? "left" : "center";
---

<Section class:list={["naut-hero-section"]} dark={{ dark }}>
  <Fragment slot="before"> <slot name="background" /> </Fragment>
  <div
    class:list={[
      "hero-content",
      isFigureRight && "split" ,
      `align-${contentAlign}`
    ]}
  >
    <slot />
  </div>
  <div
    slot="after"
    class:list={[
      "hero-figure",
      position && `position-${position}`,
      clip && `clip-${clip}`
    ]}
  >
    {figure && <slot name="figure" />}
  </div>
</Section>
<style>
  .hero-content {
    text-align: center;

    @media only screen and (min-width: 1042px) {
      display: grid;

      &.split {
        grid-template-columns: 1fr 1fr; /* Two equal columns */
      }

      &.align-center {
        justify-content: center;
        text-align: center;
      }

      &.align-left {
        justify-content: flex-start;
        text-align: left;
      }

      &.align-right {
        justify-content: flex-end;
        text-align: right;
      }
    }
  }

  .hero-figure {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    overflow: hidden;

    /*Mobile*/
    @media only screen and (min-width: 576px) {
      max-width: 576px;
    }

    /* Tablet */
    @media only screen and (min-width: 818px) and (max-width: 1041px) {
      max-width: 768px;
    }

    @media only screen and (min-width: 1042px) {
      max-width: 992px;

      &.position-right {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 55%;
        justify-content: left;
        max-width: none;
        margin: 0;

        &.clip-slash {
          clip-path: polygon(10% 0%, 100% 0%, 100% 100%, 0% 100%);
        }

        &.clip-backslash {
          clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 10% 100%);
        }
      }
    }

    /* Large Desktop */
    @media only screen and (min-width: 1250px) {
      max-width: 1200px;
    }
  }
</style>
