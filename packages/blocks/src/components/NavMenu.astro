---
import {
  Button,
  Dropdown,
  Group,
  Menu,
  MenuItem,
  Visibility,
} from "@nautui/core";
import type { Base } from "../types";

interface NavMenuItem {
  children?: Array<{ label: string; href: string }>;
  href: string;
  label: string;
}

export interface NavMenuProps extends Base {
  activePath?: string;
  items: NavMenuItem[];
  limit?: number;
}

const {
  class: className,
  items = [],
  activePath = "",
  limit,
  ...rest
} = Astro.props as NavMenuProps;

const visibleItems = limit ? items.slice(0, limit) : items;
const overflowItems = limit && items.length > limit ? items.slice(limit) : [];

function isActive(item: NavMenuItem): boolean {
  if (!activePath) return false;
  if (item.href === activePath) return true;
  if (item.children?.some((child) => child.href === activePath)) return true;
  return false;
}

function hasChildren(item: NavMenuItem): boolean {
  return !!(item.children && item.children.length > 0);
}
---

<Visibility on="sm" hidden={true}>
  <Menu horizontal gap="sm" class:list={["naut-navmenu", className]} {...rest}>
    {visibleItems.map((item) =>
      hasChildren(item) ? (
        <MenuItem>
          <Dropdown align="start" hover side="bottom" zi={50}>
            <Button slot="trigger">
              <span class="naut-navmenu__label">{item.label}</span>
              <span aria-hidden="true" class="naut-navmenu__chevron" slot="after">▼</span>
            </Button>
            <ul class="naut-navmenu__dropdown">
              {item.children?.map((child) => (
                <MenuItem
                  active={Boolean(activePath && child.href === activePath)}
                  class="naut-navmenu__link"
                  href={child.href}
                >
                  {child.label}
                </MenuItem>
              ))}
            </ul>
          </Dropdown>
        </MenuItem>
      ) : (
        <MenuItem active={isActive(item)} href={item.href}>
          {item.label}
        </MenuItem>
      )
    )}
    {overflowItems.length > 0 && (
    <MenuItem>
      <Dropdown align="end" hover side="bottom" slot="sub" zi={50}>
        <div class="menu-item radius-sm" slot="trigger">
          <Group gap="xs">
          <span>More</span>
          <svg
            fill="none"
            height="20"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title>Chevron Down</title>
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </Group>
        </div>
        <Menu>
          {overflowItems.map((item) =>
            <MenuItem active={isActive(item)} href={item.href}>
              {item.label}
            </MenuItem>
          )}
        </Menu>
      </Dropdown>
    </MenuItem>
    )}
  </Menu>
</Visibility>
