---
import { Menu, Visibility } from "@nautui/core";
import type { Base } from "../types";

interface MenuItem {
  label: string;
  href: string;
  children?: Array<{ label: string; href: string }>;
}

export interface NavMenuProps extends Base {
  items: MenuItem[];
  activePath?: string;
  limit?: number;
}

const {
  class: className,
  items = [],
  activePath = "",
  limit,
  ...rest
} = Astro.props as NavMenuProps;

const visibleItems = limit ? items.slice(0, limit) : items;
const overflowItems = limit && items.length > limit ? items.slice(limit) : [];

function isActive(item: MenuItem): boolean {
  if (!activePath) return false;
  if (item.href === activePath) return true;
  if (item.children?.some((child) => child.href === activePath)) return true;
  return false;
}

function hasChildren(item: MenuItem): boolean {
  return !!(item.children && item.children.length > 0);
}
---

<Visibility on="sm" hidden={true}>
  <Menu horizontal gap="lg" class:list={["naut-navmenu", className]} {...rest}>
    {visibleItems.map((item) => (
      <li class:list={["naut-navmenu__item", { "naut-navmenu__item--has-children": hasChildren(item) }]}>
        {hasChildren(item) ? (
          <>
            <span class="naut-navmenu__label">{item.label}</span>
            <span class="naut-navmenu__chevron" aria-hidden="true">▼</span>
            <ul class="naut-navmenu__dropdown">
              {item.children!.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class:list={["naut-navmenu__link", { "naut-navmenu__link--active": activePath && child.href === activePath }]}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <a
            href={item.href}
            class:list={["naut-navmenu__link", { "naut-navmenu__link--active": isActive(item) }]}
          >
            {item.label}
          </a>
        )}
      </li>
    ))}
    {overflowItems.length > 0 && (
      <li class="naut-navmenu__item naut-navmenu__item--more">
        <span class="naut-navmenu__label">More</span>
        <span class="naut-navmenu__chevron" aria-hidden="true">▼</span>
        <ul class="naut-navmenu__dropdown">
          {overflowItems.map((item) => (
            <li class:list={[{ "naut-navmenu__item--has-children": hasChildren(item) }]}>
              {hasChildren(item) ? (
                <>
                  <span class="naut-navmenu__submenu-label">{item.label}</span>
                  <ul class="naut-navmenu__submenu naut-navmenu__submenu--nested">
                    {item.children!.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={["naut-navmenu__submenu-link", { "naut-navmenu__submenu-link--active": activePath && child.href === activePath }]}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={item.href}
                  class:list={["naut-navmenu__link", { "naut-navmenu__link--active": isActive(item) }]}
                >
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </li>
    )}
  </Menu>
</Visibility>

<style>
  .naut-navmenu {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .naut-navmenu__item {
    position: relative;
  }

  .naut-navmenu__item--has-children {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .naut-navmenu__label {
    cursor: default;
  }

  .naut-navmenu__link {
    text-decoration: none;
    color: inherit;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }

  .naut-navmenu__link:hover {
    background: color-mix(in oklch, var(--naut-color-primary) 10%, transparent);
  }

  .naut-navmenu__link--active {
    font-weight: 600;
    color: var(--naut-color-primary);
  }

  .naut-navmenu__chevron {
    font-size: 0.65rem;
    line-height: 1;
    opacity: 0.6;
  }

  .naut-navmenu__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 10rem;
    padding: 0.5rem 0;
    margin: 0.25rem 0 0;
    list-style: none;
    background: var(--naut-color-background);
    border: 1px solid color-mix(in oklch, var(--naut-color-foreground) 10%, transparent);
    border-radius: 0.5rem;
    box-shadow: var(--naut-shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.25rem);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 50;
  }

  .naut-navmenu__item:hover .naut-navmenu__dropdown,
  .naut-navmenu__item--more:hover .naut-navmenu__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .naut-navmenu__dropdown:hover .naut-navmenu__chevron {
    opacity: 1;
  }

  .naut-navmenu__submenu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .naut-navmenu__item--more .naut-navmenu__submenu {
    padding-left: 1rem;
  }

  .naut-navmenu__submenu--nested {
    margin-top: 0.25rem;
    padding-left: 0.75rem;
  }

  .naut-navmenu__submenu-link {
    display: block;
    padding: 0.35rem 1rem;
    text-decoration: none;
    color: inherit;
    font-size: 0.875rem;
  }

  .naut-navmenu__submenu-link:hover {
    background: color-mix(in oklch, var(--naut-color-primary) 10%, transparent);
  }

  .naut-navmenu__submenu-link--active {
    font-weight: 600;
    color: var(--naut-color-primary);
  }

  .naut-navmenu__submenu-label {
    padding: 0.35rem 1rem;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
</style>
