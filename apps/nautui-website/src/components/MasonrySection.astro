---
import { Box, Image, Masonry, MasonryItem, Section, Title } from "@nautui/core";
---

<Section border={{ top: "md" }}>
  <Title>Masonry</Title>
  <Box border="md">
    <Masonry columns={3} gap="md">
      <MasonryItem>
        <Image
          ratio="1:2"
          src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80"
          alt="Astronaut"
        />
      </MasonryItem>
      <MasonryItem>
        <Image
          ratio="1:1"
          src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80"
          alt="Astronaut"
        />
      </MasonryItem>
      <MasonryItem>
        <Image
          ratio="4:3"
          src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80"
          alt="Astronaut"
        />
      </MasonryItem>
      <MasonryItem>
        <Image
          ratio="1:2"
          src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80"
          alt="Astronaut"
        />
      </MasonryItem>
      <MasonryItem>
        <Image
          ratio="3:4"
          src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80"
          alt="Astronaut"
        />
      </MasonryItem>
      <MasonryItem>
        <Image
          fluid
          src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80"
          alt="Astronaut"
        />
      </MasonryItem>
    </Masonry>
  </Box>
</Section>
