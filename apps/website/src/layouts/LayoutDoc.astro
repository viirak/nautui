---
import { GitPullRequestArrow, Search } from "@lucide/astro";
import { DocLayout } from "@nautui/blocks";
import {
  Button,
  Container,
  Drawer,
  Flex,
  Group,
  Link,
  Menu,
  MenuItem,
  NavBar,
  Text,
  Theme,
  ThemeToggle,
} from "@nautui/core";
import type { MarkdownHeading } from "astro";
import NavDoc from "../components/NavDoc.astro";

interface LayoutProps {
  description: string;
  headings?: MarkdownHeading[];
  title: string;
}

const { title, description, headings } = Astro.props as LayoutProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width" name="viewport">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <link href="/favicon.ico" rel="icon">
    <meta content={Astro.generator} name="generator">
    <title>{title}</title>
    <meta content={description} name="description">
    <meta content={title} property="og:title">
    <meta content="website" property="og:type">
    <meta content="https://nautui.com/" property="og:url">
    <meta content="/og-image.png" property="og:image">
    <meta content={description} property="og:description">
    <meta content="summary_large_image" name="twitter:card">
    <meta content="@nautui" name="twitter:site">
    <meta content="@nautui" name="twitter:creator">
  </head>
  <body>
    <Theme>
      <NavBar bordered class="navbar" height={70} sticky variant="default">
        <Group gap="xs">
          <Drawer hidden="md" position="center">
            Drawer content here...
            <Menu> <MenuItem>Home</MenuItem> </Menu>
          </Drawer>
          <Text inline nowrap size="xl" weight="bold">Naut UI</Text>
          <Group gap="xs" hidden="mobile">
            <Link to="/docs">Docs</Link>
            <Link to="/docs/components">Comp</Link>
          </Group>
        </Group>
        <Group gap="0">
          <Button variant="ghost">
            <Search />
            Search
          </Button>
          <Button variant="ghost">
            <GitPullRequestArrow />
            Github</Button
          >
          <ThemeToggle size="sm" />
        </Group>
      </NavBar>
      <DocLayout headings={headings} title={title}>
        <NavDoc slot="nav" />
        <slot />
      </DocLayout>
      <footer class="page-footer">
        <Container>
          <Flex justify="between">
            <Text>NautUI</Text>
            <Text>Terms & Privacy</Text>
          </Flex>
        </Container>
      </footer>
    </Theme>
  </body>
</html>

<style>
  .page-footer {
    height: 20rem;
  }
</style>
