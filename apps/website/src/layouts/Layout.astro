---
import {
  Drawer,
  Group,
  Link,
  Menu,
  MenuItem,
  NavBar,
  Text,
  Theme,
  ThemeToggle,
} from "@nautui/core";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width" name="viewport">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <link href="/favicon.ico" rel="icon">
    <meta content={Astro.generator} name="generator">
    <title>NautUI</title>
  </head>
  <body>
    <Theme>
      <NavBar bordered fluid height={70} sticky variant="default">
        <Text inline size="xl" weight="bold">Naut UI</Text>
        <Group gap="xs" hidden="mobile">
          <Link href="/">Home</Link>
          <Link href="/docs">Docs</Link>
          <Link href="/docs/components">Components</Link>
        </Group>
        <Group gap="xs">
          <Drawer hidden="desktop">
            Drawer content here...
            <Menu> <MenuItem>Home</MenuItem> </Menu>
          </Drawer>
          <ThemeToggle />
        </Group>
      </NavBar>
      <slot />
    </Theme>
  </body>
</html>
