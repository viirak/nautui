---
import {
  Drawer,
  Group,
  Link,
  Menu,
  MenuItem,
  NavBar,
  Text,
  Theme,
  ThemeToggle,
} from "@nautui/core";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator}>
    <title>NautUI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    >
  </head>
  <body>
    <Theme>
      <NavBar variant="default" bordered sticky height={70} fluid>
        <Text inline size="xl" weight="bold">Naut UI</Text>
        <Group gap="xs" hidden="mobile">
          <Link href="/">Home</Link>
          <Link href="/docs">Docs</Link>
          <Link href="/docs/components">Components</Link>
        </Group>
        <Group gap="xs">
          <Drawer hidden="desktop">
            Drawer content here...
            <Menu> <MenuItem>Home</MenuItem> </Menu>
          </Drawer>
          <ThemeToggle />
        </Group>
      </NavBar>
      <slot />
    </Theme>
  </body>
</html>
