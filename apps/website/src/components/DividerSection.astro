---
import { Box, Divider, Section, Title } from "@nautui/core";
---

<Section border={{ top: "md" }}>
  <Title>Dividers</Title>
  <Box border="md">
    <Divider />
    <Divider variant="solid" />
    <Divider variant="dotted" />
    <Divider variant="dashed" />
    <Divider size="md" />
    <Divider size="lg" />
    <Divider spacing="lg" label="Divider" />
  </Box>
</Section>
