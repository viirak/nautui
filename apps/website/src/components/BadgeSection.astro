---
import { Badge, Box, Flex } from "@nautui/core";
---

<Box border="md">
  <Flex align="center" gap="sm" wrap="wrap">
    <Badge>Badge Default</Badge>
    <Badge dotted>Default Dotted</Badge>
    <Badge variant="text">Text</Badge>
    <Badge dotted variant="text">Dotted Text</Badge>
    <Badge color="primary" dotted variant="text">Dotted Text Primary</Badge>
    <Badge variant="surface">Badge Surface</Badge>
    <Badge outline>Badge Outline</Badge>
    <Badge variant="primary">Primary</Badge>
    <Badge variant="secondary">Secondary</Badge>
    <Badge variant="destructive">Destructive</Badge>
    <Badge
      gradient={{ colors: ["darkorchid", "orchid", "red"], textColor: "white" }}
      >Badge Gradient</Badge
    >
    <Badge outline radius="full">Badge Pill</Badge>
    <Badge outline size="sm">Small</Badge>
    <Badge outline size="md">Normal</Badge>
    <Badge outline size="lg">Large</Badge>
    <Badge color="success" outline outlineColor="strong">
      <svg
        fill="none"
        height="20"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="20"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Cloud Sun</title>
        <path d="M12 2v2" />
        <path d="m4.93 4.93 1.41 1.41" />
        <path d="M20 12h2" />
        <path d="m19.07 4.93-1.41 1.41" />
        <path d="M15.947 12.65a4 4 0 0 0-5.925-4.128" />
        <path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z" />
      </svg>
      Weather</Badge
    >
    <Badge dotted letterSpacing="sm">Default Dotted</Badge>
    <Badge dotted letterSpacing="md">Default Dotted</Badge>
    <Badge dotted letterSpacing="lg">Default Dotted</Badge>
  </Flex>
</Box>
