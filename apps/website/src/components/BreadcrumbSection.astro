---
import { Breadcrumb } from "@nautui/blocks";
import { Box, Section, Title } from "@nautui/core";
---

<Section border={{ top: "md" }}>
  <Title>Breadcrumbs</Title>
  <Box border="md">
    <Breadcrumb
      items={[
      { label: 'Home', href: '/' },
      { label: 'Dashboard', href: '/dashboard' },
      { label: 'Settings', href: '/settings' },
      { label: 'Just title without link' }
    ]}
    />
  </Box>
</Section>
