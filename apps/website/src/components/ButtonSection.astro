---
import { Box, Button, Group } from "@nautui/core";
---

<Box border="md">
  <Group gap="sm" wrap>
    <Button href="https://dara-ui.com" variant="link">Link</Button>
    <Button variant="ghost">Ghost</Button>
    <Button variant="flat">Flat</Button>
    <Button>Default</Button>
    <Button border="sm">Border Thin</Button>
    <Button border="lg">Border Thick</Button>
    <Button border="xl">Border Thicker</Button>
    <Button variant="primary">Primary</Button>
    <Button variant="secondary">Secondary</Button>
    <Button variant="destructive">Destructive</Button>
    <Button variant="outline">Outline</Button>
    <Button variant="outline-primary">Outline Primary</Button>
    <Button variant="outline-secondary">Outline Secondary</Button>
    <Button radius="full">Pill Button</Button>
    <Button>
      <svg
        class="lucide lucide-plus-icon lucide-plus"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Plus</title>
        <path d="M5 12h14" />
        <path d="M12 5v14" />
      </svg>
    </Button>
    <Button>
      <svg
        class="lucide lucide-plus-icon lucide-plus"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Plus</title>
        <path d="M5 12h14" />
        <path d="M12 5v14" />
      </svg>
      <span>Plus Left</span>
    </Button>
    <Button variant="outline">
      <span>Arrow Right</span>
      <svg
        class="lucide lucide-arrow-right-icon lucide-arrow-right"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Arrow Right</title>
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </Button>
    <Button pill variant="flat">
      <svg
        class="lucide lucide-x-icon lucide-x"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>X</title>
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </Button>
    <Button border="lg" variant="rainbow">Rainbow</Button>
    <Button border="xl" variant="rainbow">Rainbow Thicker</Button>
    <Button size="sm">
      <svg
        class="lucide lucide-plus-icon lucide-plus"
        fill="none"
        height="18"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        width="18"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Plus</title>
        <path d="M5 12h14" />
        <path d="M12 5v14" />
      </svg>
      <span>Button Small</span>
    </Button>
    <Button size="sm">
      <svg
        class="lucide lucide-plus-icon lucide-plus"
        fill="none"
        height="18"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        width="18"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Plus</title>
        <path d="M5 12h14" />
        <path d="M12 5v14" />
      </svg>
    </Button>
    <Button size="lg">Button Large</Button>
    <Button border="xl" size="lg" variant="rainbow">Rainbow Large</Button>
    <Button size="lg">
      <svg
        class="lucide lucide-plus-icon lucide-plus"
        fill="none"
        height="28"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        width="28"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>Plus</title>
        <path d="M5 12h14" />
        <path d="M12 5v14" />
      </svg>
    </Button>
    <Button radius="none">Radius None</Button>
    <Button radius="sm">Radius Small</Button>
    <Button radius="md">Radius Normal</Button>
    <Button radius="lg">Radius Large</Button>
    <Button radius="full">Radius Full</Button>
  </Group>
</Box>
