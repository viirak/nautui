---
import { Badge, Box, Button, Marquee, Section, Title } from "@nautui/core";
---

<Section border={{ top: "md" }}>
  <Title>Marquee</Title>
  <Box border="md">
    <Marquee duration={18_000}>
      <Badge outline>NautUI</Badge>
      <Badge variant="surface">Astro</Badge>
      <Badge color="primary" outline>TypeScript</Badge>
      <Badge color="secondary" outline>Design System</Badge>
      <Badge dotted>Components</Badge>
      <Badge mr="md" variant="surface">Developer Experience</Badge>
    </Marquee>
    <Marquee duration={22_000} fadeEdgeSize="10%" pauseOnHover reverse>
      <Button variant="ghost">Pause on hover</Button>
      <Button variant="outline">Reverse direction</Button>
      <Button variant="flat">Smooth scrolling</Button>
      <Button variant="primary">Reusable API</Button>
    </Marquee>
  </Box>
</Section>
