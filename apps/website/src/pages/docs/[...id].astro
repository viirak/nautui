---
import { getCollection, render } from "astro:content";
import { Article } from "@nautui/core";
import Layout from "../../layouts/LayoutDoc.astro";

export async function getStaticPaths() {
  const allDocs = await getCollection("article");
  return allDocs
    .filter((doc) => doc.id.startsWith("docs/"))
    .map((doc) => ({
      params: { id: doc.id.replace("docs/", "") },
    }));
}

const { id } = Astro.params;

const articles = await getCollection("article");
const entry = articles.find((a) => a.id === `docs/${id}`);

if (!entry) return Astro.redirect("/404", 404);

const { Content, headings } = await render(entry);
const { title, description } = entry.data;
---

<Layout description={description} headings={headings} title={title}>
  <Article> <Content /> </Article>
</Layout>
