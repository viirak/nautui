    "dev": "pnpm -r --parallel dev",
    "fix": "ultracite fix",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "ultracite": "8.0.0"
