{
  "name": "nautui",
  "version": "0.2.0",
  "private": true,
  "description": "A clean, minimalist UI component library for Astro — built for marketing websites, not apps.",
  "homepage": "https://github.com/viirak/nautui",
  "bugs": "https://github.com/viirak/nautui/issues",
  "repository": "https://github.com/viirak/nautui/core",
